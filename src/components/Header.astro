---
import { SITE } from '../config';
import { sections } from '../data/sections';

interface Props {
  // Outside the home page, anchors point back to the home page.
  home?: boolean;
}

const { home = false } = Astro.props;
const base = home ? '' : '/';
---

<header class="topbar">
  <div class="wrap topbar__in">
    <a href="/" class="brand">{SITE.nom}</a>
    <nav class="nav mono" aria-label="Sections">
      {sections.map((s) => <a href={`${base}#${s.id}`} data-section={s.id}><span>{s.num}</span> {s.titre}</a>)}
      <span class="nav__indic" aria-hidden="true"></span>
    </nav>
  </div>
  <div class="progress" aria-hidden="true"></div>
</header>

<script>
  // Active menu: highlight the link for the section occupying the middle of the screen.
  const links = new Map(
    [...document.querySelectorAll<HTMLAnchorElement>('.nav a[data-section]')].map((a) => [a.dataset.section, a]),
  );
  const targets = [...links.keys()].map((id) => document.getElementById(id!)).filter((el) => el !== null);
  if (targets.length && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          const link = links.get(e.target.id);
          if (!link) continue;
          if (e.isIntersecting) link.setAttribute('aria-current', 'true');
          else link.removeAttribute('aria-current');
        }
        // A single underline slides to the active link.
        const actif = document.querySelector<HTMLElement>('.nav a[aria-current]');
        const nav = document.querySelector<HTMLElement>('.nav');
        nav?.style.setProperty('--io', actif ? '1' : '0');
        if (actif) {
          nav?.style.setProperty('--il', `${actif.offsetLeft}px`);
          nav?.style.setProperty('--iw', `${actif.offsetWidth}px`);
        }
      },
      { rootMargin: '-45% 0px -50% 0px' },
    );
    targets.forEach((t) => io.observe(t));
  }

  // Once scrolled, the bar shrinks into a floating pill.
  const topbar = document.querySelector<HTMLElement>('.topbar');
  const pilule = () => topbar?.classList.toggle('is-pilule', scrollY > 80);
  pilule();
  addEventListener('scroll', pilule, { passive: true });
</script>

<style>
  .topbar {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
    /* Stay in place during page transitions. */
    view-transition-name: topbar;
    transition:
      background 0.4s,
      border-color 0.4s,
      backdrop-filter 0.4s;
  }
  .topbar.is-pilule {
    background: transparent;
    border-bottom-color: transparent;
    backdrop-filter: none;
  }
  .topbar__in {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 56px;
    border: 1px solid transparent;
    border-radius: 0;
    transition:
      max-width 0.6s cubic-bezier(0.2, 0.7, 0.1, 1),
      height 0.6s cubic-bezier(0.2, 0.7, 0.1, 1),
      translate 0.6s cubic-bezier(0.2, 0.7, 0.1, 1),
      border-radius 0.6s cubic-bezier(0.2, 0.7, 0.1, 1),
      background 0.4s,
      border-color 0.4s,
      box-shadow 0.4s;
  }
  .is-pilule .topbar__in {
    max-width: 52rem;
    height: 46px;
    translate: 0 8px;
    border-radius: 999px;
    border-color: var(--hair);
    background: color-mix(in srgb, var(--paper) 72%, transparent);
    backdrop-filter: blur(14px);
    box-shadow: 0 0.75rem 2rem rgba(0, 0, 0, 0.25);
  }
  .brand {
    font-family: var(--f-display);
    font-weight: 900;
    font-size: 1.6rem;
    text-transform: uppercase;
    letter-spacing: 0.01em;
    text-decoration: none;
  }
  .nav {
    position: relative;
    display: flex;
    gap: 1.5rem;
  }
  .nav__indic {
    position: absolute;
    bottom: -4px;
    left: var(--il, 0);
    width: var(--iw, 0);
    height: 2px;
    background: var(--accent);
    opacity: var(--io, 0);
    transition:
      left 0.5s cubic-bezier(0.2, 0.7, 0.1, 1),
      width 0.5s cubic-bezier(0.2, 0.7, 0.1, 1),
      opacity 0.3s;
  }
  .nav a {
    text-decoration: none;
    position: relative;
    transition: color 0.25s;
  }
  .nav a span {
    color: var(--accent);
  }
  .nav a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -4px;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: var(--o, left);
    transition: transform 0.25s ease;
  }
  .nav a:hover:not([aria-current])::after {
    transform: scaleX(1);
  }
  .nav a[aria-current] {
    color: var(--accent);
  }
  @media (max-width: 760px) {
    .nav {
      display: none;
    }
  }

  /* Graduated ruler that fills as the page scrolls (supported browsers only). */
  .progress {
    display: none;
  }
  @supports (animation-timeline: scroll()) {
    .progress {
      display: block;
      position: absolute;
      left: 0;
      right: 0;
      bottom: -1px;
      height: 7px;
      pointer-events: none;
      background:
        linear-gradient(var(--accent), var(--accent)) bottom / 100% 2px no-repeat,
        repeating-linear-gradient(90deg, var(--accent) 0 1px, transparent 1px 80px) bottom / 100% 7px no-repeat,
        repeating-linear-gradient(90deg, var(--accent) 0 1px, transparent 1px 8px) bottom / 100% 4px no-repeat;
      transition: opacity 0.4s;
      animation: fill linear both;
      animation-timeline: scroll(root);
      /* The global reduced-motion rule overrides durations: hand control back to the timeline. */
      animation-duration: auto !important;
    }
    .is-pilule .progress {
      bottom: auto;
      top: 0;
    }
    @keyframes fill {
      from { clip-path: inset(0 100% 0 0); }
      to { clip-path: inset(0 0 0 0); }
    }
  }
</style>
