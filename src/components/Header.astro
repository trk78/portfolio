---
import { SITE } from '../config';
import { sections } from '../data/sections';

interface Props {
  // Outside the home page, anchors point back to the home page.
  home?: boolean;
}

const { home = false } = Astro.props;
const base = home ? '' : '/';
---

<header class="topbar">
  <div class="wrap topbar__in">
    <a href="/" class="brand">{SITE.nom}</a>
    <nav class="nav mono" aria-label="Sections">
      {sections.map((s) => <a href={`${base}#${s.id}`} data-section={s.id}><span>{s.num}</span> {s.titre}</a>)}
    </nav>
  </div>
  <div class="progress" aria-hidden="true"></div>
</header>

<script>
  // Active menu: highlight the link for the section occupying the middle of the screen.
  const links = new Map(
    [...document.querySelectorAll<HTMLAnchorElement>('.nav a[data-section]')].map((a) => [a.dataset.section, a]),
  );
  const targets = [...links.keys()].map((id) => document.getElementById(id!)).filter((el) => el !== null);
  if (targets.length && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          const link = links.get(e.target.id);
          if (!link) continue;
          if (e.isIntersecting) link.setAttribute('aria-current', 'true');
          else link.removeAttribute('aria-current');
        }
      },
      { rootMargin: '-45% 0px -50% 0px' },
    );
    targets.forEach((t) => io.observe(t));
  }
</script>

<style>
  .topbar {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
    /* Stay in place during page transitions. */
    view-transition-name: topbar;
  }
  .topbar__in {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 56px;
  }
  .brand {
    font-family: var(--f-display);
    font-weight: 900;
    font-size: 1.6rem;
    text-transform: uppercase;
    letter-spacing: 0.01em;
    text-decoration: none;
  }
  .nav {
    display: flex;
    gap: 1.5rem;
  }
  .nav a {
    text-decoration: none;
    position: relative;
    transition: color 0.25s;
  }
  .nav a span {
    color: var(--accent);
  }
  .nav a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -4px;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s ease;
  }
  .nav a:hover::after,
  .nav a[aria-current]::after {
    transform: scaleX(1);
  }
  .nav a[aria-current] {
    color: var(--accent);
  }
  @media (max-width: 760px) {
    .nav {
      display: none;
    }
  }

  /* Graduated ruler that fills as the page scrolls (supported browsers only). */
  .progress {
    display: none;
  }
  @supports (animation-timeline: scroll()) {
    .progress {
      display: block;
      position: absolute;
      left: 0;
      right: 0;
      bottom: -1px;
      height: 7px;
      pointer-events: none;
      background:
        linear-gradient(var(--accent), var(--accent)) bottom / 100% 2px no-repeat,
        repeating-linear-gradient(90deg, var(--accent) 0 1px, transparent 1px 80px) bottom / 100% 7px no-repeat,
        repeating-linear-gradient(90deg, var(--accent) 0 1px, transparent 1px 8px) bottom / 100% 4px no-repeat;
      animation: fill linear both;
      animation-timeline: scroll(root);
      /* The global reduced-motion rule overrides durations: hand control back to the timeline. */
      animation-duration: auto !important;
    }
    @keyframes fill {
      from { clip-path: inset(0 100% 0 0); }
      to { clip-path: inset(0 0 0 0); }
    }
  }
</style>
