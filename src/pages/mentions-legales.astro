---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import { SITE, LEGAL } from '../config';
---

<Base title="Mentions légales" noindex>
  <Header />
  <main class="wrap legal">
    <div class="halos" aria-hidden="true"><i></i><i></i><i></i></div>
    <a href="/" class="mono back trait">← Retour</a>
    <h1>Mentions légales</h1>

    <h2>Éditeur</h2>
    <p>
      {LEGAL.editeur} — {LEGAL.statut}<br />
      Nom commercial : {LEGAL.nomCommercial}<br />
      SIRET : {LEGAL.siret}<br />
      Code APE : {LEGAL.ape}<br />
      {LEGAL.adresse}<br />
      Contact : <a class="trait" href={`mailto:${SITE.email}`}>{SITE.email}</a><br />
      {LEGAL.tva}
    </p>
    <p>Directeur de la publication : {LEGAL.editeur}.</p>

    <h2>Hébergement</h2>
    <p>{LEGAL.hebergeur}</p>

    <h2>Données personnelles</h2>
    <p>
      Ce site ne dépose aucun cookie et n'utilise aucun outil de mesure d'audience. Les messages envoyés par e-mail
      servent uniquement à répondre à votre demande et ne sont jamais transmis à des tiers. Vous pouvez demander leur
      suppression à tout moment à l'adresse ci-dessus.
    </p>
  </main>
</Base>

<style>
  .legal {
    position: relative;
    isolation: isolate;
    max-width: 760px;
    padding-top: 3rem;
    padding-bottom: 5rem;
  }
  .back {
    text-decoration: none;
    color: var(--accent);
  }
  h1 {
    margin: 1.5rem 0 2rem;
    font-family: var(--f-display);
    font-weight: 900;
    text-transform: uppercase;
    font-size: clamp(2.8rem, 9vw, 5rem);
    line-height: 0.9;
    /* Outline that fills from left to right on load, like the home page section titles. */
    width: fit-content;
    color: transparent;
    -webkit-text-stroke: 1.5px var(--ink);
    background: linear-gradient(90deg, var(--ink) 50%, transparent 50%) 100% 0 / 200% 100% no-repeat;
    -webkit-background-clip: text;
    background-clip: text;
    animation: remplir-titre 1.2s 0.3s cubic-bezier(0.6, 0, 0.2, 1) forwards;
  }
  @keyframes remplir-titre {
    to { background-position: 0 0; }
  }
  h2 {
    margin: 2.5rem 0 0.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
    font-family: var(--f-body);
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  p {
    margin: 0 0 1rem;
  }
</style>
