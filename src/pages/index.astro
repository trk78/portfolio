  /* Purple line on top: each step takes a quarter of progress (--p from 0 to 1, set by the script). */
  .step::before {
    content: '';
    position: absolute;
    top: -3px;
    left: 0;
    right: 0;
    height: 3px;
    background: var(--accent);
    transform-origin: left;
    scale: clamp(0, calc(var(--p, 0.25) * 4 - var(--i, 0)), 1) 1;
