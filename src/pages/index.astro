---
import Base from '../layouts/Base.astro';
import ArrowOut from '../components/ArrowOut.astro';
import Header from '../components/Header.astro';
import { SITE } from '../config';
import { services, etapes, projets, chiffres } from '../data/contenu';
import { num } from '../data/sections';
import sharp from 'sharp';

// Cycling heading words (the first is displayed without JS).
const mots = ['apps', 'bots', 'outils', 'jeux'];
const nombre = (n: number) => n.toLocaleString('fr-FR');
const lettres = (t: string) => [...t];

const annee = new Date().getFullYear();

// 24 px wide version of each screenshot, inlined: shown blurred until the real image arrives.
const flous = await Promise.all(
  projets.map(async (p) =>
    p.apercu
      ? `data:image/webp;base64,${(await sharp(`public${p.apercu.split('?')[0]}`).resize(24).webp({ quality: 40 }).toBuffer()).toString('base64')}`
      : '',
  ),
);

// Service icons in `services` order; pathLength=1 animates strokes on hover regardless of length.
const pictos = [
  // Business website: browser window
  '<rect x="3" y="5" width="42" height="34" rx="3" pathLength="1"/><path d="M3 13h42" pathLength="1"/><path d="M10 22h18M10 28h28M10 33h14" pathLength="1"/>',
  // Web application: window with sidebar, two metric cards and a chart
  '<rect x="3" y="5" width="42" height="34" rx="3" pathLength="1"/><path d="M3 12h42M14 12v27M7 8.5h1M10.5 8.5h1M6.5 17h4M6.5 21h4M6.5 25h4" pathLength="1"/><path d="M18 16h10v6H18zM31 16h10v6H31zM18 34l5-5 4 3 6-6 8 4" pathLength="1"/>',
  // Mobile application: phone
  '<rect x="13" y="2" width="22" height="42" rx="4" pathLength="1"/><path d="M21 7h6M22 38h4" pathLength="1"/><path d="M18 16h12M18 21h8M18 26h12" pathLength="1"/>',
  // Automation & AI: robot
  '<rect x="8" y="14" width="32" height="24" rx="5" pathLength="1"/><path d="M24 14V7M20 5h8M3 24v6M45 24v6" pathLength="1"/><path d="M17 23v4M31 23v4M18 32h12" pathLength="1"/>',
];
// Method: background code typed while hovering over Development.
const code = [
  'const projet = await concevoir(besoin);',
  'for (const sprint of planning) {',
  '  livrer(sprint); // vous suivez chaque étape',
  '}',
  'await tester(projet, { mobile: true });',
  'deployer(projet);',
];
// Other step scenes: sample conversation, quote and deployment. Illustrative, no real figures.
const chat = [
  { qui: 'client', texte: "J'ai besoin d'un site pour mon restaurant." },
  { qui: 'moi', texte: "Qu'est-ce qui compte le plus pour vous ?" },
  { qui: 'client', texte: 'Prendre des réservations, et être trouvé sur Google.' },
  { qui: 'moi', texte: 'Noté : réservation en ligne + référencement local.' },
];
const devis = [
  ['Périmètre', '5 pages + réservation'],
  ['Délai', '3 semaines'],
  ['Prix', 'fixe, sans surprise'],
];
const deploiement = ['build', 'tests', 'nom de domaine', 'HTTPS'];
---

<Base>
  <Header home />
  <div class="curseur" aria-hidden="true"></div>

  <main>
    <section class="hero wrap" aria-labelledby="hero-titre">
      <div class="halos" aria-hidden="true"><i></i><i></i><i></i></div>
      <canvas class="hero__fond" aria-hidden="true"></canvas>
      <h1 id="hero-titre" class="hero__title" aria-label={`Je construis vos sites et vos ${mots.join(', ')}.`}>
        <span class="line" style="--d: 0" aria-hidden="true">{lettres('Je construis').map((c) => (c === ' ' ? ' ' : <span class="l">{c}</span>))}</span>
        <span class="line" style="--d: 1" aria-hidden="true">{lettres('vos sites').map((c) => (c === ' ' ? ' ' : <span class="l">{c}</span>))}</span>
        <span class="line" style="--d: 2" aria-hidden="true"
          ><em>&amp; vos <span class="swap" data-mots={mots.join(',')}>{mots[0]}</span>.</em></span
        >
      </h1>

    </section>

    <section id="services" class="block wrap" aria-labelledby="t-services">
      <div class="block__head title-reveal">
        <span class="mono block__num">{num('services')}</span>
        <h2 id="t-services"><span>Services</span></h2>
      </div>
      <ol class="grid-services">
        {
          services.map((s, i) => (
            <li class="card reveal" style={`--i: ${i}`}>
              <span class="mono card__ref">{String.fromCharCode(65 + i)}</span>
              <svg class="card__picto" viewBox="0 0 48 46" aria-hidden="true" set:html={pictos[i]} />
              <h3>{s.titre}</h3>
              <p>{s.texte}</p>
              <ul class="mono card__pts">
                {s.points.map((p, k) => <li style={`--k: ${k}`}>{p}</li>)}
              </ul>
              {s.demo && (
                <button type="button" class="mono card__demo" data-demo={s.demo.url} data-domaine={s.demo.domaine}>
                  Voir un exemple →
                </button>
              )}
            </li>
          ))
        }
      </ol>
    </section>

    <section id="methode" class="block wrap" aria-labelledby="t-methode">
      <div class="block__head title-reveal">
        <span class="mono block__num">{num('methode')}</span>
        <h2 id="t-methode"><span>Méthode</span></h2>
      </div>
      <div class="methode__fond" aria-hidden="true">
        <div class="fond fond-0">
          <div class="chat">{chat.map((m, j) => <span class={m.qui} style={`--j: ${j}`}>{m.texte}</span>)}</div>
        </div>
        <div class="fond fond-1">
          <div class="devis">
            <b>Devis</b>
            {devis.map(([k, v], j) => <span style={`--j: ${j + 1}`}><em>{k}</em>{v}</span>)}
            <strong style={`--j: ${devis.length + 1}`}>Signé</strong>
          </div>
        </div>
        <div class="fond fond-2">{code.map((l, j) => <span style={`--j: ${j}; --n: ${l.length}`}>{l}</span>)}</div>
        <div class="fond fond-3">
          <div class="deploi">
            {deploiement.map((l, j) => <span style={`--j: ${j}`}>✓ {l}</span>)}
            <strong style={`--j: ${deploiement.length}`}>En ligne</strong>
          </div>
          <i class="deploi__barre" />
        </div>
      </div>
      <ol class="steps">
        {
          etapes.map((e, i) => (
            <li class="step reveal" style={`--i: ${i}`}>
              <span class="step__tete"><span class="step__bulle" aria-hidden="true" /><span class="step__n">{i + 1}</span></span>
              <h3>{e.titre}</h3>
              <p>{e.texte}</p>
            </li>
          ))
        }
      </ol>
    </section>

    {
      projets.length > 0 && (
        <section id="projets" aria-labelledby="t-projets">
          <div class="block wrap">
            <div class="block__head title-reveal">
              <span class="mono block__num">{num('projets')}</span>
              <h2 id="t-projets"><span>Projets</span></h2>
            </div>
            <ul class="chiffres">
              {chiffres.map((c, i) => (
                <li class="chiffre reveal" style={`--i: ${i}`} hidden={!!c.source} data-source={c.source} data-champ={c.champ}>
                  <strong class="compteur" data-valeur={c.valeur}>{nombre(c.valeur)}</strong>
                  <span class="mono">{c.label}</span>
                </li>
              ))}
            </ul>
          </div>
          <div class="galerie">
            <div class="galerie__colle">
              <ul class="galerie__piste">
                {projets.map((p, i) => (
                  <li class="diapo" style={flous[i] && `--flou: url(${flous[i]})`}>
                    {p.apercu ? (
                      <img class="diapo__img" src={p.apercu} alt="" width="1920" height="1200" loading="lazy" decoding="async" />
                    ) : (
                      <span class="diapo__img" />
                    )}
                    {p.video && <video class="diapo__img diapo__video" src={p.video} muted loop playsinline preload="none" aria-hidden="true" />}
                    <span class="mono diapo__meta">
                      <span>{String(i + 1).padStart(2, '0')} / {String(projets.length).padStart(2, '0')}</span>
                      <span>{p.annee} · {p.type}</span>
                    </span>
                    <div class="diapo__txt">
                      <h3>
                        {p.logo && <img class="diapo__logo" src={p.logo} alt="" width="64" height="64" loading="lazy" decoding="async" />}
                        {p.url || p.repo ? (
                          <a href={p.url ?? p.repo} target="_blank" rel="noopener">
                            {p.nom}<ArrowOut />
                          </a>
                        ) : (
                          p.nom
                        )}
                      </h3>
                      <p>{p.resume}</p>
                      <p class="mono diapo__stack">{p.stack.join(' · ')}</p>
                      <p class="mono diapo__liens">
                        {p.url && <a class="trait" href={p.url} target="_blank" rel="noopener">Voir le site<ArrowOut /></a>}
                        {p.repo && <a class="trait" href={p.repo} target="_blank" rel="noopener">Code sur GitHub<ArrowOut /></a>}
                      </p>
                    </div>
                  </li>
                ))}
              </ul>
              <div class="galerie__barre" aria-hidden="true"><i></i></div>
            </div>
          </div>
        </section>
      )
    }
  </main>

  <footer class="rideau">
    <div class="halos" aria-hidden="true"><i></i><i></i><i></i></div>
    <div class="rideau__in wrap">
      <section id="contact" class="contact" aria-labelledby="t-contact">
        <div class="block__head title-reveal">
          <span class="mono block__num">{num('contact')}</span>
          <h2 id="t-contact"><span>Contact</span></h2>
        </div>
        <a class="contact__mail" aria-label={`Écrire à ${SITE.email}`} href={`mailto:${SITE.email}?subject=${encodeURIComponent('Projet — premier contact')}`}>
          <span class="contact__label mono">Écrire à</span>
          <span class="contact__addr reveal-lettres">{lettres(SITE.email).map((c, k) => <span class="l" style={`--k: ${k}`} aria-hidden="true">{c}</span>)}</span>
          <span class="contact__arrow" aria-hidden="true">→</span>
        </a>
      </section>
      <div class="footer mono">
        <span>© {annee} {SITE.nom} — {SITE.statut}</span>
        <a class="trait" href="/mentions-legales">Mentions légales</a>
      </div>
      <div class="rideau__nom" aria-hidden="true">{SITE.nom}</div>
    </div>
  </footer>

  <div class="demo" hidden>
    <div class="demo__fenetre" role="dialog" aria-modal="true" aria-label="Exemple de site">
      <div class="demo__barre">
        <span class="demo__points" aria-hidden="true"><i></i><i></i><i></i></span>
        <span class="demo__url"></span>
        <a class="demo__plein mono trait" target="_blank" rel="noopener">Plein écran ↗</a>
        <button type="button" class="demo__fermer" aria-label="Fermer l’exemple">×</button>
      </div>
      <iframe title="Exemple de site"></iframe>
    </div>
  </div>
</Base>

<script>
  import Lenis from 'lenis';
  import 'lenis/dist/lenis.css';

  const animer = !matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Smooth scrolling with inertia (wheel only; touch keeps native scrolling). Anchors stop below the top bar.
  const lenis = animer ? new Lenis({ autoRaf: true, anchors: { offset: -64 } }) : null;

  // Service demos: the example site opens in a browser-like window, unfolding from the click point.
  const demo = document.querySelector<HTMLElement>('.demo')!;
  const cadre = demo.querySelector('iframe')!;
  const plein = demo.querySelector<HTMLAnchorElement>('.demo__plein')!;
  const fermerDemo = demo.querySelector<HTMLButtonElement>('.demo__fermer')!;
  let declencheur: HTMLElement | null = null;
  const fenetre = demo.querySelector<HTMLElement>('.demo__fenetre')!;
  // The window starts exactly over the card (transform only, smooth on the GPU), then grows to its place.
  const surCarte = () => {
    const c = declencheur!.closest('.card')!.getBoundingClientRect();
    fenetre.style.transform = 'none';
    const f = fenetre.getBoundingClientRect();
    fenetre.style.transform = `translate(${c.left - f.left}px, ${c.top - f.top}px) scale(${c.width / f.width}, ${c.height / f.height})`;
  };
  const charger = (b: HTMLElement) => {
    if (cadre.dataset.src === b.dataset.demo) return;
    cadre.dataset.src = b.dataset.demo!;
    cadre.classList.remove('is-pret');
    cadre.src = b.dataset.demo!;
  };
  cadre.addEventListener('load', () => cadre.classList.add('is-pret'));
  const fermer = () => {
    if (!demo.classList.contains('is-ouvert')) return;
    demo.classList.remove('is-ouvert');
    if (animer) surCarte();
    lenis?.start();
    setTimeout(() => !demo.classList.contains('is-ouvert') && (demo.hidden = true), animer ? 600 : 0);
    declencheur?.focus();
  };
  document.querySelectorAll<HTMLButtonElement>('.card__demo').forEach((b) => {
    // Start loading the example as soon as the card is hovered: it is often ready by the click.
    b.closest('.card')!.addEventListener('pointerenter', () => charger(b), { once: true });
    b.addEventListener('click', () => {
      declencheur = b;
      charger(b);
      plein.href = b.dataset.demo!;
      demo.querySelector('.demo__url')!.textContent = b.dataset.domaine!;
      demo.hidden = false;
      lenis?.stop();
      if (animer) {
        surCarte();
        fenetre.getBoundingClientRect();
      }
      demo.classList.add('is-ouvert');
      fenetre.style.transform = '';
      fermerDemo.focus({ preventScroll: true });
    });
  });
  fermerDemo.addEventListener('click', fermer);
  demo.addEventListener('click', (e) => e.target === demo && fermer());
  addEventListener('keydown', (e) => e.key === 'Escape' && !demo.hidden && fermer());

  // Reveal on scroll; everything stays visible without JS or with reduced motion.
  const items = document.querySelectorAll<HTMLElement>('.reveal, .title-reveal, .block, .reveal-lettres');
  if ('IntersectionObserver' in window && animer) {
    document.documentElement.classList.add('js-reveal');
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            e.target.classList.add('is-in');
            io.unobserve(e.target);
          }
        }
      },
      { rootMargin: '0px 0px -10% 0px' },
    );
    items.forEach((el) => io.observe(el));
  }

  // Cycling final heading word: exits above, next word rises from below.
  const swap = document.querySelector<HTMLElement>('.swap');
  const mots = swap?.dataset.mots?.split(',') ?? [];
  if (swap && mots.length > 1 && animer && 'animate' in swap) {
    let i = 0;
    const easing = 'cubic-bezier(0.2, 0.7, 0.1, 1)';
    const suivant = async () => {
      if (document.hidden) return;
      await swap.animate(
        [{ transform: 'none', opacity: 1 }, { transform: 'translateY(-60%)', opacity: 0 }],
        { duration: 380, easing: 'cubic-bezier(0.6, 0, 0.8, 0.4)', fill: 'forwards' },
      ).finished;
      i = (i + 1) % mots.length;
      swap.textContent = mots[i];
      swap.animate(
        [{ transform: 'translateY(60%)', opacity: 0 }, { transform: 'none', opacity: 1 }],
        { duration: 620, easing, fill: 'forwards' },
      );
    };
    // Wait for the heading entrance to finish before starting.
    setTimeout(() => setInterval(suivant, 2600), 1400);
  }

  // Mouse effects: only with an actual mouse (not mobile) and without reduced motion.
  const souris = animer && matchMedia('(hover: hover) and (pointer: fine)').matches;

  // Heading depth: track the cursor throughout the window.
  const hero = document.querySelector<HTMLElement>('.hero__title');
  if (souris) {
    document.documentElement.classList.add('a-souris');
    addEventListener('pointermove', (e) => {
      // Position from -1 to 1 relative to the screen center.
      hero?.style.setProperty('--mx', (e.clientX / innerWidth - 0.5) * 2 + '');
      hero?.style.setProperty('--my', (e.clientY / innerHeight - 0.5) * 2 + '');
    });
  }

  // Service cards: highlight under the cursor; fill starts at the entry point.
  if (souris) {
    document.querySelectorAll<HTMLElement>('.card').forEach((card) => {
      const pos = (e: PointerEvent) => {
        const r = card.getBoundingClientRect();
        card.style.setProperty('--px', `${((e.clientX - r.left) / r.width) * 100}%`);
        card.style.setProperty('--py', `${((e.clientY - r.top) / r.height) * 100}%`);
      };
      card.addEventListener('pointerenter', pos);
      card.addEventListener('pointermove', pos);
    });
  }

  // Services: purple light following the cursor along the grid lines (the 1 px gaps).
  const grille = document.querySelector<HTMLElement>('.grid-services');
  if (grille && souris) {
    grille.addEventListener('pointermove', (e) => {
      const r = grille.getBoundingClientRect();
      grille.style.setProperty('--gx', `${e.clientX - r.left}px`);
      grille.style.setProperty('--gy', `${e.clientY - r.top}px`);
    });
    grille.addEventListener('pointerleave', () => grille.style.removeProperty('--gx'));
  }

  // Videos fade in over the screenshot once they actually play.
  document.querySelectorAll<HTMLVideoElement>('.diapo__video').forEach((v) => v.addEventListener('playing', () => v.classList.add('is-on'), { once: true }));

  // Screenshots: fade in over their blurred placeholder once loaded.
  document.querySelectorAll<HTMLImageElement>('img.diapo__img').forEach((img) => {
    const pret = () => img.classList.add('is-charge');
    img.classList.add('a-charger');
    if (img.complete) pret();
    else img.addEventListener('load', pret);
  });

  // Method: the line above the steps fills purple on scroll.
  const steps = document.querySelector<HTMLElement>('.steps');
  if (steps && animer) {
    const maj = () => {
      const r = steps.getBoundingClientRect();
      // 0 when the list enters from the screen bottom, 1 when it reaches the upper third.
      const p = (innerHeight - r.top) / (innerHeight * 0.67);
      steps.style.setProperty('--p', String(Math.min(Math.max(p, 0), 1)));
    };
    maj();
    addEventListener('scroll', maj, { passive: true });
    addEventListener('resize', maj);
  }

  // Method: the hovered step expands and starts its scene behind the entire section.
  const methode = document.querySelector<HTMLElement>('#methode');
  if (steps && methode && souris) {
    steps.querySelectorAll<HTMLElement>('.step').forEach((li, i) => {
      li.addEventListener('pointerenter', () => (methode.dataset.actif = String(i)));
    });
    steps.addEventListener('pointerleave', () => delete methode.dataset.actif);
  }

  // Contact: the arrow follows the cursor while hovering over the email block.
  const mail = document.querySelector<HTMLElement>('.contact__mail');
  if (mail && souris) {
    mail.addEventListener('pointermove', (e) => {
      const r = mail.getBoundingClientRect();
      mail.style.setProperty('--ax', `${(e.clientX - (r.right - r.height / 2)) * 0.12}px`);
      mail.style.setProperty('--ay', `${(e.clientY - (r.top + r.height / 2)) * 0.25}px`);
    });
    mail.addEventListener('pointerleave', () => {
      mail.style.setProperty('--ax', '0px');
      mail.style.setProperty('--ay', '0px');
    });
  }

  // Live counters: fetch the value, then show the counter (hidden if the source does not respond).
  document.querySelectorAll<HTMLElement>('.chiffre[data-source]').forEach(async (li) => {
    try {
      const json = await (await fetch(li.dataset.source!)).json();
      const n = Number(json[li.dataset.champ!]);
      if (!Number.isFinite(n) || n <= 0) return;
      const el = li.querySelector<HTMLElement>('.compteur')!;
      el.dataset.valeur = String(n);
      el.textContent = n.toLocaleString('fr-FR');
      li.hidden = false;
    } catch {
      // Source unavailable: keep the counter hidden.
    }
  });

  // Scroll effects: hero fades under the next sections, projects gallery, contact curtain.
  let defil = 0; // hero progress, 0 at the top, 1 once fully covered
  const heroSec = document.querySelector<HTMLElement>('.hero');
  const galerie = document.querySelector<HTMLElement>('.galerie');
  const piste = galerie?.querySelector<HTMLElement>('.galerie__piste');
  const diapos = piste ? [...piste.children] as HTMLElement[] : [];
  const rideau = document.querySelector<HTMLElement>('.rideau');
  const grand = matchMedia('(min-width: 761px)');
  const titres = [...document.querySelectorAll<HTMLElement>('.block__head h2')];
  let dist = 0;
  const VITESSE = 0.5; // scroll needed per pixel of sideways movement in the gallery
  const surDefil = () => {
    if (heroSec && animer) {
      defil = Math.min(Math.max(scrollY / heroSec.offsetHeight, 0), 1);
      heroSec.style.setProperty('--h', defil.toFixed(3));
      // The sections' side backgrounds (box-shadow) do not catch the mouse: without this, the covered heading still would.
      heroSec.style.pointerEvents = defil > 0.3 ? 'none' : '';
    }
    if (galerie && piste) {
      let p: number;
      if (galerie.classList.contains('is-epingle')) {
        p = dist ? Math.min(Math.max(-galerie.getBoundingClientRect().top / (dist * VITESSE), 0), 1) : 0;
        piste.style.translate = `${-p * dist}px 0`;
      } else {
        p = piste.scrollLeft / Math.max(1, piste.scrollWidth - piste.clientWidth);
      }
      galerie.style.setProperty('--gp', p.toFixed(4));
      // Depth: the centered card is full size, the others shrink, darken and turn towards the center.
      // Parallax: each screenshot shifts against the movement, by its distance from the screen center.
      if (animer) {
        for (const d of diapos) {
          const b = d.getBoundingClientRect();
          const c = Math.min(Math.max(((b.left + b.width / 2) / innerWidth - 0.5) * 2, -1), 1);
          d.style.setProperty('--s', c.toFixed(3));
          d.style.setProperty('--c', Math.abs(c).toFixed(3));
          d.style.setProperty('--dx', `${c * -2}%`);
          d.style.setProperty('--v', Math.min(Math.max((c - 0.35) / 0.6, 0), 1).toFixed(3));
          // Only the centered, on-screen card plays its video (loaded on first play).
          const video = d.querySelector('video');
          if (video) {
            const actif = Math.abs(c) < 0.4 && b.bottom > 0 && b.top < innerHeight;
            if (actif && video.paused) video.play().catch(() => {});
            else if (!actif && !video.paused) video.pause();
          }
        }
      }
    }
    // Section titles: outline filled from left to right while they come up the screen.
    if (animer) {
      for (const t of titres) {
        const v = (innerHeight - t.getBoundingClientRect().top) / (innerHeight * 0.55);
        t.style.setProperty('--t', Math.min(Math.max(v, 0), 1).toFixed(3));
      }
    }
    if (rideau && animer) {
      const t = (innerHeight - rideau.getBoundingClientRect().top) / rideau.offsetHeight;
      rideau.style.setProperty('--r', Math.min(Math.max(t, 0), 1).toFixed(3));
    }
  };
  // Large screens: vertical scroll drives the gallery sideways; otherwise native swipe with snapping.
  const mesurer = () => {
    if (galerie && piste) {
      const epingle = animer && grand.matches;
      galerie.classList.toggle('is-epingle', epingle);
      dist = epingle ? Math.max(0, piste.scrollWidth - document.documentElement.clientWidth) : 0;
      galerie.style.height = epingle ? `${innerHeight + dist * VITESSE}px` : '';
      if (!epingle) piste.style.translate = '';
    }
    surDefil();
  };
  mesurer();
  addEventListener('scroll', surDefil, { passive: true });
  addEventListener('resize', mesurer);
  piste?.addEventListener('scroll', surDefil, { passive: true });

  // Counters: each digit rolls like an odometer on entering the viewport (final value already in HTML).
  // A wheel holds 0-9 twice, so every digit makes at least one full turn before stopping.
  const compteurs = document.querySelectorAll<HTMLElement>('.compteur');
  if (animer && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        io.unobserve(e.target);
        const el = e.target as HTMLElement;
        const texte = Number(el.dataset.valeur).toLocaleString('fr-FR');
        el.setAttribute('aria-label', texte);
        el.textContent = '';
        const roues: [HTMLElement, number][] = [];
        [...texte].forEach((c, k) => {
          const span = document.createElement('span');
          span.setAttribute('aria-hidden', 'true');
          if (/\d/.test(c)) {
            span.className = 'roue';
            const col = document.createElement('span');
            col.style.transitionDelay = `${k * 90}ms`;
            col.append(...'01234567890123456789'.split('').map((d) => Object.assign(document.createElement('span'), { textContent: d })));
            span.append(col);
            roues.push([col, 10 + Number(c)]);
          } else {
            span.textContent = c;
          }
          el.append(span);
        });
        requestAnimationFrame(() => requestAnimationFrame(() => roues.forEach(([col, v]) => col.style.setProperty('--v', String(v)))));
      }
    }, { threshold: 0.6 });
    compteurs.forEach((c) => io.observe(c));
  }


  // Custom cursor: a dot follows the mouse with a slight delay, opening into a ring over clickable elements.
  const curseur = document.querySelector<HTMLElement>('.curseur');
  if (curseur && souris) {
    let x = -100, y = -100, cx = -100, cy = -100;
    addEventListener('pointermove', (e) => {
      x = e.clientX;
      y = e.clientY;
      curseur.classList.add('is-on');
      const cible = e.target as Element;
      curseur.classList.toggle('is-actif', !!cible.closest('a, button, .card'));
      curseur.classList.toggle('is-titre', !!cible.closest('.hero__title'));
    });
    document.addEventListener('pointerleave', () => curseur.classList.remove('is-on'));
    addEventListener('pointerdown', () => curseur.classList.add('is-clic'));
    addEventListener('pointerup', () => curseur.classList.remove('is-clic'));
    const suivre = () => {
      cx += (x - cx) * 0.22;
      cy += (y - cy) * 0.22;
      curseur.style.translate = `${cx}px ${cy}px`;
      requestAnimationFrame(suivre);
    };
    requestAnimationFrame(suivre);
  }

  // Heading background: undulating dot grid, repelled by the mouse and colored purple.
  const fond = document.querySelector<HTMLCanvasElement>('.hero__fond');
  const ctx = fond?.getContext('2d');
  if (fond && ctx) {
    const ESP = 26; // dot spacing, in px
    const RAYON = 180; // mouse influence radius, in px
    let w = 0, h = 0, mx = -1e4, my = -1e4, visible = true, boucle = false;
    let encre = '#000', accent = '#000';
    const taille = () => {
      const r = fond.getBoundingClientRect();
      const dpr = Math.min(devicePixelRatio, 2);
      w = r.width;
      h = r.height;
      fond.width = w * dpr;
      fond.height = h * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      const st = getComputedStyle(fond);
      encre = st.getPropertyValue('--line').trim();
      accent = st.getPropertyValue('--accent').trim();
    };
    const dessiner = (t: number) => {
      ctx.clearRect(0, 0, w, h);
      for (let y = ESP / 2; y < h; y += ESP) {
        for (let x = ESP / 2; x < w; x += ESP) {
          const dx = x - mx, dy = y - my;
          const d = Math.hypot(dx, dy) || 1;
          const proche = Math.max(0, 1 - d / RAYON);
          const vague = animer ? Math.sin(x * 0.012 + y * 0.018 + t * 0.0012) * 0.5 + 0.5 : 0.5;
          const px = x + (dx / d) * proche * 16 + (x - w / 2) * defil * 0.6;
          const py = y + (dy / d) * proche * 16 + (y - h / 2) * defil * 0.6;
          const r = 0.8 + vague * 0.7 + proche * 2.4;
          ctx.globalAlpha = (0.14 + vague * 0.12) * (1 - defil);
          ctx.fillStyle = encre;
          ctx.beginPath();
          ctx.arc(px, py, r, 0, Math.PI * 2);
          ctx.fill();
          if (proche > 0) {
            ctx.globalAlpha = proche * 0.9;
            ctx.fillStyle = accent;
            ctx.fill();
          }
        }
      }
    };
    const tour = (t: number) => {
      dessiner(t);
      if (animer && visible && defil < 1 && !document.hidden) requestAnimationFrame(tour);
      else boucle = false;
    };
    const lancer = () => {
      if (boucle) return;
      boucle = true;
      requestAnimationFrame(tour);
    };
    new ResizeObserver(() => {
      taille();
      if (!animer) dessiner(0);
    }).observe(fond);
    new IntersectionObserver(([e]) => {
      visible = e.isIntersecting;
      if (visible && animer) lancer();
    }).observe(fond);
    document.addEventListener('visibilitychange', () => animer && visible && lancer());
    addEventListener('scroll', () => animer && visible && defil < 1 && lancer(), { passive: true });
    if (souris) {
      addEventListener('pointermove', (e) => {
        const r = fond.getBoundingClientRect();
        mx = e.clientX - r.left;
        my = e.clientY - r.top;
      });
    }
  }
</script>

