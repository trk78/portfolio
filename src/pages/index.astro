    background: var(--accent);
    translate: -50% -50%;
    scale: 0;
    transition: scale 0.5s cubic-bezier(0.3, 1.5, 0.5, 1);
  }
  .step h3 {
    margin: 2.25rem 0 0.4rem;
    font-size: 1.1rem;
    font-weight: 600;
  }
  .step p {
    margin: 0;
    /* Reserve three lines to prevent jumps when columns change width on hover. */
    min-height: 4.8em;
    color: var(--ink-soft);
  }
  /* ---------- Method: hover (actual mouse, data-actif set by the script) ---------- */
  #methode {
    isolation: isolate;
  }
  .steps {
    transition: grid-template-columns 0.6s cubic-bezier(0.2, 0.7, 0.1, 1);
  }
  @media (min-width: 901px) {
    #methode[data-actif='0'] .steps { grid-template-columns: 1.8fr 1fr 1fr 1fr; }
    #methode[data-actif='1'] .steps { grid-template-columns: 1fr 1.8fr 1fr 1fr; }
    #methode[data-actif='2'] .steps { grid-template-columns: 1fr 1fr 1.8fr 1fr; }
    #methode[data-actif='3'] .steps { grid-template-columns: 1fr 1fr 1fr 1.8fr; }
  }
  /* Use filter because the reveal animation (fill both) retains control of opacity. */
  #methode[data-actif] .step {
    filter: opacity(0.35);
  }
  #methode[data-actif='0'] .step:nth-child(1),
  #methode[data-actif='1'] .step:nth-child(2),
  #methode[data-actif='2'] .step:nth-child(3),
  #methode[data-actif='3'] .step:nth-child(4) {
