---
import Base from '../layouts/Base.astro';
import ArrowOut from '../components/ArrowOut.astro';
import Header from '../components/Header.astro';
import { SITE } from '../config';
import { services, etapes, projets, chiffres } from '../data/contenu';
import { num } from '../data/sections';

// Mots qui défilent à la fin du titre (le premier est celui affiché sans JS).
const mots = ['apps', 'bots', 'outils', 'jeux'];
const nombre = (n: number) => n.toLocaleString('fr-FR');

const annee = new Date().getFullYear();
---

<Base>
  <Header home />
  <div class="curseur" aria-hidden="true"></div>

  <main>
    <section class="hero wrap" aria-labelledby="hero-titre">
      <canvas class="hero__fond" aria-hidden="true"></canvas>
      <h1 id="hero-titre" class="hero__title" aria-label={`Je construis vos sites et vos ${mots.join(', ')}.`}>
        <span class="line" style="--d: 0" aria-hidden="true">Je construis</span>
        <span class="line" style="--d: 1" aria-hidden="true">vos sites</span>
        <span class="line" style="--d: 2" aria-hidden="true"
          ><em>&amp; vos <span class="swap" data-mots={mots.join(',')}>{mots[0]}</span>.</em></span
        >
      </h1>

    </section>

    <section id="services" class="block wrap" aria-labelledby="t-services">
      <div class="block__head title-reveal">
        <span class="mono block__num">{num('services')}</span>
        <h2 id="t-services"><span>Services</span></h2>
        <p class="block__aside">Un seul interlocuteur, du cahier des charges à la mise en ligne.</p>
      </div>
      <ol class="grid-services">
        {
          services.map((s, i) => (
            <li class="card reveal" style={`--i: ${i}`}>
              <span class="mono card__ref">{String.fromCharCode(65 + i)}</span>
              <h3>{s.titre}</h3>
              <p>{s.texte}</p>
              <ul class="mono card__pts">
                {s.points.map((p) => <li>{p}</li>)}
              </ul>
            </li>
          ))
        }
      </ol>
    </section>

    <section id="methode" class="block wrap" aria-labelledby="t-methode">
      <div class="block__head title-reveal">
        <span class="mono block__num">{num('methode')}</span>
        <h2 id="t-methode"><span>Méthode</span></h2>
        <p class="block__aside">Pas de surprise : prix fixé avant de commencer.</p>
      </div>
      <ol class="steps">
        {
          etapes.map((e, i) => (
            <li class="step reveal" style={`--i: ${i}`}>
              <span class="step__n">{i + 1}</span>
              <h3>{e.titre}</h3>
              <p>{e.texte}</p>
            </li>
          ))
        }
      </ol>
    </section>

    {
      projets.length > 0 && (
        <section id="projets" class="block wrap" aria-labelledby="t-projets">
          <div class="block__head title-reveal">
            <span class="mono block__num">{num('projets')}</span>
            <h2 id="t-projets"><span>Projets</span></h2>
            <p class="block__aside">Une sélection de ce qui tourne en production.</p>
          </div>
          <ul class="chiffres">
            {chiffres.map((c, i) => (
              <li class="chiffre reveal" style={`--i: ${i}`} hidden={!!c.source} data-source={c.source} data-champ={c.champ}>
                <strong class="compteur" data-valeur={c.valeur}>{nombre(c.valeur)}</strong>
                <span class="mono">{c.label}</span>
              </li>
            ))}
          </ul>
          <ul class="projets">
            {projets.map((p) => (
              <li class="projet reveal" style={p.apercu ? `--apercu: url(${p.apercu})` : undefined}>
                <span class="mono projet__an">{p.annee}</span>
                {p.logo ? (
                  <img class="projet__logo" src={p.logo} alt="" width="64" height="64" loading="lazy" decoding="async" />
                ) : (
                  <span class="projet__logo" aria-hidden="true" />
                )}
                <div>
                  <h3>
                    {p.url || p.repo ? (
                      <a href={p.url ?? p.repo} target="_blank" rel="noopener">
                        {p.nom}<ArrowOut />
                      </a>
                    ) : (
                      p.nom
                    )}
                  </h3>
                  <p>{p.resume}</p>
                  <p class="mono projet__liens">
                    {p.url && <a href={p.url} target="_blank" rel="noopener">Voir le site<ArrowOut /></a>}
                    {p.repo && <a href={p.repo} target="_blank" rel="noopener">Code sur GitHub<ArrowOut /></a>}
                  </p>
                </div>
                <div class="mono projet__side">
                  <span>{p.type}</span>
                  <span class="projet__stack">{p.stack.join(' · ')}</span>
                </div>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section id="contact" class="contact" aria-labelledby="t-contact">
      <div class="wrap">
        <div class="block__head title-reveal">
          <span class="mono block__num">{num('contact')}</span>
          <h2 id="t-contact"><span>Contact</span></h2>
          <p class="block__aside">Décrivez votre projet en quelques lignes : je réponds sous 24 h.</p>
        </div>
        <a class="contact__mail" href={`mailto:${SITE.email}?subject=${encodeURIComponent('Projet — premier contact')}`}>
          <span class="contact__label mono">Écrire à</span>
          <span class="contact__addr">{SITE.email}</span>
          <span class="contact__arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </section>
  </main>

  <footer class="footer wrap mono">
    <span>© {annee} {SITE.nom} — {SITE.statut}</span>
    <a href="/mentions-legales">Mentions légales</a>
  </footer>
</Base>

<script>
  const animer = !matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Apparition au défilement ; sans JS ou avec mouvement réduit, tout reste visible.
  const items = document.querySelectorAll<HTMLElement>('.reveal, .title-reveal');
  if ('IntersectionObserver' in window && animer) {
    document.documentElement.classList.add('js-reveal');
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            e.target.classList.add('is-in');
            io.unobserve(e.target);
          }
        }
      },
      { rootMargin: '0px 0px -10% 0px' },
    );
    items.forEach((el) => io.observe(el));
  }

  // Dernier mot du titre qui change : sort par le haut, le suivant monte par le bas.
  const swap = document.querySelector<HTMLElement>('.swap');
  const mots = swap?.dataset.mots?.split(',') ?? [];
  if (swap && mots.length > 1 && animer && 'animate' in swap) {
    let i = 0;
    const easing = 'cubic-bezier(0.2, 0.7, 0.1, 1)';
    const suivant = async () => {
      if (document.hidden) return;
      await swap.animate(
        [{ transform: 'none', opacity: 1 }, { transform: 'translateY(-60%)', opacity: 0 }],
        { duration: 380, easing: 'cubic-bezier(0.6, 0, 0.8, 0.4)', fill: 'forwards' },
      ).finished;
      i = (i + 1) % mots.length;
      swap.textContent = mots[i];
      swap.animate(
        [{ transform: 'translateY(60%)', opacity: 0 }, { transform: 'none', opacity: 1 }],
        { duration: 620, easing, fill: 'forwards' },
      );
    };
    // On attend la fin de l'arrivée du titre avant de commencer.
    setTimeout(() => setInterval(suivant, 2600), 1400);
  }

  // Effets liés à la souris : seulement avec une vraie souris (pas sur mobile) et sans « mouvement réduit ».
  const souris = animer && matchMedia('(hover: hover) and (pointer: fine)').matches;

  // Titre en profondeur : on suit le curseur dans toute la fenêtre.
  const hero = document.querySelector<HTMLElement>('.hero__title');
  if (souris) {
    document.documentElement.classList.add('a-souris');
    addEventListener('pointermove', (e) => {
      // Position de -1 à 1 par rapport au centre de l'écran.
      hero?.style.setProperty('--mx', (e.clientX / innerWidth - 0.5) * 2 + '');
      hero?.style.setProperty('--my', (e.clientY / innerHeight - 0.5) * 2 + '');
    });
  }

  // Cartes de services inclinables, avec reflet sous le curseur.
  if (souris) {
    document.querySelectorAll<HTMLElement>('.card').forEach((card) => {
      card.addEventListener('pointermove', (e) => {
        const r = card.getBoundingClientRect();
        const px = (e.clientX - r.left) / r.width;
        const py = (e.clientY - r.top) / r.height;
        card.style.setProperty('--px', `${px * 100}%`);
        card.style.setProperty('--py', `${py * 100}%`);
        card.style.setProperty('--rx', `${(0.5 - py) * 10}deg`);
        card.style.setProperty('--ry', `${(px - 0.5) * 10}deg`);
      });
      card.addEventListener('pointerleave', () => {
        card.style.setProperty('--rx', '0deg');
        card.style.setProperty('--ry', '0deg');
      });
    });
  }

  // Chiffres en direct : on lit la valeur, puis on affiche le chiffre (il reste masqué si la source ne répond pas).
  document.querySelectorAll<HTMLElement>('.chiffre[data-source]').forEach(async (li) => {
    try {
      const json = await (await fetch(li.dataset.source!)).json();
      const n = Number(json[li.dataset.champ!]);
      if (!Number.isFinite(n) || n <= 0) return;
      const el = li.querySelector<HTMLElement>('.compteur')!;
      el.dataset.valeur = String(n);
      el.textContent = n.toLocaleString('fr-FR');
      li.hidden = false;
    } catch {
      // Source indisponible : le chiffre reste masqué.
    }
  });

  // Compteurs : défilent de 0 à leur valeur à l'arrivée à l'écran (valeur finale déjà dans le HTML).
  const compteurs = document.querySelectorAll<HTMLElement>('.compteur');
  if (animer && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        io.unobserve(e.target);
        const el = e.target as HTMLElement;
        const fin = Number(el.dataset.valeur);
        const debut = performance.now();
        const pas = (t: number) => {
          const k = Math.min((t - debut) / 1400, 1);
          el.textContent = Math.round(fin * (1 - (1 - k) ** 3)).toLocaleString('fr-FR');
          if (k < 1) requestAnimationFrame(pas);
        };
        requestAnimationFrame(pas);
      }
    }, { threshold: 0.6 });
    compteurs.forEach((c) => io.observe(c));
  }


  // Curseur personnalisé : un point qui suit la souris avec un léger retard, et s'ouvre en anneau sur ce qui est cliquable.
  const curseur = document.querySelector<HTMLElement>('.curseur');
  if (curseur && souris) {
    let x = -100, y = -100, cx = -100, cy = -100;
    addEventListener('pointermove', (e) => {
      x = e.clientX;
      y = e.clientY;
      curseur.classList.add('is-on');
      curseur.classList.toggle('is-actif', !!(e.target as Element).closest('a, button, .card'));
    });
    document.addEventListener('pointerleave', () => curseur.classList.remove('is-on'));
    addEventListener('pointerdown', () => curseur.classList.add('is-clic'));
    addEventListener('pointerup', () => curseur.classList.remove('is-clic'));
    const suivre = () => {
      cx += (x - cx) * 0.22;
      cy += (y - cy) * 0.22;
      curseur.style.translate = `${cx}px ${cy}px`;
      requestAnimationFrame(suivre);
    };
    requestAnimationFrame(suivre);
  }

  // Fond du titre : grille de points qui ondule, et que la souris repousse et colore en violet.
  const fond = document.querySelector<HTMLCanvasElement>('.hero__fond');
  const ctx = fond?.getContext('2d');
  if (fond && ctx) {
    const ESP = 26; // espacement des points, en px
    const RAYON = 180; // zone d'influence de la souris, en px
    let w = 0, h = 0, mx = -1e4, my = -1e4, visible = true, boucle = false;
    let encre = '#000', accent = '#000';
    const taille = () => {
      const r = fond.getBoundingClientRect();
      const dpr = Math.min(devicePixelRatio, 2);
      w = r.width;
      h = r.height;
      fond.width = w * dpr;
      fond.height = h * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      const st = getComputedStyle(fond);
      encre = st.getPropertyValue('--line').trim();
      accent = st.getPropertyValue('--accent').trim();
    };
    const dessiner = (t: number) => {
      ctx.clearRect(0, 0, w, h);
      for (let y = ESP / 2; y < h; y += ESP) {
        for (let x = ESP / 2; x < w; x += ESP) {
          const dx = x - mx, dy = y - my;
          const d = Math.hypot(dx, dy) || 1;
          const proche = Math.max(0, 1 - d / RAYON);
          const vague = animer ? Math.sin(x * 0.012 + y * 0.018 + t * 0.0012) * 0.5 + 0.5 : 0.5;
          const px = x + (dx / d) * proche * 16;
          const py = y + (dy / d) * proche * 16;
          const r = 0.8 + vague * 0.7 + proche * 2.4;
          ctx.globalAlpha = 0.14 + vague * 0.12;
          ctx.fillStyle = encre;
          ctx.beginPath();
          ctx.arc(px, py, r, 0, Math.PI * 2);
          ctx.fill();
          if (proche > 0) {
            ctx.globalAlpha = proche * 0.9;
            ctx.fillStyle = accent;
            ctx.fill();
          }
        }
      }
    };
    const tour = (t: number) => {
      dessiner(t);
      if (animer && visible && !document.hidden) requestAnimationFrame(tour);
      else boucle = false;
    };
    const lancer = () => {
      if (boucle) return;
      boucle = true;
      requestAnimationFrame(tour);
    };
    new ResizeObserver(() => {
      taille();
      if (!animer) dessiner(0);
    }).observe(fond);
    new IntersectionObserver(([e]) => {
      visible = e.isIntersecting;
      if (visible && animer) lancer();
    }).observe(fond);
    document.addEventListener('visibilitychange', () => animer && visible && lancer());
    if (souris) {
      addEventListener('pointermove', (e) => {
        const r = fond.getBoundingClientRect();
        mx = e.clientX - r.left;
        my = e.clientY - r.top;
      });
    }
  }
</script>

<style>
  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    isolation: isolate;
    padding-top: clamp(2.5rem, 7vw, 6rem);
    padding-bottom: clamp(3rem, 7vw, 6rem);
  }
  /* Toile pleine largeur derrière le titre, fondue sur les bords. */
  .hero__fond {
    position: absolute;
    z-index: -1;
    top: 0;
    left: 50%;
    width: 100vw;
    height: 100%;
    translate: -50% 0;
    pointer-events: none;
    mask-image: radial-gradient(ellipse 70% 75% at 50% 50%, #000 35%, transparent 85%);
  }
  .hero__title {
    margin: 0;
    font-family: var(--f-display);
    font-weight: 900;
    text-transform: uppercase;
    font-size: clamp(3.6rem, 15.5vw, 13.5rem);
    line-height: 0.84;
    letter-spacing: -0.01em;
  }
  .hero__title .line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.04em;
    animation: rise 0.9s cubic-bezier(0.2, 0.7, 0.1, 1) both;
    animation-delay: calc(var(--d) * 110ms + 80ms);
  }
  .hero__title em {
    font-style: normal;
    color: var(--accent);
  }
  .swap {
    display: inline-block;
  }
  @keyframes rise {
    from { transform: translateY(40%); opacity: 0; clip-path: inset(0 0 100% 0); }
    to { transform: none; opacity: 1; clip-path: inset(0 0 0 0); }
  }

  @keyframes fade {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: none; }
  }
  /* ---------- Blocs ---------- */
  .block {
    padding-top: clamp(3rem, 7vw, 6rem);
    padding-bottom: clamp(3rem, 7vw, 6rem);
    border-top: 1px solid var(--line);
  }
  .block__head {
    display: grid;
    grid-template-columns: 4rem 1fr minmax(0, 22rem);
    align-items: baseline;
    gap: 1rem;
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
  }
  .block__num {
    color: var(--accent);
    font-size: 0.85rem;
  }
  .block__head h2 {
    margin: 0;
    font-family: var(--f-display);
    font-weight: 900;
    text-transform: uppercase;
    font-size: clamp(2.6rem, 7vw, 5.5rem);
    line-height: 0.9;
  }
  .block__aside {
    margin: 0;
    color: var(--ink-soft);
  }
  .block__head h2 > span {
    display: block;
  }
  /* Titres de section : même montée que le grand titre, numéro et aparté en fondu juste après. */
  :global(.js-reveal) .title-reveal h2 > span,
  :global(.js-reveal) .title-reveal .block__num,
  :global(.js-reveal) .title-reveal .block__aside {
    opacity: 0;
  }
  :global(.js-reveal) .title-reveal.is-in h2 > span {
    animation: rise-titre 0.9s cubic-bezier(0.2, 0.7, 0.1, 1) both;
  }
  /* Comme « rise », mais la découpe déborde de la ligne : sinon l'accent de « MÉTHODE » est rogné. */
  @keyframes rise-titre {
    from { transform: translateY(40%); opacity: 0; clip-path: inset(-40% -5% 100% -5%); }
    to { transform: none; opacity: 1; clip-path: inset(-40% -5% -20% -5%); }
  }
  :global(.js-reveal) .title-reveal.is-in .block__num,
  :global(.js-reveal) .title-reveal.is-in .block__aside {
    animation: fade 0.7s 0.25s both;
  }
  @media (max-width: 760px) {
    .block__head {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
  }

  /* ---------- Services ---------- */
  .grid-services {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-left: 1px solid var(--line);
    border-top: 1px solid var(--line);
  }
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 1.5rem 1.25rem 1.75rem;
    min-height: 22rem;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    background: var(--paper);
    transition: background 0.25s, color 0.25s;
  }
  .card:hover {
    background: var(--accent);
    color: var(--accent-ink);
  }
  .card__ref {
    font-size: 0.85rem;
  }
  .card h3 {
    margin: auto 0 0.6rem;
    padding-top: 3rem;
    font-family: var(--f-display);
    font-weight: 700;
    text-transform: uppercase;
    font-size: 2.1rem;
    line-height: 0.95;
  }
  .card p {
    margin: 0 0 1.25rem;
  }
  .card__pts {
    list-style: none;
    margin: 0;
    padding: 1rem 0 0;
    border-top: 1px solid currentColor;
    display: grid;
    gap: 0.3rem;
    font-size: 0.7rem;
  }
  .card__pts li::before {
    content: '+ ';
  }
  @media (max-width: 1080px) {
    .grid-services {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 560px) {
    .grid-services {
      grid-template-columns: 1fr;
    }
    .card {
      min-height: 0;
    }
    .card h3 {
      padding-top: 1.5rem;
    }
  }

  /* ---------- Méthode ---------- */
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(1rem, 2.5vw, 2rem);
    counter-reset: step;
  }
  .step {
    position: relative;
    padding-top: 1.25rem;
    border-top: 3px solid var(--ink);
  }
  .step:first-child {
    border-top-color: var(--accent);
  }
  .step__n {
    display: block;
    font-family: var(--f-display);
    font-weight: 900;
    font-size: clamp(4rem, 8vw, 6.5rem);
    line-height: 0.8;
    color: transparent;
    -webkit-text-stroke: 1.5px var(--ink);
    /* Remplissage de bas en haut à l'apparition : un dégradé net glisse dans le texte. */
    background: linear-gradient(to top, var(--ink) 50%, transparent 50%) top / 100% 200% no-repeat;
    -webkit-background-clip: text;
    background-clip: text;
  }
  :global(.js-reveal) .step.is-in .step__n {
    animation: remplir 0.9s cubic-bezier(0.6, 0, 0.2, 1) both;
    animation-delay: calc(var(--i, 0) * 120ms + 350ms);
  }
  .step:first-child .step__n {
    background-image: linear-gradient(to top, var(--accent) 50%, transparent 50%);
    -webkit-text-stroke-color: var(--accent);
  }
  @keyframes remplir {
    to { background-position: bottom; }
  }
  .step h3 {
    margin: 1rem 0 0.4rem;
    font-size: 1.1rem;
    font-weight: 600;
  }
  .step p {
    margin: 0;
    color: var(--ink-soft);
  }
  @media (max-width: 900px) {
    .steps {
      grid-template-columns: repeat(2, 1fr);
      row-gap: 2.5rem;
    }
  }
  @media (max-width: 480px) {
    .steps {
      grid-template-columns: 1fr;
    }
  }

  /* ---------- Projets ---------- */
  .projets {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .projet {
    position: relative;
    display: grid;
    grid-template-columns: 5rem 4rem 1fr 16rem;
    gap: 1.5rem;
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--line);
  }
  .projet h3 {
    margin: 0 0 0.3rem;
    font-family: var(--f-display);
    font-weight: 700;
    text-transform: uppercase;
    font-size: 2rem;
    line-height: 1;
  }
  .projet h3 a {
    text-decoration: none;
    transition: color 0.2s;
  }
  /* Toute la ligne est cliquable (lien étiré) ; les petits liens restent au-dessus. */
  .projet h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .projet::before {
    content: '';
    position: absolute;
    inset: 0 calc(-1 * min(1rem, var(--gutter)));
    /* Capture d'accueil du site, voilée côté texte pour rester lisible. */
    background:
      linear-gradient(90deg, color-mix(in srgb, var(--paper) 94%, transparent) 30%, color-mix(in srgb, var(--paper) 55%, transparent)),
      var(--apercu, none) center top / cover no-repeat;
    opacity: 0;
    scale: 1.02;
    transition:
      opacity 0.35s,
      scale 0.5s cubic-bezier(0.2, 0.7, 0.1, 1);
    pointer-events: none;
  }
  .projet:hover::before {
