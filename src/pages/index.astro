    color: transparent;
    -webkit-text-stroke: 1.5px var(--ink);
    /* Bottom-to-top fill on reveal: a hard-edged gradient slides through the text. */
    background: linear-gradient(to top, var(--ink) 50%, transparent 50%) top / 100% 200% no-repeat;
    -webkit-background-clip: text;
    background-clip: text;
  }
  :global(.js-reveal) .step.is-in .step__n {
    animation: remplir 0.9s cubic-bezier(0.6, 0, 0.2, 1) both;
    animation-delay: calc(var(--i, 0) * 120ms + 350ms);
  }
