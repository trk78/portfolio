  @keyframes remplir {
    to { background-position: bottom; }
  }
  /* Purple bubble behind the hovered number; outside it so the number's scale does not bring the bubble forward. */
  .step__tete {
    position: relative;
    display: block;
    width: fit-content;
  }
  .step__bulle {
    position: absolute;
    z-index: -1;
    left: 50%;
    top: 50%;
    width: clamp(5.5rem, 10vw, 8.5rem);
    aspect-ratio: 1;
