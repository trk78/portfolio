---
import Base from '../layouts/Base.astro';
import ArrowOut from '../components/ArrowOut.astro';
import Header from '../components/Header.astro';
import { SITE } from '../config';
import { services, etapes, projets, chiffres } from '../data/contenu';
import { num } from '../data/sections';

// Mots qui défilent à la fin du titre (le premier est celui affiché sans JS).
const mots = ['apps', 'bots', 'outils', 'jeux'];
const nombre = (n: number) => n.toLocaleString('fr-FR');
const lettres = (t: string) => [...t];

const annee = new Date().getFullYear();

// Pictos des services, dans l'ordre de `services` ; pathLength=1 pour les tracer au survol quelle que soit leur longueur.
const pictos = [
  // Site vitrine : fenêtre de navigateur
  '<rect x="3" y="5" width="42" height="34" rx="3" pathLength="1"/><path d="M3 13h42" pathLength="1"/><path d="M10 22h18M10 28h28M10 33h14" pathLength="1"/>',
  // Application web : fenêtre avec barre latérale, deux cartes de chiffres et une courbe
  '<rect x="3" y="5" width="42" height="34" rx="3" pathLength="1"/><path d="M3 12h42M14 12v27M7 8.5h1M10.5 8.5h1M6.5 17h4M6.5 21h4M6.5 25h4" pathLength="1"/><path d="M18 16h10v6H18zM31 16h10v6H31zM18 34l5-5 4 3 6-6 8 4" pathLength="1"/>',
  // Application mobile : téléphone
  '<rect x="13" y="2" width="22" height="42" rx="4" pathLength="1"/><path d="M21 7h6M22 38h4" pathLength="1"/><path d="M18 16h12M18 21h8M18 26h12" pathLength="1"/>',
  // Automatisation & IA : robot
  '<rect x="8" y="14" width="32" height="24" rx="5" pathLength="1"/><path d="M24 14V7M20 5h8M3 24v6M45 24v6" pathLength="1"/><path d="M17 23v4M31 23v4M18 32h12" pathLength="1"/>',
];
// Méthode : lignes de code tapées en fond pendant le survol de « Développement ».
const code = [
  'const projet = await concevoir(besoin);',
  'for (const sprint of planning) {',
  '  livrer(sprint); // vous suivez chaque étape',
  '}',
  'await tester(projet, { mobile: true });',
  'deployer(projet);',
];
// Scènes des autres étapes : un échange type, un devis, un déploiement. Illustration, aucun chiffre réel.
const chat = [
  { qui: 'client', texte: "J'ai besoin d'un site pour mon restaurant." },
  { qui: 'moi', texte: "Qu'est-ce qui compte le plus pour vous ?" },
  { qui: 'client', texte: 'Prendre des réservations, et être trouvé sur Google.' },
  { qui: 'moi', texte: 'Noté : réservation en ligne + référencement local.' },
];
const devis = [
  ['Périmètre', '5 pages + réservation'],
  ['Délai', '3 semaines'],
  ['Prix', 'fixe, sans surprise'],
];
const deploiement = ['build', 'tests', 'nom de domaine', 'HTTPS'];
---

<Base>
  <Header home />
  <div class="curseur" aria-hidden="true"></div>

  <main>
    <section class="hero wrap" aria-labelledby="hero-titre">
      <canvas class="hero__fond" aria-hidden="true"></canvas>
      <h1 id="hero-titre" class="hero__title" aria-label={`Je construis vos sites et vos ${mots.join(', ')}.`}>
        <span class="line" style="--d: 0" aria-hidden="true">{lettres('Je construis').map((c) => (c === ' ' ? ' ' : <span class="l">{c}</span>))}</span>
        <span class="line" style="--d: 1" aria-hidden="true">{lettres('vos sites').map((c) => (c === ' ' ? ' ' : <span class="l">{c}</span>))}</span>
        <span class="line" style="--d: 2" aria-hidden="true"
          ><em>&amp; vos <span class="swap" data-mots={mots.join(',')}>{mots[0]}</span>.</em></span
        >
      </h1>

    </section>

    <section id="services" class="block wrap" aria-labelledby="t-services">
      <div class="block__head title-reveal">
        <span class="mono block__num">{num('services')}</span>
        <h2 id="t-services"><span>Services</span></h2>
      </div>
      <ol class="grid-services">
        {
          services.map((s, i) => (
            <li class="card reveal" style={`--i: ${i}`}>
              <span class="mono card__ref">{String.fromCharCode(65 + i)}</span>
              <svg class="card__picto" viewBox="0 0 48 46" aria-hidden="true" set:html={pictos[i]} />
              <h3>{s.titre}</h3>
              <p>{s.texte}</p>
              <ul class="mono card__pts">
                {s.points.map((p, k) => <li style={`--k: ${k}`}>{p}</li>)}
              </ul>
            </li>
          ))
        }
      </ol>
    </section>

    <section id="methode" class="block wrap" aria-labelledby="t-methode">
      <div class="block__head title-reveal">
        <span class="mono block__num">{num('methode')}</span>
        <h2 id="t-methode"><span>Méthode</span></h2>
      </div>
      <div class="methode__fond" aria-hidden="true">
        <div class="fond fond-0">
          <div class="chat">{chat.map((m, j) => <span class={m.qui} style={`--j: ${j}`}>{m.texte}</span>)}</div>
        </div>
        <div class="fond fond-1">
          <div class="devis">
            <b>Devis</b>
            {devis.map(([k, v], j) => <span style={`--j: ${j + 1}`}><em>{k}</em>{v}</span>)}
            <strong style={`--j: ${devis.length + 1}`}>Signé</strong>
          </div>
        </div>
        <div class="fond fond-2">{code.map((l, j) => <span style={`--j: ${j}; --n: ${l.length}`}>{l}</span>)}</div>
        <div class="fond fond-3">
          <div class="deploi">
            {deploiement.map((l, j) => <span style={`--j: ${j}`}>✓ {l}</span>)}
            <strong style={`--j: ${deploiement.length}`}>En ligne</strong>
          </div>
          <i class="deploi__barre" />
        </div>
      </div>
      <ol class="steps">
        {
          etapes.map((e, i) => (
            <li class="step reveal" style={`--i: ${i}`}>
              <span class="step__tete"><span class="step__bulle" aria-hidden="true" /><span class="step__n">{i + 1}</span></span>
              <h3>{e.titre}</h3>
              <p>{e.texte}</p>
            </li>
          ))
        }
      </ol>
    </section>

    {
      projets.length > 0 && (
        <section id="projets" class="block wrap" aria-labelledby="t-projets">
          <div class="block__head title-reveal">
            <span class="mono block__num">{num('projets')}</span>
            <h2 id="t-projets"><span>Projets</span></h2>
          </div>
          <div class="projets__fond" aria-hidden="true"></div>
          <div class="projets__fond" aria-hidden="true"></div>
          <ul class="chiffres">
            {chiffres.map((c, i) => (
              <li class="chiffre reveal" style={`--i: ${i}`} hidden={!!c.source} data-source={c.source} data-champ={c.champ}>
                <strong class="compteur" data-valeur={c.valeur}>{nombre(c.valeur)}</strong>
                <span class="mono">{c.label}</span>
              </li>
            ))}
          </ul>
          <ul class="projets">
            {projets.map((p) => (
              <li class="projet reveal" data-apercu={p.apercu}>
                <span class="mono projet__an">{p.annee}</span>
                {p.logo ? (
                  <img class="projet__logo" src={p.logo} alt="" width="64" height="64" loading="lazy" decoding="async" />
                ) : (
                  <span class="projet__logo" aria-hidden="true" />
                )}
                <div>
                  <h3>
                    {p.url || p.repo ? (
                      <a href={p.url ?? p.repo} target="_blank" rel="noopener">
                        {p.nom}<ArrowOut />
                      </a>
                    ) : (
                      p.nom
                    )}
                  </h3>
                  <p>{p.resume}</p>
                  <p class="mono projet__liens">
                    {p.url && <a href={p.url} target="_blank" rel="noopener">Voir le site<ArrowOut /></a>}
                    {p.repo && <a href={p.repo} target="_blank" rel="noopener">Code sur GitHub<ArrowOut /></a>}
                  </p>
                </div>
                <div class="mono projet__side">
                  <span>{p.type}</span>
                  <span class="projet__stack">{p.stack.join(' · ')}</span>
                </div>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section id="contact" class="contact" aria-labelledby="t-contact">
      <div class="wrap">
        <div class="block__head title-reveal">
          <span class="mono block__num">{num('contact')}</span>
          <h2 id="t-contact"><span>Contact</span></h2>
        </div>
        <a class="contact__mail" aria-label={`Écrire à ${SITE.email}`} href={`mailto:${SITE.email}?subject=${encodeURIComponent('Projet — premier contact')}`}>
          <span class="contact__label mono">Écrire à</span>
          <span class="contact__addr reveal-lettres">{lettres(SITE.email).map((c, k) => <span class="l" style={`--k: ${k}`} aria-hidden="true">{c}</span>)}</span>
          <span class="contact__arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </section>
  </main>

  <footer class="footer wrap mono">
    <span>© {annee} {SITE.nom} — {SITE.statut}</span>
    <a href="/mentions-legales">Mentions légales</a>
  </footer>
</Base>

<script>
  const animer = !matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Apparition au défilement ; sans JS ou avec mouvement réduit, tout reste visible.
  const items = document.querySelectorAll<HTMLElement>('.reveal, .title-reveal, .block, .reveal-lettres');
  if ('IntersectionObserver' in window && animer) {
    document.documentElement.classList.add('js-reveal');
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            e.target.classList.add('is-in');
            io.unobserve(e.target);
          }
        }
      },
      { rootMargin: '0px 0px -10% 0px' },
    );
    items.forEach((el) => io.observe(el));
  }

  // Dernier mot du titre qui change : sort par le haut, le suivant monte par le bas.
  const swap = document.querySelector<HTMLElement>('.swap');
  const mots = swap?.dataset.mots?.split(',') ?? [];
  if (swap && mots.length > 1 && animer && 'animate' in swap) {
    let i = 0;
    const easing = 'cubic-bezier(0.2, 0.7, 0.1, 1)';
    const suivant = async () => {
      if (document.hidden) return;
      await swap.animate(
        [{ transform: 'none', opacity: 1 }, { transform: 'translateY(-60%)', opacity: 0 }],
        { duration: 380, easing: 'cubic-bezier(0.6, 0, 0.8, 0.4)', fill: 'forwards' },
      ).finished;
      i = (i + 1) % mots.length;
      swap.textContent = mots[i];
      swap.animate(
        [{ transform: 'translateY(60%)', opacity: 0 }, { transform: 'none', opacity: 1 }],
        { duration: 620, easing, fill: 'forwards' },
      );
    };
    // On attend la fin de l'arrivée du titre avant de commencer.
    setTimeout(() => setInterval(suivant, 2600), 1400);
  }

  // Effets liés à la souris : seulement avec une vraie souris (pas sur mobile) et sans « mouvement réduit ».
  const souris = animer && matchMedia('(hover: hover) and (pointer: fine)').matches;

  // Titre en profondeur : on suit le curseur dans toute la fenêtre.
  const hero = document.querySelector<HTMLElement>('.hero__title');
  if (souris) {
    document.documentElement.classList.add('a-souris');
    addEventListener('pointermove', (e) => {
      // Position de -1 à 1 par rapport au centre de l'écran.
      hero?.style.setProperty('--mx', (e.clientX / innerWidth - 0.5) * 2 + '');
      hero?.style.setProperty('--my', (e.clientY / innerHeight - 0.5) * 2 + '');
    });
  }

  // Cartes de services : reflet sous le curseur, et le remplissage part du point par lequel on entre.
  if (souris) {
    document.querySelectorAll<HTMLElement>('.card').forEach((card) => {
      const pos = (e: PointerEvent) => {
        const r = card.getBoundingClientRect();
        card.style.setProperty('--px', `${((e.clientX - r.left) / r.width) * 100}%`);
        card.style.setProperty('--py', `${((e.clientY - r.top) / r.height) * 100}%`);
      };
      card.addEventListener('pointerenter', pos);
      card.addEventListener('pointermove', pos);
    });
  }

  // Méthode : le trait au-dessus des étapes se remplit en violet au fil du défilement.
  const steps = document.querySelector<HTMLElement>('.steps');
  if (steps && animer) {
    const maj = () => {
      const r = steps.getBoundingClientRect();
      // 0 quand la liste entre par le bas de l'écran, 1 quand elle atteint le tiers haut.
      const p = (innerHeight - r.top) / (innerHeight * 0.67);
      steps.style.setProperty('--p', String(Math.min(Math.max(p, 0), 1)));
    };
    maj();
    addEventListener('scroll', maj, { passive: true });
    addEventListener('resize', maj);
  }

  // Méthode : l'étape survolée s'élargit et lance sa scène en fond de toute la section.
  const methode = document.querySelector<HTMLElement>('#methode');
  if (steps && methode && souris) {
    steps.querySelectorAll<HTMLElement>('.step').forEach((li, i) => {
      li.addEventListener('pointerenter', () => (methode.dataset.actif = String(i)));
    });
    steps.addEventListener('pointerleave', () => delete methode.dataset.actif);
  }

  // Contact : la flèche est attirée par le curseur tant qu'il survole le bloc de l'e-mail.
  const mail = document.querySelector<HTMLElement>('.contact__mail');
  if (mail && souris) {
    mail.addEventListener('pointermove', (e) => {
      const r = mail.getBoundingClientRect();
      mail.style.setProperty('--ax', `${(e.clientX - (r.right - r.height / 2)) * 0.12}px`);
      mail.style.setProperty('--ay', `${(e.clientY - (r.top + r.height / 2)) * 0.25}px`);
    });
    mail.addEventListener('pointerleave', () => {
      mail.style.setProperty('--ax', '0px');
      mail.style.setProperty('--ay', '0px');
    });
  }

  // Chiffres en direct : on lit la valeur, puis on affiche le chiffre (il reste masqué si la source ne répond pas).
  document.querySelectorAll<HTMLElement>('.chiffre[data-source]').forEach(async (li) => {
    try {
      const json = await (await fetch(li.dataset.source!)).json();
      const n = Number(json[li.dataset.champ!]);
      if (!Number.isFinite(n) || n <= 0) return;
      const el = li.querySelector<HTMLElement>('.compteur')!;
      el.dataset.valeur = String(n);
      el.textContent = n.toLocaleString('fr-FR');
      li.hidden = false;
    } catch {
      // Source indisponible : le chiffre reste masqué.
    }
  });

  // Survol d'un projet : la capture de son site devient le fond de toute la section.
  // Deux calques qui se relaient pour un fondu enchaîné d'une capture à l'autre.
  const fonds = [...document.querySelectorAll<HTMLElement>('.projets__fond')];
  const liste = document.querySelector<HTMLElement>('.projets');
  const section = document.querySelector<HTMLElement>('#projets');
  if (fonds.length === 2 && liste && matchMedia('(hover: hover)').matches) {
    let actif = 0;
    let courant = '';
    // Précharge toutes les captures dès qu'on approche de la liste : pas de trou au premier survol.
    liste.addEventListener('pointerenter', () => {
      liste.querySelectorAll<HTMLElement>('.projet[data-apercu]').forEach((li) => (new Image().src = li.dataset.apercu!));
    }, { once: true });
    liste.querySelectorAll<HTMLElement>('.projet[data-apercu]').forEach((li) => {
      li.addEventListener('pointerenter', () => {
        const src = li.dataset.apercu!;
        if (src !== courant) {
          actif = 1 - actif;
          fonds[actif].style.setProperty('--fond', `url(${src})`);
          courant = src;
        }
        fonds[actif].classList.add('is-on');
        fonds[1 - actif].classList.remove('is-on');
        section?.classList.add('a-fond');
      });
    });
    // On n'éteint qu'en quittant toute la liste, pour ne pas clignoter entre deux lignes.
    liste.addEventListener('pointerleave', () => {
      fonds.forEach((f) => f.classList.remove('is-on'));
      section?.classList.remove('a-fond');
    });
  }

  // Compteurs : défilent de 0 à leur valeur à l'arrivée à l'écran (valeur finale déjà dans le HTML).
  const compteurs = document.querySelectorAll<HTMLElement>('.compteur');
  if (animer && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        io.unobserve(e.target);
        const el = e.target as HTMLElement;
        const fin = Number(el.dataset.valeur);
        const debut = performance.now();
        const pas = (t: number) => {
          const k = Math.min((t - debut) / 1400, 1);
          el.textContent = Math.round(fin * (1 - (1 - k) ** 3)).toLocaleString('fr-FR');
          if (k < 1) requestAnimationFrame(pas);
        };
        requestAnimationFrame(pas);
      }
    }, { threshold: 0.6 });
    compteurs.forEach((c) => io.observe(c));
  }


  // Curseur personnalisé : un point qui suit la souris avec un léger retard, et s'ouvre en anneau sur ce qui est cliquable.
  const curseur = document.querySelector<HTMLElement>('.curseur');
  if (curseur && souris) {
    let x = -100, y = -100, cx = -100, cy = -100;
    addEventListener('pointermove', (e) => {
      x = e.clientX;
      y = e.clientY;
      curseur.classList.add('is-on');
      curseur.classList.toggle('is-actif', !!(e.target as Element).closest('a, button, .card'));
    });
    document.addEventListener('pointerleave', () => curseur.classList.remove('is-on'));
    addEventListener('pointerdown', () => curseur.classList.add('is-clic'));
    addEventListener('pointerup', () => curseur.classList.remove('is-clic'));
    const suivre = () => {
      cx += (x - cx) * 0.22;
      cy += (y - cy) * 0.22;
      curseur.style.translate = `${cx}px ${cy}px`;
      requestAnimationFrame(suivre);
    };
    requestAnimationFrame(suivre);
  }

  // Fond du titre : grille de points qui ondule, et que la souris repousse et colore en violet.
  const fond = document.querySelector<HTMLCanvasElement>('.hero__fond');
  const ctx = fond?.getContext('2d');
  if (fond && ctx) {
    const ESP = 26; // espacement des points, en px
    const RAYON = 180; // zone d'influence de la souris, en px
    let w = 0, h = 0, mx = -1e4, my = -1e4, visible = true, boucle = false;
    let encre = '#000', accent = '#000';
    const taille = () => {
      const r = fond.getBoundingClientRect();
      const dpr = Math.min(devicePixelRatio, 2);
      w = r.width;
      h = r.height;
      fond.width = w * dpr;
      fond.height = h * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      const st = getComputedStyle(fond);
      encre = st.getPropertyValue('--line').trim();
      accent = st.getPropertyValue('--accent').trim();
    };
    const dessiner = (t: number) => {
      ctx.clearRect(0, 0, w, h);
      for (let y = ESP / 2; y < h; y += ESP) {
        for (let x = ESP / 2; x < w; x += ESP) {
          const dx = x - mx, dy = y - my;
          const d = Math.hypot(dx, dy) || 1;
          const proche = Math.max(0, 1 - d / RAYON);
          const vague = animer ? Math.sin(x * 0.012 + y * 0.018 + t * 0.0012) * 0.5 + 0.5 : 0.5;
          const px = x + (dx / d) * proche * 16;
          const py = y + (dy / d) * proche * 16;
          const r = 0.8 + vague * 0.7 + proche * 2.4;
          ctx.globalAlpha = 0.14 + vague * 0.12;
          ctx.fillStyle = encre;
          ctx.beginPath();
          ctx.arc(px, py, r, 0, Math.PI * 2);
          ctx.fill();
          if (proche > 0) {
            ctx.globalAlpha = proche * 0.9;
            ctx.fillStyle = accent;
            ctx.fill();
          }
        }
      }
    };
    const tour = (t: number) => {
      dessiner(t);
      if (animer && visible && !document.hidden) requestAnimationFrame(tour);
      else boucle = false;
    };
    const lancer = () => {
      if (boucle) return;
      boucle = true;
      requestAnimationFrame(tour);
    };
    new ResizeObserver(() => {
      taille();
      if (!animer) dessiner(0);
    }).observe(fond);
    new IntersectionObserver(([e]) => {
      visible = e.isIntersecting;
      if (visible && animer) lancer();
    }).observe(fond);
    document.addEventListener('visibilitychange', () => animer && visible && lancer());
    if (souris) {
      addEventListener('pointermove', (e) => {
        const r = fond.getBoundingClientRect();
        mx = e.clientX - r.left;
        my = e.clientY - r.top;
      });
    }
  }
</script>

<style>
  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    isolation: isolate;
    padding-top: clamp(2.5rem, 7vw, 6rem);
    padding-bottom: clamp(3rem, 7vw, 6rem);
  }
  /* Toile pleine largeur derrière le titre, fondue sur les bords. */
  .hero__fond {
    position: absolute;
    z-index: -1;
    top: 0;
    left: 50%;
    width: 100vw;
    height: 100%;
    translate: -50% 0;
    pointer-events: none;
    mask-image: radial-gradient(ellipse 70% 75% at 50% 50%, #000 35%, transparent 85%);
  }
  .hero__title {
    margin: 0;
    font-family: var(--f-display);
    font-weight: 900;
    text-transform: uppercase;
    font-size: clamp(3.6rem, 15.5vw, 13.5rem);
    line-height: 0.84;
    letter-spacing: -0.01em;
  }
  .hero__title .line {
    display: block;
    padding-bottom: 0.04em;
    animation: rise 0.9s cubic-bezier(0.2, 0.7, 0.1, 1) both;
    animation-delay: calc(var(--d) * 110ms + 80ms);
  }
  .hero__title em {
    font-style: normal;
    color: var(--accent);
  }
  .swap {
    display: inline-block;
  }
  @keyframes rise {
    from { transform: translateY(40%); opacity: 0; clip-path: inset(0 0 100% 0); }
    /* Découpe finale plus large que la ligne : les lettres peuvent sauter au survol sans être rognées. */
    to { transform: none; opacity: 1; clip-path: inset(-30% -5% -30% -5%); }
  }

  @keyframes fade {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: none; }
  }
  /* ---------- Blocs ---------- */
  .block {
    position: relative;
    padding-top: clamp(3rem, 7vw, 6rem);
    padding-bottom: clamp(3rem, 7vw, 6rem);
  }
  /* Trait de séparation : se dessine de gauche à droite quand la section arrive. */
  .block::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--line);
    transform-origin: left;
  }
  :global(.js-reveal) .block::before {
    scale: 0 1;
    transition: scale 1.2s cubic-bezier(0.6, 0, 0.2, 1);
  }
  :global(.js-reveal) .block.is-in::before {
    scale: 1 1;
  }
  .block__head {
    display: grid;
    grid-template-columns: 4rem 1fr minmax(0, 22rem);
    align-items: baseline;
    gap: 1rem;
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
  }
  .block__num {
    color: var(--accent);
    font-size: 0.85rem;
  }
  .block__head h2 {
    margin: 0;
    font-family: var(--f-display);
    font-weight: 900;
    text-transform: uppercase;
    font-size: clamp(2.6rem, 7vw, 5.5rem);
    line-height: 0.9;
  }
  .block__aside {
    margin: 0;
    color: var(--ink-soft);
  }
  .block__head h2 > span {
    display: block;
  }
  /* Titres de section : même montée que le grand titre, numéro et aparté en fondu juste après. */
  :global(.js-reveal) .title-reveal h2 > span,
  :global(.js-reveal) .title-reveal .block__num,
  :global(.js-reveal) .title-reveal .block__aside {
    opacity: 0;
  }
  :global(.js-reveal) .title-reveal.is-in h2 > span {
    animation: rise-titre 0.9s cubic-bezier(0.2, 0.7, 0.1, 1) both;
  }
  /* Comme « rise », mais la découpe déborde de la ligne : sinon l'accent de « MÉTHODE » est rogné. */
  @keyframes rise-titre {
    from { transform: translateY(40%); opacity: 0; clip-path: inset(-40% -5% 100% -5%); }
    to { transform: none; opacity: 1; clip-path: inset(-40% -5% -20% -5%); }
  }
  :global(.js-reveal) .title-reveal.is-in .block__num,
  :global(.js-reveal) .title-reveal.is-in .block__aside {
    animation: fade 0.7s 0.25s both;
  }
  @media (max-width: 760px) {
    .block__head {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
  }

  /* ---------- Services ---------- */
  /* Les traits sont les interstices de 1 px de la grille : aucune carte ne peut les recouvrir. */
  .grid-services {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    border: 1px solid var(--line);
    background: var(--line);
  }
  .card {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    padding: 1.5rem 1.25rem 1.75rem;
    min-height: 22rem;
    background: var(--paper);
    transition: color 0.35s;
  }
  /* Remplissage violet : un cercle qui grandit depuis le point d'entrée du curseur. */
  .card::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: 0;
    background: var(--accent);
    clip-path: circle(0% at var(--px, 50%) var(--py, 100%));
    transition: clip-path 0.55s cubic-bezier(0.2, 0.7, 0.1, 1);
  }
  .card:hover {
    color: var(--accent-ink);
  }
  .card:hover::before {
    clip-path: circle(150% at var(--px, 50%) var(--py, 100%));
  }
  .card__ref {
    font-size: 0.85rem;
  }
  /* Picto en trait fin, retracé au survol. */
  .card__picto {
    position: absolute;
    top: 1.25rem;
    right: 1.25rem;
    width: 3.25rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0.45;
    transition:
      opacity 0.35s,
      scale 0.5s cubic-bezier(0.2, 0.7, 0.1, 1);
  }
  .card__picto :global(*) {
    stroke-dasharray: 1;
  }
  .card__picto {
    transform-origin: top right;
  }
  .card:hover .card__picto {
    opacity: 1;
    scale: 1.6;
  }
  .card:hover .card__picto :global(*) {
    animation: tracer 0.9s cubic-bezier(0.6, 0, 0.2, 1) both;
  }
  .card:hover .card__picto :global(:nth-child(2)) {
    animation-delay: 0.15s;
  }
  .card:hover .card__picto :global(:nth-child(3)) {
    animation-delay: 0.3s;
  }
  @keyframes tracer {
    from { stroke-dashoffset: 1; }
    to { stroke-dashoffset: 0; }
  }
  .card__pts li {
    transition: translate 0.35s cubic-bezier(0.2, 0.7, 0.1, 1);
  }
  .card:hover .card__pts li {
    translate: 0.4rem 0;
    transition-delay: calc(var(--k) * 60ms);
  }
  .card h3 {
    margin: auto 0 0.6rem;
    padding-top: 3rem;
    font-family: var(--f-display);
    font-weight: 700;
    text-transform: uppercase;
    font-size: 2.1rem;
    line-height: 0.95;
  }
  .card p {
    margin: 0 0 1.25rem;
  }
  .card__pts {
    list-style: none;
    margin: 0;
    padding: 1rem 0 0;
    border-top: 1px solid currentColor;
    display: grid;
    gap: 0.3rem;
    font-size: 0.7rem;
  }
  .card__pts li::before {
    content: '+ ';
  }
  @media (max-width: 1080px) {
    .grid-services {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 560px) {
    .grid-services {
      grid-template-columns: 1fr;
    }
    .card {
      min-height: 0;
    }
    .card h3 {
      padding-top: 1.5rem;
    }
  }

  /* ---------- Méthode ---------- */
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(1rem, 2.5vw, 2rem);
    counter-reset: step;
  }
  .step {
    position: relative;
    isolation: isolate;
    padding-top: 1.25rem;
    border-top: 3px solid var(--ink);
    transition: filter 0.4s;
  }
  /* Trait violet par-dessus : chaque étape prend son quart de la progression (--p de 0 à 1, posé par le script). */
  .step::before {
    content: '';
    position: absolute;
    top: -3px;
    left: 0;
    right: 0;
    height: 3px;
    background: var(--accent);
    transform-origin: left;
    scale: clamp(0, calc(var(--p, 0.25) * 4 - var(--i, 0)), 1) 1;
  }
  .step__n {
    display: block;
    position: relative;
    width: fit-content;
    transform-origin: center;
    transition: scale 0.5s cubic-bezier(0.3, 1.5, 0.5, 1);
    font-family: var(--f-display);
    font-weight: 900;
    font-size: clamp(4rem, 8vw, 6.5rem);
    line-height: 0.8;
    color: transparent;
    -webkit-text-stroke: 1.5px var(--ink);
    /* Remplissage de bas en haut à l'apparition : un dégradé net glisse dans le texte. */
    background: linear-gradient(to top, var(--ink) 50%, transparent 50%) top / 100% 200% no-repeat;
    -webkit-background-clip: text;
    background-clip: text;
  }
  :global(.js-reveal) .step.is-in .step__n {
    animation: remplir 0.9s cubic-bezier(0.6, 0, 0.2, 1) both;
    animation-delay: calc(var(--i, 0) * 120ms + 350ms);
  }
  .step:first-child .step__n {
    background-image: linear-gradient(to top, var(--accent) 50%, transparent 50%);
    -webkit-text-stroke-color: var(--accent);
  }
  @keyframes remplir {
    to { background-position: bottom; }
  }
  /* Bulle violette qui gonfle derrière le chiffre survolé ; hors du chiffre, sinon son « scale » la ferait passer devant. */
  .step__tete {
    position: relative;
    display: block;
    width: fit-content;
  }
  .step__bulle {
    position: absolute;
    z-index: -1;
    left: 50%;
    top: 50%;
    width: clamp(5.5rem, 10vw, 8.5rem);
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--accent);
    translate: -50% -50%;
    scale: 0;
    transition: scale 0.5s cubic-bezier(0.3, 1.5, 0.5, 1);
  }
  .step h3 {
    margin: 2.25rem 0 0.4rem;
    font-size: 1.1rem;
    font-weight: 600;
  }
  .step p {
    margin: 0;
    /* Trois lignes réservées : la section ne saute pas quand les colonnes changent de largeur au survol. */
    min-height: 4.8em;
    color: var(--ink-soft);
  }
  /* ---------- Méthode : survol (vraie souris, data-actif posé par le script) ---------- */
  #methode {
    isolation: isolate;
  }
  .steps {
    transition: grid-template-columns 0.6s cubic-bezier(0.2, 0.7, 0.1, 1);
  }
  @media (min-width: 901px) {
    #methode[data-actif='0'] .steps { grid-template-columns: 1.8fr 1fr 1fr 1fr; }
    #methode[data-actif='1'] .steps { grid-template-columns: 1fr 1.8fr 1fr 1fr; }
    #methode[data-actif='2'] .steps { grid-template-columns: 1fr 1fr 1.8fr 1fr; }
    #methode[data-actif='3'] .steps { grid-template-columns: 1fr 1fr 1fr 1.8fr; }
  }
  /* filter et non opacity : l'animation d'apparition (fill both) garde la main sur opacity. */
  #methode[data-actif] .step {
    filter: opacity(0.35);
  }
  #methode[data-actif='0'] .step:nth-child(1),
  #methode[data-actif='1'] .step:nth-child(2),
  #methode[data-actif='2'] .step:nth-child(3),
  #methode[data-actif='3'] .step:nth-child(4) {
    filter: none;
  }
  /* Chiffre survolé : grossit, bulle violette derrière, chiffre en couleur d'encre d'accent. */
  .step:hover .step__n {
    scale: 1.2;
  }
  .step:hover .step__n {
    background: none;
    color: var(--accent-ink);
    -webkit-text-stroke-color: transparent;
  }
  .step:hover .step__bulle {
    scale: 1;
  }

  /* Calque pleine largeur derrière la section ; une scène par étape. */
  .methode__fond {
    position: absolute;
    z-index: -1;
    inset: 0 auto 0 50%;
    width: 100vw;
    translate: -50% 0;
    overflow: hidden;
    pointer-events: none;
    mask-image: linear-gradient(transparent, #000 12%, #000 88%, transparent);
  }
  .fond {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.5s;
  }
  .fond i,
  .fond span {
    position: absolute;
    display: block;
  }
  #methode[data-actif='0'] .fond-0,
  #methode[data-actif='1'] .fond-1,
  #methode[data-actif='2'] .fond-2,
  #methode[data-actif='3'] .fond-3 {
    opacity: 1;
  }

  /* Apparition commune des éléments des scènes : l'un après l'autre (--j), puis tout s'efface et ça recommence. */
  @keyframes scene-in {
    0% { opacity: 0; translate: 0 1rem; scale: 0.96; }
    6%, 90% { opacity: 1; translate: none; scale: 1; }
    100% { opacity: 0; translate: none; scale: 1; }
  }
  .fond .chat span,
  .fond .devis > *,
  .fond .deploi > * {
    position: static;
    opacity: 0;
  }
  #methode[data-actif='0'] .chat span,
  #methode[data-actif='1'] .devis > *,
  #methode[data-actif='3'] .deploi > * {
    animation: scene-in 7s cubic-bezier(0.2, 0.7, 0.1, 1) infinite both;
    animation-delay: calc(var(--j, 0) * 0.9s);
  }

  /* 1. Appel : l'échange qui sert à comprendre le besoin, à droite (l'étape est à gauche). */
  .chat {
    position: absolute;
    right: 6vw;
    top: 8%;
    width: min(38vw, 32rem);
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    font-size: clamp(0.95rem, 1.35vw, 1.25rem);
  }
  .chat span {
    max-width: 80%;
    padding: 0.7em 1.1em;
    border-radius: 1.2em;
  }
  .chat .client {
    align-self: flex-start;
    border-bottom-left-radius: 0.3em;
    border: 1.5px solid color-mix(in srgb, var(--ink) 12%, transparent);
    color: color-mix(in srgb, var(--ink) 28%, transparent);
  }
  .chat .moi {
    align-self: flex-end;
    border-bottom-right-radius: 0.3em;
    background: color-mix(in srgb, var(--accent) 13%, transparent);
    color: color-mix(in srgb, var(--ink) 34%, transparent);
  }

  /* 2. Devis : la feuille se remplit ligne par ligne, puis le tampon tombe. */
  .devis {
    position: absolute;
    right: 8vw;
    top: 8%;
    width: min(32vw, 26rem);
    padding: 1.5rem 1.75rem 2rem;
    border: 1.5px solid color-mix(in srgb, var(--ink) 15%, transparent);
    border-radius: 6px;
    display: grid;
    gap: 0.9rem;
    font-size: clamp(0.95rem, 1.4vw, 1.25rem);
    color: color-mix(in srgb, var(--ink) 40%, transparent);
  }
  .devis b {
    font-family: var(--f-display);
    font-size: 2.2em;
    text-transform: uppercase;
    line-height: 1;
    color: color-mix(in srgb, var(--ink) 25%, transparent);
  }
  .devis span {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px dashed color-mix(in srgb, var(--ink) 15%, transparent);
  }
  .devis em {
    font-style: normal;
    color: color-mix(in srgb, var(--ink) 25%, transparent);
  }
  .fond .devis strong {
    position: absolute;
    right: -1.5rem;
    bottom: -1.5rem;
    padding: 0.2em 0.6em;
    border: 3px solid color-mix(in srgb, var(--accent) 70%, transparent);
    border-radius: 6px;
    font-family: var(--f-display);
    font-size: 2.4em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--accent) 70%, transparent);
    rotate: -12deg;
  }
  #methode[data-actif='1'] .devis strong {
    animation-name: tampon;
  }
  @keyframes tampon {
    0% { opacity: 0; scale: 2.2; }
    5%, 90% { opacity: 1; scale: 1; }
    100% { opacity: 0; scale: 1; }
  }

  /* 3. Développement : du code tapé lettre par lettre en grand. */
  .fond-2 span {
    left: 8vw;
    top: calc(8% + var(--j) * 14%);
    font-family: ui-monospace, 'Cascadia Code', Consolas, monospace;
    font-size: clamp(1rem, 2vw, 1.9rem);
    white-space: pre;
    color: color-mix(in srgb, var(--ink) 12%, transparent);
    clip-path: inset(0 100% 0 0);
  }
  .fond-2 span:nth-child(odd) {
    color: color-mix(in srgb, var(--accent) 32%, transparent);
  }
  #methode[data-actif='2'] .fond-2 span {
    animation: taper 6s infinite both;
    animation-timing-function: steps(var(--n));
    animation-delay: calc(var(--j) * 0.7s);
  }
  @keyframes taper {
    0% { clip-path: inset(0 100% 0 0); }
    18%, 85% { clip-path: inset(0 0 0 0); opacity: 1; }
    100% { clip-path: inset(0 0 0 0); opacity: 0; }
  }

  /* 4. Mise en ligne : la checklist de déploiement à gauche (l'étape est à droite), barre de progression, pastille « En ligne ». */
  .deploi {
    position: absolute;
    left: 40vw;
    right: 6vw;
    top: 10%;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem 1.6rem;
    font-family: ui-monospace, 'Cascadia Code', Consolas, monospace;
    font-size: clamp(0.95rem, 1.4vw, 1.3rem);
    color: color-mix(in srgb, var(--ink) 26%, transparent);
  }
  .deploi strong {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.35em 0.9em;
    border-radius: 999px;
    background: color-mix(in srgb, #3ddc84 14%, transparent);
    color: color-mix(in srgb, #3ddc84 75%, transparent);
    font-family: var(--f-body);
  }
  .deploi strong::before {
    content: '';
    width: 0.55em;
    aspect-ratio: 1;
    border-radius: 50%;
    background: #3ddc84;
    animation: onde 1.8s ease-out infinite;
  }
  .deploi__barre {
    left: 0;
    right: 0;
    bottom: 14%;
    height: 3px;
    background: var(--accent);
    transform-origin: left;
    scale: 0 1;
    opacity: 0.6;
  }
  #methode[data-actif='3'] .deploi__barre {
    animation: barre-deploi 7s cubic-bezier(0.5, 0, 0.3, 1) infinite both;
  }
  @keyframes barre-deploi {
    0% { scale: 0 1; opacity: 0.6; }
    50%, 90% { scale: 1 1; opacity: 0.6; }
    100% { scale: 1 1; opacity: 0; }
  }

  @media (max-width: 900px) {
    .steps {
      grid-template-columns: repeat(2, 1fr);
      row-gap: 2.5rem;
    }
  }
  @media (max-width: 480px) {
    .steps {
      grid-template-columns: 1fr;
    }
  }

  /* ---------- Projets ---------- */
  .projets {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .projet {
    position: relative;
    display: grid;
    grid-template-columns: 5rem 4rem 1fr 16rem;
    gap: 1.5rem;
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--line);
  }
  .projet h3 {
    margin: 0 0 0.3rem;
    font-family: var(--f-display);
    font-weight: 700;
    text-transform: uppercase;
    font-size: 2rem;
    line-height: 1;
  }
  .projet h3 a {
    text-decoration: none;
    transition: color 0.2s;
  }
  /* Toute la ligne est cliquable (lien étiré) ; les petits liens restent au-dessus. */
  .projet h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  #projets {
    position: relative;
    isolation: isolate;
  }
  /* Pleine largeur d'écran, derrière tout le contenu de la section ; voile pour garder le texte lisible. */
  .projets__fond {
    position: absolute;
    z-index: -1;
    top: 0;
    left: 50%;
    width: 100vw;
    height: 100%;
    translate: -50% 0;
    /* Voile léger au milieu, plus dense en haut (titre, chiffres) et fondu dans la page en bas. */
    background:
      linear-gradient(
        color-mix(in srgb, var(--paper) 88%, transparent),
        color-mix(in srgb, var(--paper) 45%, transparent) 35%,
        color-mix(in srgb, var(--paper) 45%, transparent) 75%,
        var(--paper)
      ),
      var(--fond, none) center top / cover no-repeat;
    opacity: 0;
    transition: opacity 0.6s ease;
    pointer-events: none;
  }
  .projets__fond.is-on {
    opacity: 1;
  }
  /* Capture en fond : le titre et les chiffres s'effacent pour la laisser voir. */
  #projets > .block__head,
  #projets > .chiffres {
    transition: opacity 0.5s;
  }
  #projets.a-fond > .block__head,
  #projets.a-fond > .chiffres {
    opacity: 0.15;
  }
  .projet:hover h3 a {
    color: var(--accent);
  }
  /* Au survol, les autres projets s'effacent pour laisser voir la capture ; la ligne survolée garde un fond lisible. */
  .projet {
    transition:
      filter 0.4s,
      background 0.4s;
  }
  @media (hover: hover) {
    /* filter et non opacity : l'animation d'apparition (fill both) garde la main sur opacity, le logo restait opaque. */
    .projets:hover .projet:not(:hover) {
      filter: opacity(0.15);
    }
    .projets .projet:hover {
      background: color-mix(in srgb, var(--paper) 72%, transparent);
      backdrop-filter: blur(6px);
    }
  }
  .projet:hover h3 :global(.arrow-out) {
    transform: translate(2px, -2px);
  }
  .projet p {
    margin: 0;
    color: var(--ink-soft);
  }
  .projet__liens {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin-top: 0.75rem !important;
  }
  .projet__liens a {
    position: relative;
    z-index: 2;
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid currentColor;
  }
  .projet__liens a:hover {
    color: var(--ink);
  }
  .projet__logo {
    display: block;
    width: 4rem;
    height: 4rem;
    border-radius: 22%;
    object-fit: cover;
    transition: transform 0.35s cubic-bezier(0.2, 0.7, 0.1, 1);
  }
  .projet:hover .projet__logo {
    transform: rotate(-6deg) scale(1.06);
  }
  .projet__an {
    color: var(--accent);
  }
  .projet__side {
    display: grid;
    gap: 0.3rem;
    align-content: start;
    text-align: right;
  }
  .projet__stack {
    color: var(--ink-soft);
    text-transform: none;
  }
  @media (max-width: 760px) {
    /* Mobile : logo à gauche du contenu, année et fiche technique sur toute la largeur. */
    .projet {
      grid-template-columns: 3rem 1fr;
      gap: 0.5rem 1rem;
    }
    .projet__an,
    .projet__side {
      grid-column: 1 / -1;
    }
    .projet__logo {
      width: 3rem;
      height: 3rem;
    }
    .projet__side {
      text-align: left;
    }
  }

  /* ---------- Contact ---------- */
  .contact {
    /* Fond inversé : on prend la teinte d'accent prévue pour l'autre thème, sinon le contraste s'effondre. */
    --accent: var(--accent-inv);
    padding: clamp(3rem, 7vw, 6rem) 0;
    background: var(--ink);
    color: var(--paper);
  }
  .contact .block__aside {
    color: color-mix(in srgb, var(--paper) 65%, transparent);
  }
  .contact__mail {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: end;
    gap: 0.5rem 2rem;
    padding: 1.5rem 0;
    border-top: 1px solid var(--paper);
    border-bottom: 1px solid var(--paper);
    text-decoration: none;
