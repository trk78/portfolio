  /* ---------- Oven ---------- */
  .four {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 3rem 4rem;
    align-items: center;
  }
  .four strong {
    display: block;
    font-size: clamp(6rem, 16vw, 14rem);
    font-weight: 900;
    line-height: 0.85;
    letter-spacing: -0.04em;
    background: linear-gradient(180deg, var(--creme), var(--flamme) 60%, var(--braise));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    font-variant-numeric: tabular-nums;
  }
  .four strong sup {
    font-size: 0.32em;
    vertical-align: top;
    margin-left: 0.1em;
  }
  .thermo {
    height: 6px;
    margin: 1.5rem 0;
    border-radius: 3px;
    background: rgba(246, 236, 217, 0.1);
    overflow: hidden;
  }
  .thermo i {
