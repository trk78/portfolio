---
// Demo "business website": homepage of a fictional Neapolitan pizzeria, opened from the Services section.
// Standalone page (own fonts and colors, not the portfolio layout). Pizzas are drawn in SVG at build time.
import '@fontsource-variable/fraunces/full.css';
import '@fontsource-variable/fraunces/full-italic.css';
import '@fontsource/instrument-sans/400.css';
import '@fontsource/instrument-sans/500.css';
import '@fontsource/instrument-sans/600.css';

// Seeded random: the same pizza is drawn identically at every build.
const alea = (graine: number) => () => {
  graine = (graine + 0x6d2b79f5) | 0;
  let t = Math.imul(graine ^ (graine >>> 15), 1 | graine);
  t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
  return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
};
const f = (n: number) => n.toFixed(1);

// Irregular closed shape: points around a circle, smoothed through their midpoints.
const forme = (R: () => number, cx: number, cy: number, r: number, n: number, irr: number) => {
  const p = Array.from({ length: n }, (_, k) => {
    const a = (k / n) * Math.PI * 2;
    const rr = r * (1 + (R() - 0.5) * 2 * irr);
    return [cx + Math.cos(a) * rr, cy + Math.sin(a) * rr];
  });
  const mil = (a: number[], b: number[]) => [(a[0] + b[0]) / 2, (a[1] + b[1]) / 2];
  let d = `M${mil(p[n - 1], p[0]).map(f).join(' ')}`;
  for (let k = 0; k < n; k++) d += `Q${p[k].map(f).join(' ')} ${mil(p[k], p[(k + 1) % n]).map(f).join(' ')}`;
  return d + 'Z';
};
// Random point in a disc of radius rmax around the center.
const point = (R: () => number, rmax: number) => {
  const a = R() * Math.PI * 2;
  const d = rmax * Math.sqrt(R());
  return [100 + Math.cos(a) * d, 100 + Math.sin(a) * d];
};

type Garniture = 'mozza' | 'basilic' | 'salame' | 'piment' | 'fromages' | 'champignons' | 'truffe' | 'legumes' | 'olives' | 'burrata' | 'roquette' | 'tomates';

function pizza(id: string, graine: number, base: 'rossa' | 'bianca', garnitures: Garniture[]) {
  const R = alea(graine);
  const g = (x: Garniture) => garnitures.includes(x);
  let s = `<defs>
    <radialGradient id="${id}-c"><stop offset=".72" stop-color="#f3c886"/><stop offset=".9" stop-color="#d98a3f"/><stop offset="1" stop-color="#9c5220"/></radialGradient>
    <radialGradient id="${id}-s"><stop offset="0" stop-color="#e5482a"/><stop offset=".85" stop-color="#c22d18"/><stop offset="1" stop-color="#9e2111"/></radialGradient>
    <radialGradient id="${id}-b"><stop offset="0" stop-color="#fbf2de"/><stop offset="1" stop-color="#e6cc98"/></radialGradient>
    <radialGradient id="${id}-m" cx=".4" cy=".35"><stop offset="0" stop-color="#fffaf0"/><stop offset=".7" stop-color="#f6e6c2"/><stop offset="1" stop-color="#e2be7c"/></radialGradient>
    <radialGradient id="${id}-l" cx=".35" cy=".28"><stop offset="0" stop-color="#fff" stop-opacity=".22"/><stop offset=".6" stop-color="#fff" stop-opacity="0"/></radialGradient>
    <filter id="${id}-f"><feGaussianBlur stdDeviation="1.1"/></filter>
  </defs>
  <circle cx="102" cy="104" r="96" fill="#000" opacity=".45" filter="url(#${id}-f)"/>
  <path d="${forme(R, 100, 100, 95, 40, 0.03)}" fill="url(#${id}-c)"/>`;
  // Leopard spotting on the rim (charred bubbles from the wood fire).
  for (let k = 0; k < 26; k++) {
    const a = R() * Math.PI * 2;
    const d = 84 + R() * 9;
    s += `<circle cx="${f(100 + Math.cos(a) * d)}" cy="${f(100 + Math.sin(a) * d)}" r="${f(1.4 + R() * 3)}" fill="#3b1c0d" opacity="${f(0.45 + R() * 0.45)}" filter="url(#${id}-f)"/>`;
  }
  s += `<path d="${forme(R, 100, 100, 79, 48, 0.045)}" fill="url(#${id}-${base === 'rossa' ? 's' : 'b'})"/>`;
  if (base === 'rossa') {
    for (let k = 0; k < 14; k++) {
      const [x, y] = point(R, 70);
      s += `<circle cx="${f(x)}" cy="${f(y)}" r="${f(2 + R() * 5)}" fill="#8f1a0c" opacity=".35" filter="url(#${id}-f)"/>`;
    }
  }
  const fromage = (x: number, y: number, r: number, couleur = `url(#${id}-m)`) =>
    `<path d="${forme(R, x, y, r, 10, 0.28)}" fill="${couleur}"/>` +
    (R() > 0.4 ? `<circle cx="${f(x + (R() - 0.5) * r)}" cy="${f(y + (R() - 0.5) * r)}" r="${f(1.5 + R() * 2.5)}" fill="#c98a3c" opacity=".55" filter="url(#${id}-f)"/>` : '');
  if (g('mozza')) for (let k = 0; k < 8; k++) { const [x, y] = point(R, 58); s += fromage(x, y, 10 + R() * 7); }
  if (g('fromages')) {
    const couleurs = [`url(#${id}-m)`, '#f2cf6e', '#efe6d2', '#e2b55a'];
    for (let k = 0; k < 16; k++) {
      const [x, y] = point(R, 62);
      s += fromage(x, y, 8 + R() * 6, couleurs[k % 4]);
      if (k % 4 === 2) for (let j = 0; j < 4; j++) s += `<circle cx="${f(x + (R() - 0.5) * 10)}" cy="${f(y + (R() - 0.5) * 10)}" r="1.1" fill="#5d72a3" opacity=".8"/>`;
    }
  }
  if (g('burrata')) s += fromage(100, 100, 27) + `<path d="${forme(R, 96, 95, 12, 8, 0.2)}" fill="#fffdf6" opacity=".9"/>`;
  if (g('salame')) {
    for (let k = 0; k < 10; k++) {
      const [x, y] = point(R, 62);
      s += `<g transform="translate(${f(x)} ${f(y)}) rotate(${f(R() * 360)})"><ellipse rx="9.5" ry="8.6" fill="#7e1a0f"/><ellipse rx="8" ry="7.2" fill="#a8281a"/>`;
      for (let j = 0; j < 5; j++) s += `<circle cx="${f((R() - 0.5) * 10)}" cy="${f((R() - 0.5) * 9)}" r="${f(0.7 + R())}" fill="#eaa18c"/>`;
      s += `</g>`;
    }
  }
  if (g('champignons')) {
    for (let k = 0; k < 9; k++) {
      const [x, y] = point(R, 60);
      s += `<g transform="translate(${f(x)} ${f(y)}) rotate(${f(R() * 360)})"><path d="M-8 0A8 7 0 0 1 8 0L3 0 3 6-3 6-3 0Z" fill="#d8b890" stroke="#8a6440" stroke-width="1.1"/></g>`;
    }
  }
  if (g('truffe')) {
    for (let k = 0; k < 8; k++) {
      const [x, y] = point(R, 55);
      s += `<path d="${forme(R, x, y, 4 + R() * 2, 7, 0.3)}" fill="#3a2a20" stroke="#6b5444" stroke-width=".6"/>`;
    }
  }
  if (g('legumes')) {
    for (let k = 0; k < 6; k++) {
      const [x, y] = point(R, 60);
      s += `<circle cx="${f(x)}" cy="${f(y)}" r="6.5" fill="#e4edbd" stroke="#3f7a25" stroke-width="2.2"/><circle cx="${f(x)}" cy="${f(y)}" r="2.5" fill="#cfdc94"/>`;
    }
    for (let k = 0; k < 7; k++) {
      const [x, y] = point(R, 62);
      const a = R() * 6.28;
      s += `<path d="M${f(x)} ${f(y)}q${f(Math.cos(a) * 8)} ${f(Math.sin(a) * 8 - 4)} ${f(Math.cos(a) * 16)} ${f(Math.sin(a) * 16)}" fill="none" stroke="${k % 2 ? '#e8382a' : '#f2b51d'}" stroke-width="3.4" stroke-linecap="round"/>`;
    }
  }
  if (g('olives')) for (let k = 0; k < 8; k++) { const [x, y] = point(R, 64); s += `<circle cx="${f(x)}" cy="${f(y)}" r="3.6" fill="none" stroke="#2a2220" stroke-width="2.4"/>`; }
  if (g('tomates')) {
    for (let k = 0; k < 6; k++) {
      const [x, y] = point(R, 60);
      s += `<circle cx="${f(x)}" cy="${f(y)}" r="6" fill="#d9291a"/><circle cx="${f(x - 1)}" cy="${f(y - 1)}" r="3.6" fill="#f0624a"/><circle cx="${f(x - 2)}" cy="${f(y - 2.4)}" r="1.2" fill="#fff" opacity=".5"/>`;
    }
  }
  if (g('roquette')) {
    for (let k = 0; k < 16; k++) {
      const [x, y] = point(R, 66);
      const a = R() * 360;
      s += `<path transform="translate(${f(x)} ${f(y)}) rotate(${f(a)})" d="M-9 0L9 0M-5 0l-2-3M-1 0l-2 3M3 0l-2-3M6 0l-2 3" stroke="#3f8a2b" stroke-width="2" stroke-linecap="round" fill="none"/>`;
    }
  }
  if (g('basilic')) {
    for (let k = 0; k < 5; k++) {
      const [x, y] = point(R, 50);
      s += `<g transform="translate(${f(x)} ${f(y)}) rotate(${f(R() * 360)}) scale(${f(0.9 + R() * 0.5)})"><path d="M0-10Q8-3 0 10Q-8-3 0-10Z" fill="#2c7a2e"/><path d="M0-8V8" stroke="#56a64d" stroke-width=".9"/></g>`;
    }
  }
  if (g('piment')) {
    for (let k = 0; k < 34; k++) {
      const [x, y] = point(R, 70);
      s += `<rect x="${f(x)}" y="${f(y)}" width="2.4" height="1.2" rx=".5" fill="#d8351a" transform="rotate(${f(R() * 360)} ${f(x)} ${f(y)})"/>`;
    }
  }
  return s + `<circle cx="100" cy="100" r="95" fill="url(#${id}-l)"/>`;
}

const carte = [
  { nom: 'Margherita', desc: 'San Marzano, fior di latte, basilic, huile d’olive', prix: 12, cat: 'rosse', base: 'rossa', g: ['mozza', 'basilic'], graine: 3 },
  { nom: 'Diavola', desc: 'Tomate, fior di latte, salame piquant, piment de Calabre', prix: 15, cat: 'piccanti', base: 'rossa', g: ['mozza', 'salame', 'piment'], graine: 7 },
  { nom: 'Quattro formaggi', desc: 'Fior di latte, gorgonzola, parmesan 24 mois, scamorza fumée', prix: 16, cat: 'bianche', base: 'bianca', g: ['fromages'], graine: 11 },
  { nom: 'Funghi e tartufo', desc: 'Crème de truffe, champignons, fior di latte', prix: 19, cat: 'bianche', base: 'bianca', g: ['mozza', 'champignons', 'truffe'], graine: 5 },
  { nom: 'Burrata', desc: 'Tomate, burrata entière, roquette, tomates cerises', prix: 17, cat: 'rosse', base: 'rossa', g: ['burrata', 'tomates', 'roquette'], graine: 17 },
  { nom: 'Ortolana', desc: 'Tomate, courgette, poivrons rôtis, olives taggiasche', prix: 14, cat: 'rosse', base: 'rossa', g: ['mozza', 'legumes', 'olives'], graine: 13 },
] as const;
const filtres = [['toutes', 'Toutes'], ['rosse', 'Rosse'], ['bianche', 'Bianche'], ['piccanti', 'Piccanti']];
const heroPizza = pizza('hero', 21, 'rossa', ['mozza', 'basilic']);
const citation = 'On ne cuit pas une pizza. On la saisit, quatre-vingt-dix secondes, dans un four à quatre cent quatre-vingt-cinq degrés.';
// Captions of the 3D assembly, one per scroll stage (same thresholds as src/scripts/pizza3d.ts).
const etapes3d = [
  ['La pâte.', 'Maturée 48 heures, étirée à la main. Jamais au rouleau.'],
  ['San Marzano.', 'Une louche, étalée en spirale du centre vers le bord.'],
  ['Fior di latte.', 'Déchirée à la main, juste avant d’enfourner.'],
  ['Basilic frais.', 'Cueilli le matin même, posé à la dernière seconde.'],
  ['485 °C.', 'Quatre-vingt-dix secondes. La croûte se tigre, le fromage file.'],
  ['Margherita.', 'Telle qu’à Naples depuis 1889. Rien à ajouter.'],
];
const creneaux = [['19:00', true], ['19:30', true], ['20:00', false], ['20:30', true], ['21:00', true], ['21:30', false]] as const;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Fuoco — Pizzeria napolitaine (démo)</title>
    <meta name="robots" content="noindex" />
    <meta name="description" content="Page d’accueil d’une pizzeria fictive : démo de site vitrine réalisée par Timéo." />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Ccircle cx='16' cy='16' r='15' fill='%23e8471f'/%3E%3C/svg%3E" />
  </head>
  <body>
    <header class="nav">
      <a class="logo" href="#haut">Fuoco<sup>®</sup></a>
      <nav>
        <a href="#carte">La carte</a>
        <a href="#four">Le four</a>
        <a href="#reserver" class="nav__cta">Réserver</a>
      </nav>
    </header>

    <main id="haut">
      <section class="hero">
        <canvas class="braises" aria-hidden="true"></canvas>
        <div class="hero__texte">
          <p class="sur">Pizzeria napolitaine · Versailles</p>
          <h1 aria-label="Fuoco">
            {[...'Fuoco'].map((c, k) => <span style={`--k: ${k}`} aria-hidden="true">{c}</span>)}
          </h1>
          <p class="hero__accroche">Pâte maturée 48 heures. Cuite <em>90 secondes</em> au feu de bois, à 485 °C. Rien d’autre.</p>
          <div class="hero__boutons">
            <a class="bouton" href="#reserver">Réserver une table</a>
            <a class="bouton bouton--ligne" href="#carte">Voir la carte</a>
          </div>
        </div>
        <div class="hero__four" aria-hidden="true">
          <div class="voute">
            <div class="flammes"><i></i><i></i><i></i><i></i></div>
          </div>
          <div class="pelle">
            <svg class="hero__pizza" viewBox="0 0 200 200" set:html={heroPizza} />
          </div>
        </div>
        <a class="descendre" href="#carte" aria-label="Voir la carte"><span></span></a>
      </section>

      <section class="assemblage" aria-label="Comment naît une Margherita">
        <div class="assemblage__colle">
          <canvas class="assemblage__scene" aria-hidden="true"></canvas>
          <ol class="legendes">
            {etapes3d.map(([t, d], i) => (
              <li data-i={i}>
                <p class="sur">0{i + 1} / 0{etapes3d.length}</p>
                <h2>{t}</h2>
                <p>{d}</p>
              </li>
            ))}
          </ol>
          <div class="assemblage__barre" aria-hidden="true"><i></i></div>
        </div>
      </section>

      <section id="carte" class="carte">
        <div class="titre r">
          <p class="sur">La carte</p>
          <h2>Six pizzas.<br /><em>Aucun compromis.</em></h2>
        </div>
        <div class="filtres r" role="group" aria-label="Filtrer la carte">
          {filtres.map(([v, l], i) => <button type="button" data-filtre={v} aria-pressed={i === 0 ? 'true' : 'false'}>{l}</button>)}
        </div>
        <ul class="pizzas">
          {carte.map((p, i) => (
            <li class="pizza r" data-cat={p.cat} style={`--i: ${i}; view-transition-name: pizza-${i}`}>
              <svg viewBox="0 0 200 200" aria-hidden="true" set:html={pizza(`p${i}`, p.graine, p.base, [...p.g])} />
              <div class="pizza__ligne">
                <h3>{p.nom}</h3>
                <span class="points" aria-hidden="true"></span>
                <span class="prix">{p.prix} €</span>
              </div>
              <p>{p.desc}</p>
              {p.cat === 'piccanti' && <span class="piquant">Piquant</span>}
            </li>
          ))}
        </ul>
      </section>

      <section class="citation" aria-label={citation}>
        <p aria-hidden="true">{citation.split(' ').map((m, k) => <span style={`--k: ${k}`}>{m} </span>)}</p>
      </section>

      <section id="four" class="four">
        <div class="four__degres r">
          <p class="sur">Le four</p>
          <strong><span class="compte" data-fin="485">485</span><sup>°C</sup></strong>
          <div class="thermo"><i></i></div>
          <p>Un four en briques réfractaires, chauffé au chêne depuis 16 h. À cette température, la pâte gonfle en quelques secondes et la croûte se tigre.</p>
        </div>
        <div class="four__minuteur r" aria-label="Temps de cuisson : 90 secondes">
          <svg viewBox="0 0 120 120" aria-hidden="true">
            <circle cx="60" cy="60" r="52" class="anneau-fond" />
            <circle cx="60" cy="60" r="52" class="anneau" pathLength="1" />
          </svg>
          <span><b>90</b> secondes</span>
        </div>
        <ul class="faits">
          <li class="r" style="--i: 0"><b>48 h</b>de maturation de la pâte</li>
          <li class="r" style="--i: 1"><b>00</b>farine italienne, rien d’autre</li>
          <li class="r" style="--i: 2"><b>DOP</b>tomates San Marzano</li>
          <li class="r" style="--i: 3"><b>0</b>congélateur dans la cuisine</li>
        </ul>
      </section>

      <section id="reserver" class="resa">
        <div class="titre r">
          <p class="sur">Réserver</p>
          <h2>Une table,<br /><em>ce soir ?</em></h2>
        </div>
        <form class="resa__carte r" novalidate>
          <fieldset>
            <legend>Jour</legend>
            <div class="jours"></div>
          </fieldset>
          <fieldset>
            <legend>Couverts</legend>
            <div class="couverts">
              <button type="button" data-pas="-1" aria-label="Une personne de moins">−</button>
              <output>2</output>
              <button type="button" data-pas="1" aria-label="Une personne de plus">+</button>
            </div>
          </fieldset>
          <fieldset>
            <legend>Heure</legend>
            <div class="creneaux">
              {creneaux.map(([h, libre]) => <button type="button" data-heure={h} disabled={!libre} aria-pressed="false">{h}{!libre && <small>complet</small>}</button>)}
            </div>
          </fieldset>
          <button class="bouton resa__ok" type="submit">Réserver</button>
          <p class="resa__note">Démo : aucune réservation n’est envoyée.</p>
          <div class="ticket" aria-live="polite">
            <p class="sur">Prenotazione</p>
            <p class="ticket__resume"></p>
            <span class="tampon">Confermato</span>
          </div>
        </form>
      </section>
    </main>

    <footer class="pied">
      <div class="pied__infos">
        <p><b>Fuoco</b><br />8 rue des Braises<br />78000 Versailles</p>
        <p><b>Ouvert</b><br />Mardi – dimanche<br />18 h 30 – 23 h</p>
        <p><b>Contact</b><br />01 00 00 00 00<br />ciao@fuoco.example</p>
      </div>
      <p class="pied__nom" aria-hidden="true">Fuoco</p>
    </footer>

    <a class="badge" href="https://jeannin.dev/" target="_top">Démo · pizzeria fictive · site réalisé par Timéo ↗</a>
  </body>
</html>

<script>
  const animer = !matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Reveal on scroll.
  const io = new IntersectionObserver(
    (entrees) => entrees.forEach((e) => e.isIntersecting && (e.target.classList.add('vu'), io.unobserve(e.target))),
    { rootMargin: '0px 0px -12% 0px' },
  );
  document.querySelectorAll('.r').forEach((el) => io.observe(el));

  // Embers rising from the bottom of the hero.
  const toile = document.querySelector<HTMLCanvasElement>('.braises')!;
  const ctx = toile.getContext('2d')!;
  let w = 0, h = 0, visible = true;
  const taille = () => {
    const dpr = Math.min(devicePixelRatio, 2);
    w = toile.clientWidth;
    h = toile.clientHeight;
    toile.width = w * dpr;
    toile.height = h * dpr;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  };
  taille();
  addEventListener('resize', taille);
  const neuve = () => ({ x: Math.random() * w, y: h + Math.random() * 40, v: 0.5 + Math.random() * 1.8, r: 0.6 + Math.random() * 2.2, p: Math.random() * 6.28, t: 20 + Math.random() * 25, vie: 0 });
  const braises = Array.from({ length: 110 }, () => ({ ...neuve(), y: Math.random() * h }));
  const tour = () => {
    ctx.clearRect(0, 0, w, h);
    ctx.globalCompositeOperation = 'lighter';
    for (const b of braises) {
      b.vie++;
      b.y -= b.v;
      b.x += Math.sin(b.p + b.vie / b.t) * 0.6;
      if (b.y < -10) Object.assign(b, neuve());
      const a = Math.min(1, b.y / h + 0.15) * (0.6 + Math.sin(b.vie / 4 + b.p) * 0.4);
      ctx.fillStyle = `hsla(${22 + b.r * 9}, 100%, ${55 + b.r * 6}%, ${a})`;
      ctx.beginPath();
      ctx.arc(b.x, b.y, b.r, 0, 6.28);
      ctx.fill();
      ctx.fillStyle = `hsla(30, 100%, 60%, ${a * 0.18})`;
      ctx.beginPath();
      ctx.arc(b.x, b.y, b.r * 4, 0, 6.28);
      ctx.fill();
    }
    if (visible && animer) requestAnimationFrame(tour);
  };
  new IntersectionObserver(([e]) => {
    const avant = visible;
    visible = e.isIntersecting;
    if (visible && !avant) requestAnimationFrame(tour);
  }).observe(toile);
  requestAnimationFrame(tour);

  // 3D assembly: Three.js is only downloaded when the section gets close; hidden if WebGL is unavailable.
  const assemblage = document.querySelector<HTMLElement>('.assemblage')!;
  new IntersectionObserver(async ([e], obs) => {
    if (!e.isIntersecting) return;
    obs.disconnect();
    try {
      const { demarrer } = await import('../../scripts/pizza3d');
      demarrer(assemblage, assemblage.querySelector('canvas')!);
    } catch {
      assemblage.hidden = true;
    }
  }, { rootMargin: '100% 0px' }).observe(assemblage);

  // Menu filter: cards rearrange with a view transition where supported.
  const boutons = document.querySelectorAll<HTMLButtonElement>('[data-filtre]');
  boutons.forEach((b) =>
    b.addEventListener('click', () => {
      const appliquer = () => {
        boutons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        document.querySelectorAll<HTMLElement>('.pizza').forEach((p) => (p.hidden = b.dataset.filtre !== 'toutes' && p.dataset.cat !== b.dataset.filtre));
      };
      if (animer && document.startViewTransition) document.startViewTransition(appliquer);
      else appliquer();
    }),
  );

  // Quote: words light up as the section scrolls by.
  const mots = document.querySelectorAll<HTMLElement>('.citation span');
  const citation = document.querySelector<HTMLElement>('.citation')!;
  const eclairer = () => {
    const r = citation.getBoundingClientRect();
    const p = (innerHeight * 0.85 - r.top) / (r.height + innerHeight * 0.35);
    const n = Math.round(Math.min(Math.max(p, 0), 1) * mots.length);
    mots.forEach((m, k) => m.classList.toggle('allume', k < n));
  };
  if (animer) {
    eclairer();
    addEventListener('scroll', eclairer, { passive: true });
  } else mots.forEach((m) => m.classList.add('allume'));

  // Oven: the temperature climbs when the section appears.
  const compte = document.querySelector<HTMLElement>('.compte')!;
  if (animer) {
    compte.textContent = '0';
    new IntersectionObserver(([e], obs) => {
      if (!e.isIntersecting) return;
      obs.disconnect();
      const debut = performance.now();
      const pas = (t: number) => {
        const k = Math.min((t - debut) / 1800, 1);
        compte.textContent = String(Math.round(485 * (1 - (1 - k) ** 3)));
        if (k < 1) requestAnimationFrame(pas);
      };
      requestAnimationFrame(pas);
    }, { threshold: 0.6 }).observe(compte);
  }

  // Booking (demo, nothing is sent): next 7 days, closed on Mondays.
  const jours = document.querySelector('.jours')!;
  const noms = ['dim.', 'lun.', 'mar.', 'mer.', 'jeu.', 'ven.', 'sam.'];
  const choix = { jour: '', heure: '', couverts: 2 };
  for (let i = 0; i < 7; i++) {
    const d = new Date();
    d.setDate(d.getDate() + i);
    const libelle = i === 0 ? 'Ce soir' : i === 1 ? 'Demain' : `${noms[d.getDay()]} ${d.getDate()}`;
    const b = Object.assign(document.createElement('button'), { type: 'button', textContent: libelle, disabled: d.getDay() === 1 });
    if (b.disabled) b.append(Object.assign(document.createElement('small'), { textContent: 'fermé' }));
    b.setAttribute('aria-pressed', 'false');
    b.dataset.jour = libelle;
    jours.append(b);
  }
  const unique = (groupe: Element, cible: HTMLButtonElement) => groupe.querySelectorAll('button').forEach((x) => x.setAttribute('aria-pressed', String(x === cible)));
  jours.addEventListener('click', (e) => {
    const b = (e.target as Element).closest<HTMLButtonElement>('button[data-jour]');
    if (b && !b.disabled) (unique(jours, b), (choix.jour = b.dataset.jour!));
  });
  const creneaux = document.querySelector('.creneaux')!;
  creneaux.addEventListener('click', (e) => {
    const b = (e.target as Element).closest<HTMLButtonElement>('button[data-heure]');
    if (b && !b.disabled) (unique(creneaux, b), (choix.heure = b.dataset.heure!));
  });
  const sortie = document.querySelector('.couverts output')!;
  document.querySelectorAll<HTMLButtonElement>('[data-pas]').forEach((b) =>
    b.addEventListener('click', () => {
      choix.couverts = Math.min(12, Math.max(1, choix.couverts + Number(b.dataset.pas)));
      sortie.textContent = String(choix.couverts);
    }),
  );
  const form = document.querySelector<HTMLFormElement>('.resa__carte')!;
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const manque = !choix.jour ? 'jours' : !choix.heure ? 'creneaux' : '';
    if (manque) {
      const g = document.querySelector(`.${manque}`)!;
      g.classList.remove('secoue');
      void (g as HTMLElement).offsetWidth;
      g.classList.add('secoue');
      return;
    }
    form.querySelector('.ticket__resume')!.textContent = `Table pour ${choix.couverts} · ${choix.jour} · ${choix.heure}`;
    form.classList.add('confirme');
  });
</script>

<style>
  :root {
    --nuit: #120b07;
    --charbon: #1d130d;
    --braise: #ff5a1f;
    --flamme: #ffb347;
