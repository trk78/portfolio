    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    rotate: 8deg;
  }
  ::view-transition-group(*) {
    animation-duration: 0.55s;
    animation-timing-function: var(--courbe);
  }

  /* ---------- Quote lit word by word ---------- */
  .citation {
    padding: clamp(4rem, 10vw, 8rem) clamp(1rem, 6vw, 6rem);
    background: linear-gradient(transparent, rgba(226, 58, 28, 0.08) 40%, transparent);
  }
  .citation p {
    max-width: 1100px;
    margin: 0 auto;
    font-size: clamp(2rem, 4.8vw, 4.2rem);
    font-weight: 600;
    font-style: italic;
    line-height: 1.12;
    letter-spacing: -0.01em;
  }
  .citation span {
    color: rgba(246, 236, 217, 0.14);
    transition:
      color 0.4s,
      text-shadow 0.6s;
  }
  .citation span.allume {
    color: var(--creme);
  }
  .citation span.allume:nth-child(n + 13) {
