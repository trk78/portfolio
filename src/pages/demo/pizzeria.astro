  }
  .filtres button:hover,
  .jours button:not(:disabled):hover,
  .creneaux button:not(:disabled):hover {
    border-color: var(--braise);
  }
  .filtres button[aria-pressed='true'],
  .jours button[aria-pressed='true'],
  .creneaux button[aria-pressed='true'] {
    background: var(--braise);
    border-color: var(--braise);
    color: var(--nuit);
  }
  .pizzas {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
    gap: clamp(2rem, 4vw, 3.5rem) clamp(1.5rem, 3vw, 2.5rem);
  }
  .pizza {
    position: relative;
  }
  .pizza[hidden] {
    display: none;
  }
  .pizza svg {
    display: block;
    width: 78%;
    margin: 0 auto 1.5rem;
    transition:
      rotate 1.2s var(--courbe),
      scale 0.8s var(--courbe),
      filter 0.6s;
    filter: drop-shadow(0 20px 30px rgba(0, 0, 0, 0.55));
  }
  /* Hover: the pizza turns a third and glows as if back in front of the fire. */
  .pizza:hover svg {
    rotate: 120deg;
    scale: 1.07;
    filter: drop-shadow(0 20px 30px rgba(0, 0, 0, 0.55)) drop-shadow(0 0 40px rgba(255, 90, 31, 0.45));
  }
  .pizza__ligne {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
  }
  .pizza h3 {
    margin: 0;
    font-size: 1.7rem;
    font-weight: 700;
    font-style: italic;
  }
  .points {
    flex: 1;
    border-bottom: 2px dotted rgba(246, 236, 217, 0.3);
    translate: 0 -0.3em;
  }
  .prix {
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--flamme);
  }
  .pizza p {
    margin: 0.4rem 0 0;
    color: var(--creme-2);
    font-size: 0.95rem;
  }
  .piquant {
    position: absolute;
    top: 0.5rem;
    right: 8%;
    padding: 0.35em 0.8em;
    border-radius: 999px;
