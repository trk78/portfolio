  }
  .r.vu {
    opacity: 1;
    transform: none;
  }

  /* ---------- Menu ---------- */
  .filtres {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 2.5rem 0 3rem;
  }
  .filtres button,
  .jours button,
  .creneaux button {
    padding: 0.6em 1.2em;
    border: 1.5px solid rgba(246, 236, 217, 0.22);
    border-radius: 999px;
    background: transparent;
    color: var(--creme);
    font: 500 0.92rem var(--f-texte);
    cursor: pointer;
    transition:
      background 0.25s,
      border-color 0.25s,
