  }
  @keyframes allume {
    from { filter: brightness(0.15) saturate(0.4); }
  }
  /* Oven vault: brick voussoirs around a glowing mouth. */
  .voute {
    position: relative;
    aspect-ratio: 1 / 0.86;
    padding: 26px 26px 0;
    border-radius: 50% 50% 0 0 / 62% 62% 0 0;
    background: repeating-conic-gradient(from -90deg at 50% 100%, #6b2a16 0 5.4deg, #2c1009 5.4deg 6deg);
    box-shadow: 0 0 140px rgba(255, 90, 31, 0.35);
  }
  .flammes {
    position: relative;
    height: 100%;
    overflow: hidden;
    border-radius: 50% 50% 0 0 / 62% 62% 0 0;
    background: radial-gradient(ellipse 80% 70% at 50% 100%, #ffd27a 0%, #ff7a1a 25%, #c32a0e 50%, #3a0d05 78%, #0d0503);
    box-shadow: inset 0 30px 60px rgba(0, 0, 0, 0.8);
  }
  .flammes i {
    position: absolute;
    bottom: -12%;
    width: 46%;
    aspect-ratio: 0.7;
    border-radius: 50% 50% 45% 45% / 65% 65% 35% 35%;
    background: radial-gradient(ellipse at 50% 80%, #fff1b8, #ffb347 30%, #ff5a1f 60%, transparent 72%);
    filter: blur(10px);
    mix-blend-mode: screen;
    transform-origin: 50% 100%;
    animation: flamme 1.4s ease-in-out infinite alternate;
  }
  .flammes i:nth-child(1) { left: 2%; animation-duration: 1.1s; }
  .flammes i:nth-child(2) { left: 26%; height: auto; width: 52%; animation-delay: -0.4s; }
  .flammes i:nth-child(3) { left: 54%; animation-duration: 1.7s; animation-delay: -0.9s; }
  .flammes i:nth-child(4) { left: 30%; width: 38%; opacity: 0.7; animation-duration: 0.9s; }
  @keyframes flamme {
    0% { transform: scale(1, 0.85) skewX(-4deg); opacity: 0.75; }
    50% { transform: scale(0.92, 1.12) skewX(5deg); opacity: 1; }
