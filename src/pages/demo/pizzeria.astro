---
// Demo "business website": homepage of a fictional Neapolitan pizzeria, opened from the Services section.
// Standalone page (own fonts and colors, not the portfolio layout). A 3D pizza (src/scripts/pizza3d.ts) sits
// behind the whole page and builds up section by section; menu thumbnails are drawn in SVG at build time.
import '@fontsource-variable/fraunces/full.css';
import '@fontsource-variable/fraunces/full-italic.css';
import '@fontsource/instrument-sans/400.css';
import '@fontsource/instrument-sans/500.css';
import '@fontsource/instrument-sans/600.css';

// Seeded random: the same pizza is drawn identically at every build.
const alea = (graine: number) => () => {
  graine = (graine + 0x6d2b79f5) | 0;
  let t = Math.imul(graine ^ (graine >>> 15), 1 | graine);
  t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
  return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
};
const f = (n: number) => n.toFixed(1);

// Irregular closed shape: points around a circle, smoothed through their midpoints.
const forme = (R: () => number, cx: number, cy: number, r: number, n: number, irr: number) => {
  const p = Array.from({ length: n }, (_, k) => {
    const a = (k / n) * Math.PI * 2;
    const rr = r * (1 + (R() - 0.5) * 2 * irr);
    return [cx + Math.cos(a) * rr, cy + Math.sin(a) * rr];
  });
  const mil = (a: number[], b: number[]) => [(a[0] + b[0]) / 2, (a[1] + b[1]) / 2];
  let d = `M${mil(p[n - 1], p[0]).map(f).join(' ')}`;
  for (let k = 0; k < n; k++) d += `Q${p[k].map(f).join(' ')} ${mil(p[k], p[(k + 1) % n]).map(f).join(' ')}`;
  return d + 'Z';
};
// Random point in a disc of radius rmax around the center.
const point = (R: () => number, rmax: number) => {
  const a = R() * Math.PI * 2;
  const d = rmax * Math.sqrt(R());
  return [100 + Math.cos(a) * d, 100 + Math.sin(a) * d];
};

type Garniture =
  | 'mozza' | 'basilic' | 'salame' | 'piment' | 'fromages' | 'champignons' | 'truffe' | 'legumes'
  | 'olives' | 'burrata' | 'roquette' | 'tomates' | 'parmesan' | 'huile' | 'origan';

// Menu pizza drawn in SVG: textured crust with leopard spotting, glossy sauce, toppings with soft shadows,
// and a light from the top left over everything for volume.
function pizza(id: string, graine: number, base: 'rossa' | 'bianca', garnitures: Garniture[]) {
  const R = alea(graine);
  const g = (x: Garniture) => garnitures.includes(x);
  const u = (n: string) => `url(#${id}-${n})`;
  let s = `<defs>
    <radialGradient id="${id}-c"><stop offset=".7" stop-color="#f2c47e"/><stop offset=".82" stop-color="#e3a458"/><stop offset=".93" stop-color="#c47632"/><stop offset="1" stop-color="#8a451a"/></radialGradient>
    <radialGradient id="${id}-r"><stop offset=".8" stop-color="#fff0d0" stop-opacity="0"/><stop offset=".87" stop-color="#fff0d0" stop-opacity=".45"/><stop offset=".95" stop-color="#fff0d0" stop-opacity="0"/></radialGradient>
    <radialGradient id="${id}-s"><stop offset="0" stop-color="#df4426"/><stop offset=".8" stop-color="#c22c15"/><stop offset="1" stop-color="#7f160a"/></radialGradient>
    <radialGradient id="${id}-b"><stop offset="0" stop-color="#fbf1dc"/><stop offset=".85" stop-color="#ecd5a6"/><stop offset="1" stop-color="#d4ae6c"/></radialGradient>
    <radialGradient id="${id}-m" cx=".38" cy=".32"><stop offset="0" stop-color="#fffdf6"/><stop offset=".55" stop-color="#f8edd4"/><stop offset="1" stop-color="#dfb878"/></radialGradient>
    <radialGradient id="${id}-sa" cx=".42" cy=".38"><stop offset="0" stop-color="#bb3423"/><stop offset=".75" stop-color="#931f12"/><stop offset="1" stop-color="#560c05"/></radialGradient>
    <linearGradient id="${id}-fe" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#4caa45"/><stop offset="1" stop-color="#1d5a1f"/></linearGradient>
    <radialGradient id="${id}-l" cx=".3" cy=".25" r=".85"><stop offset="0" stop-color="#fff" stop-opacity=".28"/><stop offset=".45" stop-color="#fff" stop-opacity="0"/><stop offset=".8" stop-color="#000" stop-opacity="0"/><stop offset="1" stop-color="#000" stop-opacity=".35"/></radialGradient>
    <filter id="${id}-f"><feGaussianBlur stdDeviation="1"/></filter>
    <filter id="${id}-o" x="-20%" y="-20%" width="140%" height="140%"><feDropShadow dx=".7" dy="1.3" stdDeviation=".9" flood-color="#2a0c03" flood-opacity=".6"/></filter>
    <filter id="${id}-t" x="0" y="0" width="100%" height="100%"><feTurbulence type="fractalNoise" baseFrequency=".9" numOctaves="3" seed="${graine}"/><feColorMatrix values="0 0 0 0 .25  0 0 0 0 .12  0 0 0 0 .04  0 0 0 -1.4 1"/><feComposite in2="SourceGraphic" operator="in"/></filter>
    <clipPath id="${id}-k"><circle cx="100" cy="100" r="95"/></clipPath>
  </defs>
  <ellipse cx="103" cy="106" rx="96" ry="95" fill="#000" opacity=".5" filter="${u('f')}"/>
  <path d="${forme(R, 100, 100, 95, 44, 0.025)}" fill="${u('c')}"/>
  <path d="${forme(R, 100, 100, 95, 44, 0.025)}" fill="${u('r')}"/>`;
  // Leopard spotting: charred bubbles in small clusters on the rim, with flour dust in between.
  for (let k = 0; k < 16; k++) {
    const a = R() * Math.PI * 2, d = 83 + R() * 9;
    for (let j = 0; j < 3; j++) {
      const x = 100 + Math.cos(a) * d + (R() - 0.5) * 6, y = 100 + Math.sin(a) * d + (R() - 0.5) * 6;
      s += `<circle cx="${f(x)}" cy="${f(y)}" r="${f(0.8 + R() * 2.4)}" fill="#2b1206" opacity="${f(0.5 + R() * 0.45)}"/>`;
    }
  }
  for (let k = 0; k < 40; k++) {
    const a = R() * Math.PI * 2, d = 82 + R() * 12;
    s += `<circle cx="${f(100 + Math.cos(a) * d)}" cy="${f(100 + Math.sin(a) * d)}" r="${f(0.4 + R() * 0.6)}" fill="#fff8ea" opacity=".55"/>`;
  }
  // Base: sauce or cream, with a darker edge and a noise texture.
  s += `<path d="${forme(R, 100, 100, 77, 52, 0.04)}" fill="${u(base === 'rossa' ? 's' : 'b')}"/>`;
  if (base === 'rossa') {
    for (let k = 0; k < 18; k++) {
      const [x, y] = point(R, 68);
      s += `<circle cx="${f(x)}" cy="${f(y)}" r="${f(2 + R() * 5)}" fill="${R() > 0.5 ? '#8a1709' : '#ec6440'}" opacity=".35" filter="${u('f')}"/>`;
    }
  }
  s += `<rect width="200" height="200" filter="${u('t')}" opacity=".35" clip-path="${u('k')}"/>`;
  // Toppings, each group with a soft shadow.
  let t = '';
  const fromage = (x: number, y: number, r: number, couleur = u('m')) => {
    let m = `<path d="${forme(R, x, y, r, 11, 0.3)}" fill="${couleur}"/>`;
    for (let j = 0; j < 2; j++) if (R() > 0.35) m += `<circle cx="${f(x + (R() - 0.5) * r)}" cy="${f(y + (R() - 0.5) * r)}" r="${f(1.2 + R() * 2.4)}" fill="#c9852f" opacity=".6" filter="${u('f')}"/>`;
    return m + `<ellipse cx="${f(x - r * 0.25)}" cy="${f(y - r * 0.3)}" rx="${f(r * 0.3)}" ry="${f(r * 0.16)}" fill="#fff" opacity=".45"/>`;
  };
  if (g('mozza')) for (let k = 0; k < 11; k++) { const [x, y] = point(R, 60); t += fromage(x, y, 8 + R() * 7); }
  if (g('fromages')) {
    const couleurs = [u('m'), '#f3d071', '#efe7d4', '#e4b85e'];
    for (let k = 0; k < 18; k++) {
      const [x, y] = point(R, 62);
      t += fromage(x, y, 7 + R() * 6, couleurs[k % 4]);
      if (k % 4 === 2) for (let j = 0; j < 6; j++) t += `<circle cx="${f(x + (R() - 0.5) * 11)}" cy="${f(y + (R() - 0.5) * 11)}" r="${f(0.6 + R() * 0.8)}" fill="#4f6f7d" opacity=".85"/>`;
    }
  }
  if (g('burrata')) {
    t += fromage(100, 100, 28);
    // Torn centre: creamy stracciatella with black pepper.
    t += `<path d="${forme(R, 97, 96, 13, 9, 0.3)}" fill="#fffef8"/>`;
    for (let j = 0; j < 10; j++) t += `<circle cx="${f(92 + R() * 14)}" cy="${f(90 + R() * 14)}" r=".7" fill="#2a2420"/>`;
  }
  if (g('salame')) {
    for (let k = 0; k < 13; k++) {
      const [x, y] = k === 0 ? [100, 100] : point(R, 62);
      t += `<g transform="translate(${f(x)} ${f(y)}) rotate(${f(R() * 360)})"><circle r="10" fill="${u('sa')}"/><circle r="10" fill="none" stroke="#4a0b04" stroke-width="1.4" opacity=".7"/>`;
      for (let j = 0; j < 7; j++) t += `<ellipse cx="${f((R() - 0.5) * 13)}" cy="${f((R() - 0.5) * 13)}" rx="${f(0.7 + R() * 1.3)}" ry="${f(0.6 + R())}" fill="#f2b3a0" opacity=".85"/>`;
      // Edge curled up in the oven: a light rim on the top left.
      t += `<path d="M-8.5-4A9.5 9.5 0 0 1 4-8.8" fill="none" stroke="#e86a4f" stroke-width="1.3" stroke-linecap="round" opacity=".7"/></g>`;
    }
  }
  if (g('champignons')) {
    for (let k = 0; k < 10; k++) {
      const [x, y] = point(R, 60);
      t += `<g transform="translate(${f(x)} ${f(y)}) rotate(${f(R() * 360)})"><path d="M-9 0A9 8 0 0 1 9 0L3.4 0 3.4 7-3.4 7-3.4 0Z" fill="#dcc09a" stroke="#8f6842" stroke-width="1"/><path d="M-6 0Q0-4 6 0M-4 0Q0-6 4 0" fill="none" stroke="#a57d55" stroke-width=".6"/></g>`;
    }
  }
  if (g('truffe')) {
    for (let k = 0; k < 9; k++) {
      const [x, y] = point(R, 55);
      t += `<path d="${forme(R, x, y, 4.5 + R() * 2, 8, 0.25)}" fill="#3a2a20"/><path d="M${f(x - 3)} ${f(y)}q2-2 4 0t3 1" fill="none" stroke="#9a8270" stroke-width=".5"/>`;
    }
  }
  if (g('legumes')) {
    for (let k = 0; k < 7; k++) {
      const [x, y] = point(R, 60);
      t += `<circle cx="${f(x)}" cy="${f(y)}" r="7" fill="#e6efc2" stroke="#3a7322" stroke-width="2.2"/>`;
      for (let j = 0; j < 5; j++) t += `<circle cx="${f(x + (R() - 0.5) * 6)}" cy="${f(y + (R() - 0.5) * 6)}" r=".7" fill="#b9c77a"/>`;
    }
    for (let k = 0; k < 8; k++) {
      const [x, y] = point(R, 62);
      const a = R() * 6.28;
      t += `<path d="M${f(x)} ${f(y)}q${f(Math.cos(a) * 8)} ${f(Math.sin(a) * 8 - 4)} ${f(Math.cos(a) * 16)} ${f(Math.sin(a) * 16)}" fill="none" stroke="${k % 2 ? '#e2361f' : '#f0b21a'}" stroke-width="3.6" stroke-linecap="round"/>`;
    }
  }
  if (g('tomates')) {
    for (let k = 0; k < 7; k++) {
      const [x, y] = point(R, 60);
      t += `<circle cx="${f(x)}" cy="${f(y)}" r="6.5" fill="#d32a17"/><circle cx="${f(x)}" cy="${f(y)}" r="4.4" fill="#f07155"/>`;
      for (let j = 0; j < 4; j++) t += `<ellipse cx="${f(x + Math.cos(j * 1.57) * 2.2)}" cy="${f(y + Math.sin(j * 1.57) * 2.2)}" rx=".9" ry=".6" fill="#f7d6a0"/>`;
      t += `<ellipse cx="${f(x - 2.5)}" cy="${f(y - 3)}" rx="1.6" ry=".8" fill="#fff" opacity=".6"/>`;
    }
  }
  if (g('olives')) {
    for (let k = 0; k < 10; k++) {
      const [x, y] = point(R, 64);
      t += `<circle cx="${f(x)}" cy="${f(y)}" r="3.8" fill="none" stroke="#231a1d" stroke-width="2.6"/><path d="M${f(x - 3)} ${f(y - 2)}a3.8 3.8 0 0 1 3-2" fill="none" stroke="#8a7a80" stroke-width=".8"/>`;
    }
  }
  if (g('roquette')) {
    for (let k = 0; k < 18; k++) {
      const [x, y] = point(R, 64);
      t += `<path transform="translate(${f(x)} ${f(y)}) rotate(${f(R() * 360)})" d="M-10 0L10 0M-6 0l-2.5-3.5M-2 0l-2 3.5M2 0l-2-3.5M6 0l-2 3.5" stroke="#3c8a2a" stroke-width="2.2" stroke-linecap="round" fill="none"/>`;
    }
  }
  if (g('basilic')) {
    for (let k = 0; k < 6; k++) {
      const [x, y] = point(R, 52);
      t += `<g transform="translate(${f(x)} ${f(y)}) rotate(${f(R() * 360)}) scale(${f(0.9 + R() * 0.5)})"><path d="M0-11Q9-3 0 11Q-9-3 0-11Z" fill="${u('fe')}"/><path d="M0-9V9M0-4l3.5-2M0 0l4-2M0-4l-3.5-2M0 0l-4-2" stroke="#7cc46c" stroke-width=".7" fill="none"/><ellipse cx="-2" cy="-4" rx="1.6" ry="3" fill="#fff" opacity=".25"/></g>`;
    }
  }
  if (g('parmesan')) {
    for (let k = 0; k < 12; k++) {
      const [x, y] = point(R, 58);
      t += `<path transform="translate(${f(x)} ${f(y)}) rotate(${f(R() * 360)})" d="M-5-1.5L5-2.5 4.5 1.5-4.5 2Z" fill="#f4e2a6" stroke="#d8bd72" stroke-width=".4"/>`;
    }
  }
  s += `<g filter="${u('o')}">${t}</g>`;
  if (g('piment')) {
    for (let k = 0; k < 40; k++) {
      const [x, y] = point(R, 70);
      s += `<rect x="${f(x)}" y="${f(y)}" width="2.4" height="1.2" rx=".5" fill="#d8351a" transform="rotate(${f(R() * 360)} ${f(x)} ${f(y)})"/>`;
    }
  }
  if (g('origan')) {
    for (let k = 0; k < 60; k++) {
      const [x, y] = point(R, 70);
      s += `<rect x="${f(x)}" y="${f(y)}" width="1.3" height=".8" fill="${R() > 0.5 ? '#4d5c1f' : '#6b7a2c'}" opacity=".85"/>`;
    }
  }
  if (g('huile')) {
    // Olive oil: a few golden glints catching the light.
    for (let k = 0; k < 9; k++) {
      const [x, y] = point(R, 62);
      s += `<ellipse cx="${f(x)}" cy="${f(y)}" rx="${f(2 + R() * 3)}" ry="${f(1 + R() * 1.5)}" fill="#ffd45e" opacity=".45"/><circle cx="${f(x - 1)}" cy="${f(y - 0.6)}" r=".7" fill="#fff" opacity=".8"/>`;
    }
  }
  return s + `<circle cx="100" cy="100" r="95" fill="${u('l')}"/>`;
}

const carte = [
  { nom: 'La Fuoco', desc: 'Tomate, fior di latte, salame piccante, olives noires, basilic, huile d’olive', prix: 16, cat: 'rosse', base: 'rossa', g: ['mozza', 'salame', 'olives', 'basilic', 'huile'], graine: 23, signature: true },
  { nom: 'Margherita', desc: 'San Marzano, fior di latte, basilic, parmesan, huile d’olive', prix: 12, cat: 'rosse', base: 'rossa', g: ['mozza', 'basilic', 'parmesan', 'huile'], graine: 3 },
  { nom: 'Diavola', desc: 'Tomate, fior di latte, salame piquant, piment de Calabre, olives, origan', prix: 15, cat: 'piccanti', base: 'rossa', g: ['mozza', 'salame', 'piment', 'olives', 'origan'], graine: 7 },
  { nom: 'Quattro formaggi', desc: 'Fior di latte, gorgonzola, parmesan 24 mois, scamorza fumée', prix: 16, cat: 'bianche', base: 'bianca', g: ['fromages', 'parmesan'], graine: 11 },
  { nom: 'Funghi e tartufo', desc: 'Crème de truffe, champignons, fior di latte, parmesan', prix: 19, cat: 'bianche', base: 'bianca', g: ['mozza', 'champignons', 'truffe', 'parmesan'], graine: 5 },
  { nom: 'Burrata', desc: 'Tomate, burrata entière, tomates cerises, roquette, parmesan, huile d’olive', prix: 17, cat: 'rosse', base: 'rossa', g: ['burrata', 'tomates', 'roquette', 'parmesan', 'huile'], graine: 17 },
  { nom: 'Ortolana', desc: 'Tomate, courgette, poivrons rôtis, olives taggiasche, basilic (végétarienne)', prix: 14, cat: 'rosse', base: 'rossa', g: ['mozza', 'legumes', 'olives', 'basilic', 'origan'], graine: 13 },
] as const;
const filtres = [['toutes', 'Toutes'], ['rosse', 'Rosse'], ['bianche', 'Bianche'], ['piccanti', 'Piccanti']];
// Opening hours, Sunday first (Date.getDay order); used for the table and the live "open now" badge.
const horaires: [string, [string, string][]][] = [
  ['Dimanche', [['12:00', '14:30'], ['18:30', '22:30']]],
  ['Lundi', []],
  ['Mardi', [['18:30', '22:30']]],
  ['Mercredi', [['18:30', '22:30']]],
  ['Jeudi', [['18:30', '22:30']]],
  ['Vendredi', [['18:30', '23:30']]],
  ['Samedi', [['12:00', '14:30'], ['18:30', '23:30']]],
];
const ordre = [1, 2, 3, 4, 5, 6, 0];
const services = ['Sur place', 'À emporter', 'Livraison 5 km', 'Terrasse', 'Accès PMR', 'Végétarien', 'Sans gluten (+2 €)'];
const produits = [
  ['Pâte', 'Farine type 00, levain, 48 h de maturation au froid.'],
  ['Tomate', 'San Marzano DOP, cultivée au pied du Vésuve.'],
  ['Fior di latte', 'Mozzarella de lait de vache, livrée deux fois par semaine.'],
  ['Salame piccante', 'Salami de Calabre au piment, tranché minute.'],
  ['Basilic', 'De notre potager, posé à la sortie du four.'],
];
const avis = [
  ['La meilleure napolitaine de l’ouest parisien. La croûte est incroyable.', 'Camille R.', 'il y a 3 jours'],
  ['On vient chaque vendredi. Service adorable, pizzas parfaites, prix honnêtes.', 'Mehdi B.', 'il y a 1 semaine'],
  ['La Fuoco au salame piquant, c’est une claque. Et le tiramisu !', 'Julie T.', 'il y a 2 semaines'],
  ['Pâte légère, on la digère comme rien. Et la burrata est énorme.', 'Antoine L.', 'il y a 3 semaines'],
  ['Réservé pour huit un samedi soir : accueil au top, service rapide.', 'Sofia M.', 'il y a 1 mois'],
];
// Allergens shown on each menu pizza, derived from its toppings.
const allergenes = (p: { base: string; g: readonly string[] }) => [
  ['G', 'Gluten'],
  ...(p.base === 'bianca' || p.g.some((x) => ['mozza', 'fromages', 'burrata', 'parmesan'].includes(x)) ? [['L', 'Lait']] : []),
  ...(p.g.includes('salame') ? [['P', 'Porc']] : [['V', 'Végétarien']]),
];
const retraits = ['19:00', '19:15', '19:30', '19:45', '20:00', '20:15', '20:30'];
const creneaux = [['19:00', true], ['19:30', true], ['20:00', false], ['20:30', true], ['21:00', true], ['21:30', false]] as const;
const etoiles = '★★★★★';
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Fuoco — Pizzeria napolitaine (démo)</title>
    <meta name="robots" content="noindex" />
    <meta name="description" content="Page d’accueil d’une pizzeria fictive : démo de site vitrine réalisée par Timéo." />
    <noscript><style>.chargement { display: none } #accueil .panneau * { animation-play-state: running !important }</style></noscript>
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Ccircle cx='16' cy='16' r='15' fill='%23e8471f'/%3E%3C/svg%3E" />
  </head>
  <body>
    <div class="chargement" aria-hidden="true">
      <p class="chargement__nom">Fuoco</p>
      <p class="chargement__texte">Le four chauffe… <b>20</b> °C</p>
      <div class="chargement__barre"><i></i></div>
    </div>
    <canvas class="scene3d" aria-hidden="true"></canvas>
    <div class="secours" aria-hidden="true" hidden><svg viewBox="0 0 200 200" set:html={pizza('secours', 23, 'rossa', ['mozza', 'salame', 'olives', 'basilic', 'huile'])} /></div>
    <canvas class="braises" aria-hidden="true"></canvas>
    <p class="etiquette" aria-hidden="true"><b>01</b><span>Pâte maturée 48 h</span></p>

    <header class="nav">
      <a class="logo" href="#accueil">Fuoco<sup>®</sup></a>
      <nav>
        <a href="#infos">Infos</a>
        <a href="#carte">La carte</a>
        <a href="#avis">Avis</a>
        <a href="#reserver" class="nav__cta">Réserver</a>
      </nav>
    </header>

    <main>
      <section id="accueil" class="bloc" data-q="0">
        <div class="panneau">
          <p class="sur">Pizzeria napolitaine · Versailles</p>
          <h1 aria-label="Fuoco">
            {[...'Fuoco'].map((c, k) => <span style={`--k: ${k}`} aria-hidden="true">{c}</span>)}
          </h1>
          <p class="accroche">Pâte maturée 48 heures. Cuite <em>90 secondes</em> au feu de bois, à 485 °C. Rien d’autre.</p>
          <p class="statut"><span class="pastille"></span><span class="statut__texte">Horaires ci-dessous</span></p>
          <p class="note"><span class="etoiles" aria-hidden="true">{etoiles}</span> <b>4,8</b> · 1 240 avis</p>
          <div class="boutons">
            <a class="bouton" href="#reserver">Réserver une table</a>
            <a class="bouton bouton--ligne" href="#carte">Voir la carte</a>
          </div>
        </div>
      </section>

      <section id="infos" class="bloc" data-q="0.12">
        <div class="panneau">
          <p class="sur">Infos pratiques</p>
          <h2>Ouvert <em>six soirs</em><br />sur sept.</h2>
          <table class="horaires">
            <tbody>
              {ordre.map((j) => (
                <tr data-jour={j}>
                  <th scope="row">{horaires[j][0]}</th>
                  <td>{horaires[j][1].length ? horaires[j][1].map(([a, b]) => `${a} – ${b}`).join(' · ') : 'Fermé'}</td>
                </tr>
              ))}
            </tbody>
          </table>
          <div class="coord">
            <p><b>Adresse</b>8 rue des Braises<br />78000 Versailles<br /><small>À 5 min à pied du château</small></p>
            <p><b>Téléphone</b>01 00 00 00 00<br /><small>Commandes à emporter jusqu’à 22 h</small></p>
          </div>
          <svg class="plan" viewBox="0 0 400 200" role="img" aria-label="Plan : Fuoco, 8 rue des Braises, à 5 minutes à pied du château">
            <rect class="plan__parc" x="18" y="16" width="130" height="80" rx="10" />
            <text x="83" y="60" text-anchor="middle">Château</text>
            <path class="rue" style="--i: 0" d="M0 122C120 112 260 130 400 118" pathLength="1" />
            <path class="rue" style="--i: 1" d="M172 0C180 70 166 140 182 200" pathLength="1" />
            <path class="rue rue--fine" style="--i: 2" d="M0 172L400 150" pathLength="1" />
            <path class="rue rue--fine" style="--i: 3" d="M302 0C292 60 312 140 296 200" pathLength="1" />
            <path class="rue rue--fine" style="--i: 4" d="M62 122L40 200" pathLength="1" />
            <path class="trajet" d="M148 92C170 108 210 114 246 104" />
            <text x="200" y="88" class="plan__petit" text-anchor="middle">5 min à pied</text>
            <text x="230" y="140" class="plan__petit">rue des Braises</text>
            <text x="352" y="186" text-anchor="middle">Gare</text>
            <g transform="translate(250 104)">
              <g class="repere">
                <circle class="repere__onde" r="9" />
                <path d="M0 0C-10-12-10-25 0-27C10-25 10-12 0 0Z" />
                <circle cy="-18" r="4" class="repere__trou" />
              </g>
            </g>
            <text x="264" y="84" class="plan__nom">Fuoco</text>
          </svg>
          <ul class="services">
            {services.map((s) => <li>{s}</li>)}
          </ul>
        </div>
      </section>

      <section id="carte" class="bloc" data-q="0.27">
        <div class="panneau">
          <p class="sur">La carte</p>
          <h2>Sept pizzas.<br /><em>Aucun compromis.</em></h2>
          <div class="filtres" role="group" aria-label="Filtrer la carte">
            {filtres.map(([v, l], i) => <button type="button" data-filtre={v} aria-pressed={i === 0 ? 'true' : 'false'}>{l}</button>)}
          </div>
          <ul class="pizzas">
            {carte.map((p, i) => (
              <li class="pizza" data-cat={p.cat} data-base={p.base} data-g={p.g.join(',')} data-nom={p.nom} style={`view-transition-name: pizza-${i}`}>
                <svg viewBox="0 0 200 200" aria-hidden="true" set:html={pizza(`p${i}`, p.graine, p.base, [...p.g])} />
                <div>
                  <div class="pizza__ligne">
                    <h3>{p.nom}</h3>
                    {'signature' in p && <span class="pastille-texte">Signature</span>}
                    {p.cat === 'piccanti' && <span class="pastille-texte pastille-texte--piquant">Piquant</span>}
                    <span class="points" aria-hidden="true"></span>
                    <span class="prix">{p.prix} €</span>
                  </div>
                  <p>{p.desc}</p>
                  <p class="allergenes">
                    {allergenes(p).map(([c, n]) => <span tabindex="0" data-info={n} aria-label={n}>{c}</span>)}
                  </p>
                </div>
                <button type="button" class="ajouter" data-prix={p.prix} aria-label={`Ajouter ${p.nom} au panier`}>+</button>
              </li>
            ))}
          </ul>
          <p class="mention">Formule du midi (samedi et dimanche) : pizza + boisson, 15 €.<br />Allergènes : <b>G</b> gluten · <b>L</b> lait · <b>P</b> porc · <b>V</b> végétarien.</p>
        </div>
      </section>

      <section id="produits" class="bloc" data-q="0.42">
        <div class="panneau">
          <p class="sur">Nos produits</p>
          <h2>Cinq ingrédients.<br /><em>Tous choisis.</em></h2>
          <ul class="produits">
            {produits.map(([n, d], i) => (
              <li style={`--i: ${i}`}>
                <b>0{i + 1}</b>
                <span><strong>{n}</strong>{d}</span>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <section id="avis" class="bloc" data-q="0.55">
        <div class="panneau">
          <p class="sur">Avis</p>
          <h2><span class="etoiles">{etoiles}</span><br />4,8 sur 5.</h2>
          <div class="carrousel">
            <ul class="temoignages">
              {avis.map(([t, n, d], i) => (
                <li class={i === 0 ? 'actif' : ''} aria-hidden={i === 0 ? 'false' : 'true'}>
                  <span class="initiale" aria-hidden="true">{n[0]}</span>
                  <p>« {t} »</p>
                  <span>{n} · {d} · <span class="etoiles" aria-label="5 étoiles">{etoiles}</span></span>
                </li>
              ))}
            </ul>
            <div class="carrousel__points">
              {avis.map((_, i) => <button type="button" data-i={i} aria-label={`Avis ${i + 1}`} aria-pressed={i === 0 ? 'true' : 'false'}></button>)}
            </div>
          </div>
        </div>
      </section>

      <section id="four" class="bloc" data-q="0.68">
        <div class="panneau">
          <p class="sur">Le four</p>
          <strong class="degres"><span class="compte" data-fin="485">485</span><sup>°C</sup></strong>
          <div class="thermo"><i></i></div>
          <p class="four__texte">Un four en briques réfractaires, chauffé au chêne depuis 16 h. Quatre-vingt-dix secondes suffisent : la pâte gonfle, la croûte se tigre, le fromage file.</p>
          <div class="minuteur" aria-label="Temps de cuisson : 90 secondes">
            <svg viewBox="0 0 120 120" aria-hidden="true">
              <circle cx="60" cy="60" r="52" class="anneau-fond" />
              <circle cx="60" cy="60" r="52" class="anneau" pathLength="1" />
            </svg>
            <span><b>90</b> secondes</span>
          </div>
        </div>
      </section>

      <section id="reserver" class="bloc" data-q="0.9">
        <div class="panneau">
          <p class="sur">Réserver</p>
          <h2>Une table,<br /><em>ce soir ?</em></h2>
          <form class="resa" novalidate>
            <fieldset>
              <legend>Jour</legend>
              <div class="jours"></div>
            </fieldset>
            <fieldset>
              <legend>Couverts</legend>
              <div class="couverts">
                <button type="button" data-pas="-1" aria-label="Une personne de moins">−</button>
                <output>2</output>
                <button type="button" data-pas="1" aria-label="Une personne de plus">+</button>
              </div>
            </fieldset>
            <fieldset>
              <legend>Heure</legend>
              <div class="creneaux">
                {creneaux.map(([h, libre]) => <button type="button" data-heure={h} disabled={!libre} aria-pressed="false">{h}{!libre && <small>complet</small>}</button>)}
              </div>
            </fieldset>
            <button class="bouton resa__ok" type="submit">Réserver</button>
            <p class="resa__note">Démo : aucune réservation n’est envoyée.</p>
            <div class="ticket" aria-live="polite">
              <p class="sur">Prenotazione</p>
              <p class="ticket__resume"></p>
              <span class="tampon">Confermato</span>
            </div>
          </form>
        </div>
      </section>
    </main>

    <footer class="pied" data-q="1">
      <div class="pied__infos">
        <p><b>Fuoco</b><br />8 rue des Braises<br />78000 Versailles</p>
        <p><b>Ouvert</b><br />Mardi – dimanche<br />Fermé le lundi</p>
        <p><b>Contact</b><br />01 00 00 00 00<br />ciao@fuoco.example</p>
      </div>
    </footer>

    <button class="panier" type="button" hidden><span class="panier__compte">0</span><span class="panier__total">0 €</span><b>Commander</b></button>
    <aside class="tiroir" aria-label="Votre commande" aria-hidden="true">
      <div class="tiroir__tete">
        <p class="sur">À emporter</p>
        <button type="button" class="tiroir__fermer" aria-label="Fermer la commande">×</button>
      </div>
      <h2 class="tiroir__titre">Votre commande</h2>
      <ul class="tiroir__liste"></ul>
      <p class="tiroir__total">Total <b>0 €</b></p>
      <fieldset>
        <legend>Retrait</legend>
        <div class="retraits">
          {retraits.map((h) => <button type="button" data-retrait={h} aria-pressed="false">{h}</button>)}
        </div>
      </fieldset>
      <button class="bouton tiroir__ok" type="button">Valider la commande</button>
      <p class="resa__note">Démo : aucune commande n’est envoyée, paiement sur place.</p>
      <div class="ticket" aria-live="polite">
        <p class="sur">Grazie !</p>
        <p class="ticket__resume"></p>
        <span class="tampon">Ordinato</span>
      </div>
    </aside>

    <a class="badge" href="https://jeannin.dev/" target="_top">Démo · pizzeria fictive · site réalisé par Timéo ↗</a>
  </body>
</html>

<script>
  const animer = !matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Loading screen while the 3D pizza loads: the oven "heats up", then the screen fades away.
  const chargement = document.querySelector<HTMLElement>('.chargement')!;
  const degres = chargement.querySelector('b')!;
  const t0 = performance.now();
  let chauffe = 0;
  const monter = (t: number) => {
    const k = Math.min((t - t0) / 1800, 1);
    degres.textContent = String(Math.round(20 + 465 * (1 - (1 - k) ** 3)));
    if (k < 1) chauffe = requestAnimationFrame(monter);
  };
  chauffe = requestAnimationFrame(monter);
  let ouvert = false;
  const ouvrir = () => {
    if (ouvert) return;
    ouvert = true;
    // Let the heating animation play at least once so the screen does not just flash.
    setTimeout(() => {
      cancelAnimationFrame(chauffe);
      degres.textContent = '485';
      chargement.classList.add('fini');
      document.documentElement.classList.add('charge');
    }, Math.max(0, 1300 - (performance.now() - t0)));
  };
  setTimeout(ouvrir, 9000);

  // Reveal on scroll.
  const io = new IntersectionObserver(
    (entrees) => entrees.forEach((e) => e.isIntersecting && (e.target.classList.add('vu'), io.unobserve(e.target))),
    { rootMargin: '0px 0px -12% 0px' },
  );
  document.querySelectorAll('.panneau').forEach((el) => io.observe(el));

  // 3D pizza behind the page; each section (and the footer) gives the stage it starts. Hidden if WebGL fails.
  const scene = document.querySelector<HTMLCanvasElement>('.scene3d')!;
  const etiquette = document.querySelector<HTMLElement>('.etiquette')!;
  const libelles = ['Pâte maturée 48 h', 'Sauce San Marzano DOP', 'Fior di latte', 'Salame et olives', 'Basilic du potager', '485 °C · 90 secondes', 'Prête · La Fuoco'];
  // Without WebGL (disabled acceleration, old GPU...) the drawn pizza takes its place; the cause goes to the console.
  const secours = (e: unknown) => {
    console.error('Pizza 3D indisponible, pizza dessinée affichée à la place :', e);
    scene.hidden = true;
    etiquette.hidden = true;
    document.querySelector<HTMLElement>('.secours')!.hidden = false;
    ouvrir();
  };
  import('../../scripts/pizza3d')
    .then(({ demarrer }) =>
      demarrer(
        scene,
        [...document.querySelectorAll<HTMLElement>('[data-q]')],
        (i) => {
          etiquette.querySelector('b')!.textContent = `0${i + 1}`;
          etiquette.querySelector('span')!.textContent = libelles[i];
          etiquette.classList.remove('change');
          void etiquette.offsetWidth;
          etiquette.classList.add('change');
        },
        secours,
        ouvrir,
      ),
    )
    .then((api) => {
      // Hovering a menu pizza previews it on the 3D one; leaving the menu goes back to the scroll state.
      const liste = document.querySelector<HTMLElement>('.pizzas')!;
      liste.querySelectorAll<HTMLElement>('.pizza').forEach((li) =>
        li.addEventListener('pointerenter', () => api.montrer({ base: li.dataset.base!, g: li.dataset.g!.split(',') })),
      );
      liste.addEventListener('pointerleave', () => api.montrer(null));
    })
    .catch(secours);

  // Embers rising over the scene, stronger while the pizza bakes (--cuisson set by the 3D script).
  const toile = document.querySelector<HTMLCanvasElement>('.braises')!;
  const ctx = toile.getContext('2d')!;
  let w = 0, h = 0;
  const taille = () => {
    const dpr = Math.min(devicePixelRatio, 2);
    w = innerWidth;
    h = innerHeight;
    toile.width = w * dpr;
    toile.height = h * dpr;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  };
  taille();
  addEventListener('resize', taille);
  const neuve = () => ({ x: Math.random() * w, y: h + Math.random() * 40, v: 0.5 + Math.random() * 1.8, r: 0.6 + Math.random() * 2.2, p: Math.random() * 6.28, t: 20 + Math.random() * 25, vie: 0 });
  const braises = Array.from({ length: 90 }, () => ({ ...neuve(), y: Math.random() * h }));
  const tour = () => {
    ctx.clearRect(0, 0, w, h);
    ctx.globalCompositeOperation = 'lighter';
    for (const b of braises) {
      b.vie++;
      b.y -= b.v;
      b.x += Math.sin(b.p + b.vie / b.t) * 0.6;
      if (b.y < -10) Object.assign(b, neuve());
      const a = Math.min(1, b.y / h + 0.15) * (0.6 + Math.sin(b.vie / 4 + b.p) * 0.4);
      ctx.fillStyle = `hsla(${22 + b.r * 9}, 100%, ${55 + b.r * 6}%, ${a})`;
      ctx.beginPath();
      ctx.arc(b.x, b.y, b.r, 0, 6.28);
      ctx.fill();
      ctx.fillStyle = `hsla(30, 100%, 60%, ${a * 0.18})`;
      ctx.beginPath();
      ctx.arc(b.x, b.y, b.r * 4, 0, 6.28);
      ctx.fill();
    }
    requestAnimationFrame(tour);
  };
  if (animer) requestAnimationFrame(tour);

  // Opening hours: highlight today and say whether the restaurant is open right now.
  const plages: [string, string][][] = [
    [['12:00', '14:30'], ['18:30', '22:30']], [], [['18:30', '22:30']], [['18:30', '22:30']], [['18:30', '22:30']], [['18:30', '23:30']], [['12:00', '14:30'], ['18:30', '23:30']],
  ];
  const maintenant = new Date();
  const jour = maintenant.getDay();
  const minutes = (hm: string) => Number(hm.slice(0, 2)) * 60 + Number(hm.slice(3));
  const actuelle = maintenant.getHours() * 60 + maintenant.getMinutes();
  document.querySelector(`.horaires tr[data-jour="${jour}"]`)?.classList.add('aujourdhui');
  const ouverte = plages[jour].find(([a, b]) => actuelle >= minutes(a) && actuelle < minutes(b));
  const prochaine = plages[jour].find(([a]) => actuelle < minutes(a));
  const statut = document.querySelector<HTMLElement>('.statut')!;
  statut.classList.toggle('ouvert', !!ouverte);
  statut.querySelector('.statut__texte')!.textContent = ouverte
    ? `Ouvert maintenant · jusqu’à ${ouverte[1].replace(':', ' h ')}`
    : prochaine
      ? `Fermé · ouvre à ${prochaine[0].replace(':', ' h ')}`
      : 'Fermé pour aujourd’hui';

  // Menu filter: cards rearrange with a view transition where supported.
  const boutons = document.querySelectorAll<HTMLButtonElement>('[data-filtre]');
  boutons.forEach((b) =>
    b.addEventListener('click', () => {
      const appliquer = () => {
        boutons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        document.querySelectorAll<HTMLElement>('.pizza').forEach((p) => (p.hidden = b.dataset.filtre !== 'toutes' && p.dataset.cat !== b.dataset.filtre));
      };
      if (animer && document.startViewTransition) document.startViewTransition(appliquer);
      else appliquer();
    }),
  );

  // Oven: the temperature climbs when the section appears.
  const compte = document.querySelector<HTMLElement>('.compte')!;
  if (animer) {
    compte.textContent = '0';
    new IntersectionObserver(([e], obs) => {
      if (!e.isIntersecting) return;
      obs.disconnect();
      const debut = performance.now();
      const pas = (t: number) => {
        const k = Math.min((t - debut) / 1800, 1);
        compte.textContent = String(Math.round(485 * (1 - (1 - k) ** 3)));
        if (k < 1) requestAnimationFrame(pas);
      };
      requestAnimationFrame(pas);
    }, { threshold: 0.6 }).observe(compte);
  }

  // Booking (demo, nothing is sent): next 7 days, closed on Mondays.
  const jours = document.querySelector('.jours')!;
  const noms = ['dim.', 'lun.', 'mar.', 'mer.', 'jeu.', 'ven.', 'sam.'];
  const choix = { jour: '', heure: '', couverts: 2 };
  for (let i = 0; i < 7; i++) {
    const d = new Date();
    d.setDate(d.getDate() + i);
    const libelle = i === 0 ? 'Ce soir' : i === 1 ? 'Demain' : `${noms[d.getDay()]} ${d.getDate()}`;
    const b = Object.assign(document.createElement('button'), { type: 'button', textContent: libelle, disabled: d.getDay() === 1 });
    if (b.disabled) b.append(Object.assign(document.createElement('small'), { textContent: 'fermé' }));
    b.setAttribute('aria-pressed', 'false');
    b.dataset.jour = libelle;
    jours.append(b);
  }
  const unique = (groupe: Element, cible: HTMLButtonElement) => groupe.querySelectorAll('button').forEach((x) => x.setAttribute('aria-pressed', String(x === cible)));
  jours.addEventListener('click', (e) => {
    const b = (e.target as Element).closest<HTMLButtonElement>('button[data-jour]');
    if (b && !b.disabled) (unique(jours, b), (choix.jour = b.dataset.jour!));
  });
  const creneaux = document.querySelector('.creneaux')!;
  creneaux.addEventListener('click', (e) => {
    const b = (e.target as Element).closest<HTMLButtonElement>('button[data-heure]');
    if (b && !b.disabled) (unique(creneaux, b), (choix.heure = b.dataset.heure!));
  });
  const sortie = document.querySelector('.couverts output')!;
  document.querySelectorAll<HTMLButtonElement>('[data-pas]').forEach((b) =>
    b.addEventListener('click', () => {
      choix.couverts = Math.min(12, Math.max(1, choix.couverts + Number(b.dataset.pas)));
      sortie.textContent = String(choix.couverts);
    }),
  );
  const form = document.querySelector<HTMLFormElement>('.resa')!;
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const manque = !choix.jour ? 'jours' : !choix.heure ? 'creneaux' : '';
    if (manque) {
      const g = document.querySelector<HTMLElement>(`.${manque}`)!;
      g.classList.remove('secoue');
      void g.offsetWidth;
      g.classList.add('secoue');
      return;
    }
    form.querySelector('.ticket__resume')!.textContent = `Table pour ${choix.couverts} · ${choix.jour} · ${choix.heure}`;
    form.classList.add('confirme');
  });

  // Section titles: words rise one after the other when their panel appears.
  document.querySelectorAll<HTMLElement>('.panneau h2').forEach((h2) => {
    h2.setAttribute('aria-label', h2.textContent!.replace(/\s+/g, ' ').trim());
    const noeuds: Text[] = [];
    const parcours = document.createTreeWalker(h2, NodeFilter.SHOW_TEXT);
    while (parcours.nextNode()) noeuds.push(parcours.currentNode as Text);
    let n = 0;
    for (const t of noeuds) {
      const morceaux = document.createDocumentFragment();
      for (const part of t.textContent!.split(/(\s+)/)) {
        if (!part) continue;
        if (/^\s+$/.test(part)) {
          morceaux.append(part);
          continue;
        }
        const mot = Object.assign(document.createElement('span'), { className: 'mot', textContent: part });
        mot.style.setProperty('--w', String(n++));
        mot.setAttribute('aria-hidden', 'true');
        morceaux.append(mot);
      }
      t.replaceWith(morceaux);
    }
  });

  // Reviews: one at a time, advancing every 5 s (paused while hovered or focused).
  const avisLi = [...document.querySelectorAll<HTMLElement>('.temoignages li')];
  const points = [...document.querySelectorAll<HTMLButtonElement>('.carrousel__points button')];
  let actuel = 0;
  const aller = (k: number) => {
    actuel = (k + avisLi.length) % avisLi.length;
    avisLi.forEach((li, j) => {
      li.classList.toggle('actif', j === actuel);
      li.setAttribute('aria-hidden', String(j !== actuel));
    });
    points.forEach((b, j) => b.setAttribute('aria-pressed', String(j === actuel)));
  };
  points.forEach((b, j) => b.addEventListener('click', () => aller(j)));
  const carrousel = document.querySelector<HTMLElement>('.carrousel')!;
  let enPause = false;
  carrousel.addEventListener('pointerenter', () => (enPause = true));
  carrousel.addEventListener('pointerleave', () => (enPause = false));
  carrousel.addEventListener('focusin', () => (enPause = true));
  carrousel.addEventListener('focusout', () => (enPause = false));
  if (animer) setInterval(() => !enPause && !document.hidden && aller(actuel + 1), 5000);

  // Takeaway order (demo, nothing is sent): "+" on a pizza flies it to the cart.
  const panier = new Map<string, { prix: number; qte: number }>();
  const boutonPanier = document.querySelector<HTMLButtonElement>('.panier')!;
  const tiroir = document.querySelector<HTMLElement>('.tiroir')!;
  const lignes = tiroir.querySelector('.tiroir__liste')!;
  const retraits = tiroir.querySelector<HTMLElement>('.retraits')!;
  let retrait = '';
  const total = () => [...panier.values()].reduce((t, l) => t + l.prix * l.qte, 0);
  const fermerTiroir = () => {
    tiroir.classList.remove('ouvert');
    tiroir.setAttribute('aria-hidden', 'true');
    // After a confirmed order, the cart starts again empty.
    if (tiroir.classList.contains('confirme')) {
      setTimeout(() => {
        panier.clear();
        tiroir.classList.remove('confirme');
        afficher();
      }, 600);
    }
  };
  const afficher = () => {
    const n = [...panier.values()].reduce((t, l) => t + l.qte, 0);
    boutonPanier.hidden = n === 0;
    boutonPanier.querySelector('.panier__compte')!.textContent = String(n);
    boutonPanier.querySelector('.panier__total')!.textContent = `${total()} €`;
    tiroir.querySelector('.tiroir__total b')!.textContent = `${total()} €`;
    lignes.replaceChildren(
      ...[...panier].map(([nom, l]) => {
        const li = document.createElement('li');
        li.innerHTML = `<span>${nom}</span><span class="qte"><button type="button" data-nom="${nom}" data-qte="-1" aria-label="Une ${nom} de moins">−</button><b>${l.qte}</b><button type="button" data-nom="${nom}" data-qte="1" aria-label="Une ${nom} de plus">+</button></span><span>${l.prix * l.qte} €</span>`;
        return li;
      }),
    );
    if (n === 0 && !tiroir.classList.contains('confirme')) fermerTiroir();
  };
  document.querySelectorAll<HTMLButtonElement>('.ajouter').forEach((b) =>
    b.addEventListener('click', () => {
      const li = b.closest<HTMLElement>('.pizza')!;
      const ligne = panier.get(li.dataset.nom!) ?? { prix: Number(b.dataset.prix), qte: 0 };
      ligne.qte++;
      panier.set(li.dataset.nom!, ligne);
      afficher();
      const rebond = () => {
        boutonPanier.classList.remove('bump');
        void boutonPanier.offsetWidth;
        boutonPanier.classList.add('bump');
      };
      if (!animer) return rebond();
      // The thumbnail flies to the cart button, spinning and shrinking.
      const svg = li.querySelector('svg')!;
      const a = svg.getBoundingClientRect(), c = boutonPanier.getBoundingClientRect();
      const vol = svg.cloneNode(true) as SVGElement;
      vol.classList.add('vol');
      Object.assign(vol.style, { left: `${a.left}px`, top: `${a.top}px`, width: `${a.width}px` });
      document.body.append(vol);
      vol
        .animate(
          [
            { transform: 'none' },
            { transform: `translate(${c.left + c.width / 2 - a.left - a.width / 2}px, ${c.top + c.height / 2 - a.top - a.height / 2}px) scale(0.2) rotate(360deg)`, opacity: 0.5 },
          ],
          { duration: 700, easing: 'cubic-bezier(0.5, 0, 0.3, 1)' },
        )
        .finished.then(() => {
          vol.remove();
          rebond();
        });
    }),
  );
  boutonPanier.addEventListener('click', () => {
    tiroir.classList.add('ouvert');
    tiroir.removeAttribute('aria-hidden');
    tiroir.querySelector<HTMLElement>('.tiroir__fermer')!.focus();
  });
  tiroir.querySelector('.tiroir__fermer')!.addEventListener('click', fermerTiroir);
  addEventListener('keydown', (e) => e.key === 'Escape' && tiroir.classList.contains('ouvert') && fermerTiroir());
  lignes.addEventListener('click', (e) => {
    const b = (e.target as Element).closest<HTMLButtonElement>('button[data-qte]');
    if (!b) return;
    const ligne = panier.get(b.dataset.nom!)!;
    ligne.qte += Number(b.dataset.qte);
    if (ligne.qte <= 0) panier.delete(b.dataset.nom!);
    afficher();
  });
  retraits.addEventListener('click', (e) => {
    const b = (e.target as Element).closest<HTMLButtonElement>('button[data-retrait]');
    if (!b) return;
    retraits.querySelectorAll('button').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    retrait = b.dataset.retrait!;
  });
  tiroir.querySelector('.tiroir__ok')!.addEventListener('click', () => {
    if (!retrait) {
      retraits.classList.remove('secoue');
      void retraits.offsetWidth;
      retraits.classList.add('secoue');
      return;
    }
    tiroir.querySelector('.ticket__resume')!.textContent = `Commande n° ${100 + Math.floor(Math.random() * 900)} · retrait ${retrait} · ${total()} € à régler sur place`;
    tiroir.classList.add('confirme');
  });
</script>

