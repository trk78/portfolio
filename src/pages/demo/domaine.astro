---
// Demo "business website" #2: a fictional Loire Valley wine estate. Light and refined, as a counterpoint to the pizzeria.
// A 3D bottle (src/scripts/vin3d.ts) sits behind the page: its label draws itself, the wine fills it as you scroll,
// and hovering a wine or a food pairing previews that wine in the bottle.
import '@fontsource/cormorant-garamond/500.css';
import '@fontsource/cormorant-garamond/600.css';
import '@fontsource/cormorant-garamond/500-italic.css';
import '@fontsource/cormorant-garamond/600-italic.css';
import '@fontsource/instrument-sans/400.css';
import '@fontsource/instrument-sans/500.css';
import '@fontsource/instrument-sans/600.css';

const cuvees = [
  { nom: 'Brume d’Automne', type: 'Rouge', millesime: '2021', couleur: '#4a0816', cepage: 'Cabernet franc', notes: 'Cerise noire, poivre, tanins soyeux.', prix: 18 },
  { nom: 'Coteau Blanc', type: 'Blanc sec', millesime: '2022', couleur: '#d7bf62', cepage: 'Chenin', notes: 'Coing, fleur d’acacia, finale saline.', prix: 16 },
  { nom: 'Rosée du Matin', type: 'Rosé', millesime: '2023', couleur: '#e3807a', cepage: 'Cabernet & Grolleau', notes: 'Fraise des bois, agrumes, très frais.', prix: 12 },
  { nom: 'Fines Bulles', type: 'Méthode traditionnelle', millesime: '2020', couleur: '#e8d48a', cepage: 'Chenin & Chardonnay', notes: 'Brioche, pomme verte, bulle fine.', prix: 22 },
];
const chiffres = [
  [1924, '', 'année de la première vendange'],
  [14, ' ha', 'de vignes sur un seul coteau'],
  [4, '', 'générations de vignerons'],
  [100, ' %', 'en agriculture biologique'],
];
// Plots of the estate: polygon on the map, grape, soil, age of the vines.
const parcelles = [
  { nom: 'Les Perrières', cepage: 'Chenin', sol: 'Tuffeau et silex', age: '62 ans', d: 'M60 40L170 30 190 95 80 110Z' },
  { nom: 'La Butte', cepage: 'Cabernet franc', sol: 'Argile à silex', age: '45 ans', d: 'M190 28L300 20 315 90 205 96Z' },
  { nom: 'Clos du Haut', cepage: 'Cabernet franc', sol: 'Tuffeau', age: '70 ans', d: 'M320 22L420 30 410 105 330 92Z' },
  { nom: 'Les Sables', cepage: 'Grolleau', sol: 'Sables', age: '28 ans', d: 'M85 120L200 108 210 170 95 178Z' },
  { nom: 'Le Coteau', cepage: 'Chardonnay', sol: 'Argilo-calcaire', age: '35 ans', d: 'M215 104L330 100 340 160 222 168Z' },
];
const accords = [
  ['Viande rouge', 0, 'Les tanins du cabernet franc tiennent tête à une côte de bœuf ou un magret.'],
  ['Poisson', 1, 'La tension du chenin réveille un poisson grillé ou un beurre blanc.'],
  ['Chèvre', 1, 'Un accord local : le chenin et le crottin de Chavignol se répondent.'],
  ['Apéritif', 3, 'Des bulles fines pour ouvrir le repas, sur des gougères tièdes.'],
  ['Barbecue', 2, 'Le rosé, servi frais, accompagne grillades et légumes d’été.'],
  ['Dessert', 3, 'Les bulles et une tarte aux pommes : la fraîcheur après le sucre.'],
] as const;
const formules = [
  ['Découverte', '1 h · 4 vins', 15],
  ['Prestige', '2 h · 6 vins et accords', 35],
] as const;
// Cellar opening hours, Sunday first (Date.getDay order).
const caveau: [string, string][][] = [[], [], [['10:00', '12:30'], ['14:00', '18:30']], [['10:00', '12:30'], ['14:00', '18:30']], [['10:00', '12:30'], ['14:00', '18:30']], [['10:00', '12:30'], ['14:00', '18:30']], [['10:00', '18:30']]];
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Clos des Brumes — Domaine viticole (démo)</title>
    <meta name="robots" content="noindex" />
    <meta name="description" content="Page d’accueil d’un domaine viticole fictif : démo de site vitrine réalisée par Timéo." />
    <noscript><style>.chargement { display: none }</style></noscript>
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Ccircle cx='16' cy='16' r='15' fill='%236b1e2c'/%3E%3C/svg%3E" />
  </head>
  <body>
    <div class="chargement" aria-hidden="true">
      <p class="chargement__nom">Clos des Brumes</p>
      <p class="chargement__texte">Le vin se décante</p>
      <div class="chargement__barre"><i></i></div>
    </div>
    <canvas class="scene3d" aria-hidden="true"></canvas>
    <div class="secours" aria-hidden="true" hidden>
      <svg viewBox="0 0 100 300"><path d="M36 0h28v8h-2v52c0 18 26 30 26 60v168c0 7-4 12-12 12H24c-8 0-12-5-12-12V120c0-30 26-42 26-60V8h-2Z" fill="#3b1520" /><rect x="14" y="160" width="72" height="70" fill="#f6efe1" /><text x="50" y="200" font-size="10" text-anchor="middle" font-family="Georgia" font-style="italic" fill="#3b1520">Clos des Brumes</text></svg>
    </div>

    <header class="nav">
      <a class="logo" href="#accueil">Clos des Brumes</a>
      <nav>
        <a href="#domaine">Le domaine</a>
        <a href="#terroir">Terroir</a>
        <a href="#vins">Nos vins</a>
        <a href="#visiter" class="nav__cta">Réserver une dégustation</a>
      </nav>
    </header>

    <main>
      <section id="accueil" class="bloc" data-q="0">
        <div class="panneau">
          <p class="sur">Domaine familial · Val de Loire</p>
          <h1>Clos<br /><em>des Brumes</em></h1>
          <p class="accroche">Quatorze hectares sur un coteau de tuffeau, travaillés à la main depuis 1924. Des vins de Loire droits, frais, et qui vieillissent bien.</p>
          <p class="statut"><span class="pastille"></span><span class="statut__texte">Horaires du caveau plus bas</span></p>
          <div class="boutons">
            <a class="bouton" href="#vins">Découvrir nos vins</a>
            <a class="bouton bouton--ligne" href="#visiter">Visiter le domaine</a>
          </div>
        </div>
      </section>

      <section id="domaine" class="bloc" data-q="0.12">
        <div class="panneau">
          <p class="sur">Le domaine</p>
          <h2>Quatre générations.<br /><em>Un seul coteau.</em></h2>
          <p class="texte">Arrière-grand-père Émile a planté les premières vignes à flanc de coteau, au-dessus de la brume du fleuve qui a donné son nom au domaine. Aujourd’hui, Claire et Thomas vendangent toujours à la main et vinifient en cave troglodyte, à 12 °C toute l’année.</p>
          <ul class="chiffres">
            {chiffres.map(([n, u, l]) => (
              <li>
                <strong><span class="compte" data-fin={n}>{n}</span>{u}</strong>
                <span>{l}</span>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <section id="terroir" class="bloc" data-q="0.3">
        <div class="panneau">
          <p class="sur">Le terroir</p>
          <h2>Cinq parcelles.<br /><em>Cinq caractères.</em></h2>
          <svg class="carte" viewBox="0 0 480 240" role="img" aria-label="Carte des cinq parcelles du domaine, au-dessus de la Loire">
            <path class="loire" d="M0 215C80 195 160 230 250 210S400 190 480 205V240H0Z" />
            <text x="410" y="228" class="carte__fleuve">La Loire</text>
            {parcelles.map((p, i) => (
              <g class="parcelle" tabindex="0" data-nom={p.nom} data-detail={`${p.cepage} · ${p.sol} · vignes de ${p.age}`} style={`--i: ${i}`}>
                <path d={p.d} pathLength="1" />
              </g>
            ))}
            <path class="chemin" d="M40 190C120 185 200 190 260 182S380 170 450 178" />
          </svg>
          <div class="parcelle__info" aria-live="polite">
            <b>Survolez une parcelle</b>
            <span>pour voir son cépage, son sol et l’âge de ses vignes.</span>
          </div>
        </div>
      </section>

      <section id="vins" class="bloc" data-q="0.45">
        <div class="panneau">
          <p class="sur">Nos vins</p>
          <h2>Quatre cuvées,<br /><em>une seule exigence.</em></h2>
          <ul class="cuvees">
            {cuvees.map((c, i) => (
              <li class="cuvee" data-i={i} tabindex="0">
                <svg viewBox="0 0 40 120" aria-hidden="true">
                  <path d="M15 0h10v4h-1v22c0 7 10 12 10 24v66c0 2-2 4-4 4H8c-2 0-4-2-4-4V50c0-12 10-17 10-24V4h-1Z" fill={c.couleur} />
                  <path d="M15 0h10v4h-1v22c0 7 10 12 10 24v66c0 2-2 4-4 4H8c-2 0-4-2-4-4V50c0-12 10-17 10-24V4h-1Z" fill="url(#reflet)" />
                  <rect x="5" y="62" width="30" height="28" fill="#f6efe1" />
                  <rect x="14" y="0" width="12" height="16" fill="#5a1022" />
                </svg>
                <div>
                  <div class="cuvee__ligne">
                    <h3>{c.nom}</h3>
                    <span class="points" aria-hidden="true"></span>
                    <span class="prix">{c.prix} €</span>
                  </div>
                  <p class="cuvee__type">{c.type} · {c.millesime} · {c.cepage}</p>
                  <p>{c.notes}</p>
                </div>
              </li>
            ))}
          </ul>
          <svg width="0" height="0" aria-hidden="true" style="position:absolute">
            <defs><linearGradient id="reflet" x1="0" x2="1"><stop offset="0" stop-color="#fff" stop-opacity="0" /><stop offset=".3" stop-color="#fff" stop-opacity=".35" /><stop offset=".45" stop-color="#fff" stop-opacity="0" /></linearGradient></defs>
          </svg>
          <p class="mention">Vente au caveau et expédition en France à partir de 6 bouteilles. L’abus d’alcool est dangereux pour la santé, à consommer avec modération.</p>
        </div>
      </section>

      <section id="accords" class="bloc" data-q="0.62">
        <div class="panneau">
          <p class="sur">Accords</p>
          <h2>Que servez-vous<br /><em>ce soir ?</em></h2>
          <div class="plats" role="group" aria-label="Choisir un plat">
            {accords.map(([plat, k, pourquoi]) => <button type="button" data-k={k} data-pourquoi={pourquoi} aria-pressed="false">{plat}</button>)}
          </div>
          <div class="accord" aria-live="polite">
            <p class="accord__vide">Choisissez un plat : nous vous conseillons une cuvée.</p>
          </div>
        </div>
      </section>

      <section id="visiter" class="bloc" data-q="0.78">
        <div class="panneau">
          <p class="sur">Visiter</p>
          <h2>Venez goûter,<br /><em>en cave.</em></h2>
          <table class="horaires" data-caveau={JSON.stringify(caveau)}>
            <tbody>
              {[2, 3, 4, 5, 6, 0, 1].map((j) => (
                <tr data-jour={j}>
                  <th scope="row">{['Dimanche', 'Lundi', 'Mardi', 'Mercredi', 'Jeudi', 'Vendredi', 'Samedi'][j]}</th>
                  <td>{caveau[j].length ? caveau[j].map(([a, b]) => `${a} – ${b}`).join(' · ') : 'Fermé'}</td>
                </tr>
              ))}
            </tbody>
          </table>
          <form class="resa" novalidate>
            <fieldset>
              <legend>Formule</legend>
              <div class="formules">
                {formules.map(([n, d, p]) => (
                  <button type="button" data-formule={n} data-prix={p} aria-pressed="false"><b>{n}</b><span>{d}</span><em>{p} € / pers.</em></button>
                ))}
              </div>
            </fieldset>
            <fieldset>
              <legend>Jour</legend>
              <div class="jours"></div>
            </fieldset>
            <fieldset>
              <legend>Personnes</legend>
              <div class="couverts">
                <button type="button" data-pas="-1" aria-label="Une personne de moins">−</button>
                <output>2</output>
                <button type="button" data-pas="1" aria-label="Une personne de plus">+</button>
              </div>
            </fieldset>
            <button class="bouton resa__ok" type="submit">Réserver la dégustation</button>
            <p class="resa__note">Démo : aucune réservation n’est envoyée.</p>
            <div class="ticket" aria-live="polite">
              <p class="sur">Réservation</p>
              <p class="ticket__resume"></p>
              <span class="tampon">Confirmée</span>
            </div>
          </form>
        </div>
      </section>
    </main>

    <footer class="pied" data-q="1">
      <div class="pied__infos">
        <p><b>Clos des Brumes</b><br />Lieu-dit Les Brumes<br />Val de Loire</p>
        <p><b>Caveau</b><br />Mardi – samedi<br />Fermé dimanche et lundi</p>
        <p><b>Contact</b><br />02 00 00 00 00<br />bonjour@closdesbrumes.example</p>
      </div>
    </footer>

    <a class="badge" href="https://jeannin.dev/" target="_top">Démo · domaine fictif · site réalisé par Timéo ↗</a>
  </body>
</html>

<script>
  import type { Cuvee } from '../../scripts/vin3d';

  const animer = !matchMedia('(prefers-reduced-motion: reduce)').matches;
  const cuvees: Cuvee[] = [...document.querySelectorAll<HTMLElement>('.cuvee')].map((li) => ({
    nom: li.querySelector('h3')!.textContent!,
    type: li.querySelector('.cuvee__type')!.textContent!.split(' · ')[0],
    millesime: li.querySelector('.cuvee__type')!.textContent!.split(' · ')[1],
    couleur: li.querySelector('path')!.getAttribute('fill')!,
  }));

  // Loading screen until the bottle is drawn (at least 1.2 s, at most 9 s).
  const chargement = document.querySelector<HTMLElement>('.chargement')!;
  const t0 = performance.now();
  let ouvert = false;
  const ouvrir = () => {
    if (ouvert) return;
    ouvert = true;
    setTimeout(() => {
      chargement.classList.add('fini');
      document.documentElement.classList.add('charge');
    }, Math.max(0, 1200 - (performance.now() - t0)));
  };
  setTimeout(ouvrir, 9000);

  // Reveal on scroll.
  const io = new IntersectionObserver(
    (entrees) => entrees.forEach((e) => e.isIntersecting && (e.target.classList.add('vu'), io.unobserve(e.target))),
    { rootMargin: '0px 0px -12% 0px' },
  );
  document.querySelectorAll('.panneau').forEach((el) => io.observe(el));

  // 3D bottle; without WebGL a drawn bottle takes its place and the cause goes to the console.
  const scene = document.querySelector<HTMLCanvasElement>('.scene3d')!;
  let montrer: (c: Cuvee | null) => void = () => {};
  const secours = (e: unknown) => {
    console.error('Bouteille 3D indisponible, dessin affiché à la place :', e);
    scene.hidden = true;
    document.querySelector<HTMLElement>('.secours')!.hidden = false;
    ouvrir();
  };
  import('../../scripts/vin3d')
    .then(({ demarrer }) => (montrer = demarrer(scene, [...document.querySelectorAll<HTMLElement>('[data-q]')], cuvees[0], secours, ouvrir).montrer))
    .catch(secours);

  // Wines: hovering (or focusing) one previews it in the bottle.
  const liste = document.querySelector<HTMLElement>('.cuvees')!;
  liste.querySelectorAll<HTMLElement>('.cuvee').forEach((li) => {
    const voir = () => montrer(cuvees[Number(li.dataset.i)]);
    li.addEventListener('pointerenter', voir);
    li.addEventListener('focus', voir);
  });
  liste.addEventListener('pointerleave', () => montrer(null));
  liste.addEventListener('focusout', () => montrer(null));

  // Key figures count up when they appear.
  document.querySelectorAll<HTMLElement>('.compte').forEach((el) => {
    if (!animer) return;
    const fin = Number(el.dataset.fin);
    const depart = fin > 1000 ? fin - 60 : 0;
    el.textContent = String(depart);
    new IntersectionObserver(([e], obs) => {
      if (!e.isIntersecting) return;
      obs.disconnect();
      const debut = performance.now();
      const pas = (t: number) => {
        const k = Math.min((t - debut) / 1600, 1);
        el.textContent = String(Math.round(depart + (fin - depart) * (1 - (1 - k) ** 3)));
        if (k < 1) requestAnimationFrame(pas);
      };
      requestAnimationFrame(pas);
    }, { threshold: 0.6 }).observe(el);
  });

  // Plots: hover or focus shows the grape, soil and vine age.
  const info = document.querySelector<HTMLElement>('.parcelle__info')!;
  document.querySelectorAll<SVGGElement>('.parcelle').forEach((g) => {
    const voir = () => {
      info.innerHTML = `<b>${g.dataset.nom}</b><span>${g.dataset.detail}</span>`;
    };
    g.addEventListener('pointerenter', voir);
    g.addEventListener('focus', voir);
  });

  // Food pairings: picking a dish suggests a wine and shows it in the bottle.
  const plats = document.querySelector<HTMLElement>('.plats')!;
  const accord = document.querySelector<HTMLElement>('.accord')!;
  plats.addEventListener('click', (e) => {
    const b = (e.target as Element).closest<HTMLButtonElement>('button[data-k]');
    if (!b) return;
    plats.querySelectorAll('button').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    const c = cuvees[Number(b.dataset.k)];
    accord.innerHTML = `<span class="accord__pastille" style="background:${c.couleur}"></span><div><b>${c.nom}</b><span>${c.type} · ${c.millesime}</span><p>${b.dataset.pourquoi}</p></div>`;
    accord.classList.remove('nouveau');
    void accord.offsetWidth;
    accord.classList.add('nouveau');
    montrer(c);
  });
  // Leaving the pairings section gives the bottle back to the scroll.
  new IntersectionObserver(([e]) => !e.isIntersecting && montrer(null)).observe(document.querySelector('#accords')!);

  // Cellar: today's opening hours, highlighted row and live status.
  const caveau: [string, string][][] = JSON.parse(document.querySelector<HTMLElement>('.horaires')!.dataset.caveau!);
  const maintenant = new Date();
  const jour = maintenant.getDay();
  const minutes = (hm: string) => Number(hm.slice(0, 2)) * 60 + Number(hm.slice(3));
  const actuelle = maintenant.getHours() * 60 + maintenant.getMinutes();
  document.querySelector(`.horaires tr[data-jour="${jour}"]`)?.classList.add('aujourdhui');
  const ouverte = caveau[jour].find(([a, b]) => actuelle >= minutes(a) && actuelle < minutes(b));
  const prochaine = caveau[jour].find(([a]) => actuelle < minutes(a));
  const statut = document.querySelector<HTMLElement>('.statut')!;
  statut.classList.toggle('ouvert', !!ouverte);
  statut.querySelector('.statut__texte')!.textContent = ouverte
    ? `Caveau ouvert · jusqu’à ${ouverte[1].replace(':', ' h ')}`
    : prochaine
      ? `Caveau fermé · ouvre à ${prochaine[0].replace(':', ' h ')}`
      : 'Caveau fermé aujourd’hui';

  // Tasting booking (demo, nothing is sent).
  const choix = { formule: '', prix: 0, jour: '', personnes: 2 };
  const unique = (groupe: Element, cible: HTMLButtonElement) => groupe.querySelectorAll('button').forEach((x) => x.setAttribute('aria-pressed', String(x === cible)));
  const formulesEl = document.querySelector('.formules')!;
  formulesEl.addEventListener('click', (e) => {
    const b = (e.target as Element).closest<HTMLButtonElement>('button[data-formule]');
    if (!b) return;
    unique(formulesEl, b);
    choix.formule = b.dataset.formule!;
    choix.prix = Number(b.dataset.prix);
  });
  const jours = document.querySelector('.jours')!;
  const noms = ['dim.', 'lun.', 'mar.', 'mer.', 'jeu.', 'ven.', 'sam.'];
  for (let i = 1; i <= 10; i++) {
    const d = new Date();
    d.setDate(d.getDate() + i);
    if (!caveau[d.getDay()].length) continue;
    const libelle = i === 1 ? 'Demain' : `${noms[d.getDay()]} ${d.getDate()}`;
    const b = Object.assign(document.createElement('button'), { type: 'button', textContent: libelle });
    b.setAttribute('aria-pressed', 'false');
    b.dataset.jour = libelle;
    jours.append(b);
  }
  jours.addEventListener('click', (e) => {
    const b = (e.target as Element).closest<HTMLButtonElement>('button[data-jour]');
    if (b) (unique(jours, b), (choix.jour = b.dataset.jour!));
  });
  const sortie = document.querySelector('.couverts output')!;
  document.querySelectorAll<HTMLButtonElement>('[data-pas]').forEach((b) =>
    b.addEventListener('click', () => {
      choix.personnes = Math.min(12, Math.max(1, choix.personnes + Number(b.dataset.pas)));
      sortie.textContent = String(choix.personnes);
    }),
  );
  const form = document.querySelector<HTMLFormElement>('.resa')!;
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const manque = !choix.formule ? '.formules' : !choix.jour ? '.jours' : '';
    if (manque) {
      const g = document.querySelector<HTMLElement>(manque)!;
      g.classList.remove('secoue');
      void g.offsetWidth;
      g.classList.add('secoue');
      return;
    }
    form.querySelector('.ticket__resume')!.textContent = `${choix.formule} · ${choix.personnes} pers. · ${choix.jour} · ${choix.prix * choix.personnes} €`;
    form.classList.add('confirme');
  });

  // Section titles: words rise one after the other when their panel appears.
  document.querySelectorAll<HTMLElement>('.panneau h2').forEach((h2) => {
    h2.setAttribute('aria-label', h2.textContent!.replace(/\s+/g, ' ').trim());
    const noeuds: Text[] = [];
    const parcours = document.createTreeWalker(h2, NodeFilter.SHOW_TEXT);
    while (parcours.nextNode()) noeuds.push(parcours.currentNode as Text);
    let n = 0;
    for (const t of noeuds) {
      const morceaux = document.createDocumentFragment();
      for (const part of t.textContent!.split(/(\s+)/)) {
        if (!part) continue;
        if (/^\s+$/.test(part)) {
          morceaux.append(part);
          continue;
        }
        const mot = Object.assign(document.createElement('span'), { className: 'mot', textContent: part });
        mot.style.setProperty('--w', String(n++));
        mot.setAttribute('aria-hidden', 'true');
        morceaux.append(mot);
      }
      t.replaceWith(morceaux);
    }
  });
</script>

<style is:global>
  :root {
    --papier: #f6f0e5;
    --papier-2: #ece2d0;
    --encre: #2a1a1c;
    --encre-2: #6a5b55;
    --bordeaux: #6b1e2c;
    --or: #a8823d;
    --vert: #5f7a4a;
    --f-titre: 'Cormorant Garamond', Georgia, serif;
    --f-texte: 'Instrument Sans', system-ui, sans-serif;
    --courbe: cubic-bezier(0.2, 0.7, 0.1, 1);
    color-scheme: light;
  }
  * {
    box-sizing: border-box;
  }
  html {
    scroll-behavior: smooth;
    scrollbar-color: var(--bordeaux) var(--papier);
