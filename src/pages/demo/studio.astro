---
// Local tool, not part of the site: renders one scene of src/scripts/studio.ts for scripts/captures/domaine.mjs.
// In the production build it only redirects to the wine estate demo.
import '@fontsource/cinzel/600.css';
import '@fontsource/cormorant-garamond/500-italic.css';
if (import.meta.env.PROD) return Astro.redirect('/demo/domaine/');
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>Studio</title>
    <style>
      html,
      body {
        margin: 0;
        background: transparent;
      }
      canvas {
        display: block;
      }
    </style>
  </head>
  <body>
    <canvas></canvas>
    <script>
      import { rendre } from '../../scripts/studio';
      rendre(document.querySelector('canvas')!);
    </script>
  </body>
</html>
